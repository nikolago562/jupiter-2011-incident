<Item class="ReplicatedStorage" referent="RBX00000009"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000008"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- JUPITER 2011 INCIDENT — every tunable value lives here.

local Config = {}

-- Flow ------------------------------------------------------------------------
Config.MIN_PLAYERS = 1
Config.LOBBY_TIME = 15 -- countdown before a run starts
Config.BREAK_TIME = 15 -- shop time between waves
Config.BOSS_BREAK_TIME = 25 -- longer break after a boss wave
Config.GAMEOVER_TIME = 12

-- Crew ------------------------------------------------------------------------
Config.BASE_HEALTH = 100
Config.BASE_WALKSPEED = 16
Config.DOWNED_BLEEDOUT = 25 -- seconds a downed player has to be revived
Config.REVIVE_TIME = 2.5 -- hold time to revive a crewmate
Config.REVIVE_HEALTH = 0.4 -- revived with 40% health

Config.SPACESUITS = true -- dress everyone in white spacesuits with helmets

-- Io (the moon landing) ---------------------------------------------------------------
Config.LANDING_WAVE = 10 -- after clearing this wave the ship lands on Io
Config.MOON_GRAVITY = 0.25 -- fraction of normal gravity (Io is 0.18g; 0.25 keeps it playable)
Config.MOON_JUMP_POWER = 32 -- with low gravity this is a long, floaty jump

-- Reactor (the thing the Keis want) ---------------------------------------------
Config.REACTOR_MAX_HP = 1000
Config.REPAIR_COST = 60
Config.REPAIR_AMOUNT = 250

-- Waves ---------------------------------------------------------------------------
Config.Waves = {
	BaseCount = 6,
	CountPerWave = 3,
	ExtraPlayerMultiplier = 0.5, -- +50% Keis per extra player
	HealthScalePerWave = 0.12, -- +12% Keis HP per wave
	SpawnIntervalStart = 1.2,
	SpawnIntervalMin = 0.35,
	BossEvery = 5,
	MaxAlive = 35,
	GoldenChance = 0.04, -- chance each spawn is a Golden Keis
	OutageFromWave = 3,
	OutageChance = 0.35, -- chance a wave has a power outage
	OutageDuration = 18,
	OutageSpeedBonus = 3,
	ClearBonusBase = 20, -- credits for everyone when a wave is cleared
	ClearBonusPerWave = 5,
}

-- Keis types -------------------------------------------------------------------------
-- weight = how often it spawns once unlockWave is reached (0 = never spawned by waves)
Config.KeisTypes = {
	Basic = { name = "KEIS", hp = 60, speed = 13, damage = 10, reward = 5, xp = 2, scale = 1,
		color = Color3.fromRGB(176, 142, 66), unlockWave = 1, weight = 10 },
	Skeleton = { name = "SKELETON KEIS", hp = 35, speed = 20, damage = 6, reward = 6, xp = 2, scale = 0.8,
		color = Color3.fromRGB(225, 220, 200), unlockWave = 3, weight = 6 },
	Keyring = { name = "KEYRING", hp = 90, speed = 11, damage = 10, reward = 8, xp = 3, scale = 1.1,
		color = Color3.fromRGB(150, 160, 175), unlockWave = 4, weight = 4, splitInto = "Mini", splitCount = 3 },
	Iron = { name = "IRON KEIS", hp = 220, speed = 9, damage = 22, reward = 15, xp = 5, scale = 1.25,
		color = Color3.fromRGB(70, 72, 80), unlockWave = 6, weight = 3 },
	Mini = { name = "MINI KEIS", hp = 18, speed = 19, damage = 4, reward = 2, xp = 1, scale = 0.55,
		color = Color3.fromRGB(200, 160, 80), unlockWave = 99, weight = 0 },
	Golden = { name = "GOLDEN KEIS", hp = 80, speed = 17, damage = 0, reward = 60, xp = 20, scale = 0.9,
		color = Color3.fromRGB(255, 200, 40), unlockWave = 1, weight = 0, passive = true, lifetime = 25 },
	Keymaster = { name = "KEYMASTER", hp = 700, speed = 17, damage = 18, reward = 120, xp = 40, scale = 1.15,
		color = Color3.fromRGB(255, 190, 50), unlockWave = 99, weight = 0, keys = 5 },
	Master = { name = "MASTER KEIS", hp = 1500, speed = 10, damage = 35, reward = 150, xp = 60, scale = 1.3,
		color = Color3.fromRGB(120, 20, 20), unlockWave = 99, weight = 0, boss = true,
		summon = "Mini", summonEvery = 8, summonCount = 3 },
}

-- Wave modifiers (one may roll from wave 3) -----------------------------------------------
Config.MODIFIER_FROM_WAVE = 3
Config.MODIFIER_CHANCE = 0.6
Config.Modifiers = {
	Swarm = { name = "SWARM", desc = "+60% Keis, -30% health", count = 1.6, hp = 0.7 },
	Armored = { name = "ARMORED", desc = "Keis have +50% health", hp = 1.5 },
	Frenzy = { name = "FRENZY", desc = "Keis are much faster", speed = 4 },
	Darkness = { name = "DARKNESS", desc = "The lights are out", dark = true },
	DoubleKeys = { name = "DOUBLE KEYS", desc = "Keis drop twice the keys", keys = 2 },
	Bounty = { name = "BOUNTY", desc = "+75% credits from kills", credits = 1.75 },
}

-- Keys & crates ------------------------------------------------------------------------------------
Config.KEY_DROP_CHANCE = 0.22 -- per kill (bosses and the Keymaster always drop several)
Config.CRATES_PER_BREAK = 3
Config.MISSION_KEY_REWARD = 2 -- keys for each crew member when a special mission succeeds

-- Weapons ----------------------------------------------------------------------------------
-- Shared settings
Config.Weapon = {
	Range = 220,
	Spread = 0.05, -- radians between Split Beam shots
	CritMultiplier = 2, -- hitting a Keis in the mouth
	FireInterval = 0.2, -- fallback for the client before stats arrive
}
-- Everyone starts with the Blaster. The minigun is unlocked in the Upgrade Terminal.
Config.Weapons = {
	Blaster = { name = "BLASTER", damage = 20, interval = 0.2, mag = 15, magPerLevel = 5, reload = 1.5, jitter = 0.014,
		tracer = Color3.fromRGB(90, 220, 255) },
	Minigun = { name = "M-2011 MINIGUN", damage = 11, interval = 0.065, mag = 100, magPerLevel = 25, reload = 3.2, jitter = 0.035,
		tracer = Color3.fromRGB(255, 170, 60), cost = 450 },
}

-- Attachments (bought at the Armory bench with credits; reset every run) ---------------------------
-- zoom = how much aiming down sights (right click) magnifies.
Config.Attachments = {
	Optic = {
		{ id = "Iron", name = "IRON SIGHTS", price = 0, zoom = 1.15, desc = "Standard sights" },
		{ id = "RedDot", name = "RED DOT", price = 40, zoom = 1.3, desc = "Clean red dot, fast aiming" },
		{ id = "Holo", name = "HOLO SIGHT", price = 60, zoom = 1.45, desc = "Holographic ring reticle" },
		{ id = "ACOG", name = "4x ACOG", price = 110, zoom = 2.6, desc = "Magnified mid-range scope" },
		{ id = "Sniper", name = "8x SCOPE", price = 180, zoom = 5, desc = "Long-range scope, full overlay" },
	},
	Laser = {
		{ id = "None", name = "NO LASER", price = 0, desc = "" },
		{ id = "Red", name = "RED LASER", price = 50, desc = "Tighter hip fire, +3% crit chance", color = Color3.fromRGB(255, 40, 40) },
		{ id = "Green", name = "GREEN LASER", price = 60, desc = "Tighter hip fire, +5% crit chance", color = Color3.fromRGB(60, 255, 90) },
	},
	Muzzle = {
		{ id = "None", name = "STANDARD", price = 0, desc = "" },
		{ id = "Compensator", name = "COMPENSATOR", price = 55, desc = "Much less recoil and spread" },
		{ id = "LongBarrel", name = "LONG BARREL", price = 75, desc = "+12% damage" },
	},
}
function Config.attachment(slot: string, id: string): any
	for _, a in (Config.Attachments :: any)[slot] or {} do
		if a.id == id then
			return a
		end
	end
	return nil
end

-- Upgrades (bought with credits; reset every run) ------------------------------------------------
Config.Upgrades = {
	{ id = "Damage", name = "PLASMA DAMAGE", desc = "+20% damage", baseCost = 30, growth = 1.55, max = 8, icon = "✦" },
	{ id = "FireRate", name = "TRIGGER CYCLER", desc = "+12% fire rate", baseCost = 35, growth = 1.6, max = 6, icon = "⟫" },
	{ id = "MaxHealth", name = "SUIT PLATING", desc = "+25 max health", baseCost = 25, growth = 1.5, max = 6, icon = "✚" },
	{ id = "Speed", name = "MAG BOOTS", desc = "+1.5 walk speed", baseCost = 25, growth = 1.6, max = 5, icon = "➤" },
	{ id = "Mag", name = "BIGGER MAG", desc = "+5 magazine size", baseCost = 20, growth = 1.5, max = 4, icon = "▤" },
	{ id = "Multishot", name = "SPLIT BEAM", desc = "+1 beam per shot", baseCost = 150, growth = 2.2, max = 3, icon = "⋔" },
}

function Config.upgradeCost(def: { baseCost: number, growth: number }, level: number): number
	return math.floor(def.baseCost * def.growth ^ level)
end

-- Permanent progression (saved) ---------------------------------------------------------------------
Config.DATASTORE_NAME = "Jupiter2011_v1"
Config.XP_PER_WAVE = 15 -- times the wave number
Config.LEVEL_DAMAGE_BONUS = 0.01 -- +1% damage per level
function Config.xpForLevel(level: number): number
	return math.floor(100 * level ^ 1.35)
end
Config.Titles = {
	{ level = 1, title = "CADET" },
	{ level = 5, title = "KEY HUNTER" },
	{ level = 10, title = "LOCKSMITH" },
	{ level = 20, title = "VENT WARDEN" },
	{ level = 35, title = "JUPITER VETERAN" },
	{ level = 50, title = "THE TRUE SURVIVOR" },
}
function Config.titleFor(level: number): string
	local title = Config.Titles[1].title
	for _, t in Config.Titles do
		if level >= t.level then
			title = t.title
		end
	end
	return title
end

-- Look & sound -----------------------------------------------------------------------------------
-- Image shown as the face on each Keis ("rbxassetid://..."). "" = a drawn face.
Config.KeisFaceImage = ""

-- Sound ids ("rbxassetid://123..."). "" = silent until you add one.
Config.Sounds = {
	-- "keis keis keis o algo o algo": upload assets/audio/keis_chant.ogg (or keis_chant_filtered.ogg)
	KeisChant = "",
	-- optional: upload assets/audio/keis_chant_boss.ogg. If empty, the boss plays KeisChant slowed down.
	BossChant = "",
	Music = "", -- optional background music loop

	-- Everything below has a ready file in assets/audio/sfx/ (see README → Sounds)
	ShipHum = "", -- ship_hum.ogg       constant background hum on the ship
	ReactorHum = "", -- reactor_hum.ogg    3D, from the reactor / generator
	EngineRumble = "", -- engine_rumble.ogg  3D, engine room
	Steam = "", -- steam_hiss.ogg     3D, every steam leak
	Sparks = "", -- sparks.ogg         3D, every sparking panel
	Alarm = "", -- alarm.ogg          during waves
	IoWind = "", -- io_wind.ogg        constant background on Io
	Shoot = "", -- blaster_shot.ogg
	MinigunShoot = "", -- minigun_shot.ogg
	Reload = "", -- reload.ogg
	Footstep = "", -- footstep_metal.ogg
	Door = "", -- door_slide.ogg     3D, sliding doors
	KeyPickup = "", -- key_pickup.ogg
	UIClick = "", -- ui_click.ogg
	Hit = "", -- hit_marker.ogg
	Kill = "", -- keis_death.ogg
	WaveStart = "", -- wave_start.ogg
	LevelUp = "", -- level_up.ogg
	Buy = "", -- buy.ogg
	CrateOpen = "", -- crate_open.ogg
}

Config.KEIS_CHANT_CHANCE = 0.5 -- chance a Keis chants each cycle (text + sound)
Config.MAX_SIMULTANEOUS_CHANTS = 6 -- cap on chant sounds playing at once

Config.KeisChatter = {
	"keis keis keis o algo o algo",
	"KEIS KEIS KEIS",
	"keis keis keis o algo",
	"o algo o algo",
	"KEIS",
	"k e i s",
}

Config.WaveSubtitles = {
	"THEY'RE IN THE VENTS",
	"KEIS KEIS KEIS O ALGO O ALGO",
	"PROTECT THE REACTOR",
	"THE KEYS BOARD THE SHIP",
	"DON'T LET THEM TAUNT YOU",
	"SIGNAL LOST · JULY 14, 2011",
}

-- Narrator captions. {name} = a player's display name.
Config.Narration = {
	RunStart = "July 14, 2011. The crew reaches Jupiter orbit. Something is in the vents",
	Vents = "The keys board the ship and chase {name} algo",
	Boss = "The Master Keis has boarded the ship",
	Outage = "The keis shut the ship's power off. The crew is separated",
	PowerBack = "Emergency power restored",
	ReactorLow = "The reactor is failing. The keis are getting in",
	Downed = "{name} is down. Someone revive them",
	Revived = "{name} was revived",
	Deceased = "{name} is deceased",
	Golden = "A GOLDEN KEIS appeared. Catch it before it escapes",
	GoldenCaught = "{name} caught the golden keis",
	GoldenEscaped = "The golden keis got away",
	WaveClear = "Wave cleared. The keis are regrouping",
	GameOver = "The incident was never reported",
	Retreat = "The keis retreat into the vents. For now",
	Landing = "The USS Kepler lands on Io. The keis followed the ship down",
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">KeisModel</string><ProtectedString name="Source"><![CDATA[--!strict
-- Builds a Keis model (key body, spider legs on Motor6Ds, toothy mouth, chant text, chant sound).
-- Shared so the server (real Keis) and the client (menu scene) build the exact same creature.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local KeisModel = {}

local function weldTo(root: BasePart, p: BasePart)
	p.Anchored = false
	p.CanCollide = false
	p.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
end

-- the "face": a ring of teeth around a fleshy throat inside the key's bow
local function drawMouth(faceGui: SurfaceGui, def: any)
	local flesh = Instance.new("Frame")
	flesh.Size = UDim2.fromScale(1, 1)
	flesh.BackgroundColor3 = if def.passive then Color3.fromRGB(255, 190, 60) else Color3.fromRGB(120, 18, 22)
	flesh.BorderSizePixel = 0
	flesh.Parent = faceGui
	Instance.new("UICorner", flesh).CornerRadius = UDim.new(0.5, 0)
	if Config.KeisFaceImage ~= "" then
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.fromScale(1, 1)
		img.BackgroundTransparency = 1
		img.Image = Config.KeisFaceImage
		img.Parent = flesh
		Instance.new("UICorner", img).CornerRadius = UDim.new(0.5, 0)
		return
	end
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 120))
	grad.Parent = flesh
	local throat = Instance.new("Frame")
	throat.AnchorPoint = Vector2.new(0.5, 0.5)
	throat.Position = UDim2.fromScale(0.5, 0.5)
	throat.Size = UDim2.fromScale(0.5, 0.5)
	throat.BackgroundColor3 = Color3.fromRGB(12, 2, 4)
	throat.BorderSizePixel = 0
	throat.Parent = flesh
	Instance.new("UICorner", throat).CornerRadius = UDim.new(0.5, 0)
	-- two rings of teeth pointing inward
	local rings = if def.boss then { { r = 0.4, n = 18, len = 0.16 }, { r = 0.28, n = 14, len = 0.11 } } else { { r = 0.36, n = 14, len = 0.14 } }
	for _, ring in rings do
		for i = 1, ring.n do
			local a = (i / ring.n) * math.pi * 2
			local tooth = Instance.new("Frame")
			tooth.AnchorPoint = Vector2.new(0.5, 0.5)
			tooth.Position = UDim2.fromScale(0.5 + math.cos(a) * ring.r, 0.5 + math.sin(a) * ring.r)
			tooth.Size = UDim2.fromScale(0.05, ring.len)
			tooth.Rotation = math.deg(a) + 90
			tooth.BackgroundColor3 = Color3.fromRGB(235, 228, 205)
			tooth.BorderSizePixel = 0
			tooth.Parent = flesh
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = tooth
		end
	end
end

local LEG_COLOR = Color3.fromRGB(58, 52, 50)

function KeisModel.build(def: any, position: Vector3)
	local s = def.scale
	local model = Instance.new("Model")
	model.Name = def.name

	local HIP = 2.5 * s -- the spider legs hold the key up off the floor
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = CFrame.new(position + Vector3.new(0, HIP + s, 0))
	root.Parent = model
	model.PrimaryPart = root

	local material = if def.passive then Enum.Material.Neon else Enum.Material.Metal
	local bodyParts: { BasePart } = {}
	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Size = size * s
		p.Color = color
		p.Material = mat
		p.CFrame = root.CFrame * (offset - offset.Position + offset.Position * s)
		p:SetAttribute("BaseColor", color)
		p.Parent = model
		weldTo(root, p)
		return p
	end

	-- the key: shaft, bit (teeth) and bow
	table.insert(bodyParts, piece("Shaft", Vector3.new(0.9, 5.5, 0.9), CFrame.new(0, 0.5, 0), def.color, material))
	table.insert(bodyParts, piece("ToothA", Vector3.new(1.4, 0.7, 0.9), CFrame.new(0.9, -1.6, 0), def.color, material))
	table.insert(bodyParts, piece("ToothB", Vector3.new(1.0, 0.7, 0.9), CFrame.new(0.7, -0.6, 0), def.color, material))
	table.insert(bodyParts, piece("Collar", Vector3.new(0.6, 1.5, 1.5), CFrame.new(0, 2.9, 0) * CFrame.Angles(0, 0, math.rad(90)), def.color, material, Enum.PartType.Cylinder))
	local bow = piece("Bow", Vector3.new(0.9, 4.8, 4.8), CFrame.new(0, 5.5, 0) * CFrame.Angles(0, math.rad(90), 0), def.color, material, Enum.PartType.Cylinder)
	table.insert(bodyParts, bow)
	if def.splitInto then
		local ring = piece("Ring", Vector3.new(0.4, 3, 3), CFrame.new(0, 9, 0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(200, 200, 210), Enum.Material.Metal, Enum.PartType.Cylinder)
		table.insert(bodyParts, ring)
		for i = -1, 1, 2 do
			table.insert(bodyParts, piece("Charm", Vector3.new(0.5, 2.2, 0.5), CFrame.new(i * 2.6, 6.6, 0) * CFrame.Angles(0, 0, math.rad(i * 25)), def.color, material))
		end
	end

	-- the mouth inside the bow (named "Face": shots here are crits)
	local face = piece("Face", Vector3.new(3.4, 3.4, 0.1), CFrame.new(0, 5.5, -0.5), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	face.Transparency = 1
	local faceGui = Instance.new("SurfaceGui")
	faceGui.Face = Enum.NormalId.Front
	faceGui.CanvasSize = Vector2.new(200, 200)
	faceGui.LightInfluence = 0.5
	faceGui.Parent = face
	drawMouth(faceGui, def)

	local glow = Instance.new("PointLight")
	glow.Color = if def.passive then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(255, 50, 40)
	glow.Range = 10 * s
	glow.Brightness = if def.boss then 4 else 1.2
	glow.Parent = face

	-- six spider legs. Each leg hangs on a Motor6D ("Leg1".."Leg6") that clients animate (KeisAnimator).
	local hipY = 0.6 -- relative to the root center, before scaling
	local upperLen, upperAngle = 3.2, math.rad(40)
	local kneeOut, kneeUp = math.cos(upperAngle) * upperLen, math.sin(upperAngle) * upperLen
	local footOut = kneeOut + 1.3
	local footDown = (HIP / s + 1 + hipY) -- from hip height down to the floor
	local legIndex = 0
	for _, side in { 1, -1 } do
		for _, yawDeg in { -38, 0, 38 } do
			legIndex += 1
			local yaw = math.rad(yawDeg) + (if side == 1 then 0 else math.pi)
			local hip = CFrame.new(0, hipY * s, 0) * CFrame.Angles(0, yaw, 0)

			local upperLocal = CFrame.new(kneeOut / 2 * s, kneeUp / 2 * s, 0) * CFrame.Angles(0, 0, upperAngle)
			local upper = Instance.new("Part")
			upper.Name = "LegUpper"
			upper.Size = Vector3.new(upperLen, 0.32, 0.32) * s
			upper.Color = LEG_COLOR
			upper.Material = Enum.Material.Metal
			upper.CanCollide = false
			upper.Massless = true
			upper.CFrame = root.CFrame * hip * upperLocal
			upper:SetAttribute("BaseColor", LEG_COLOR)
			upper.Parent = model

			local motor = Instance.new("Motor6D")
			motor.Name = "Leg" .. legIndex
			motor.Part0 = root
			motor.Part1 = upper
			motor.C0 = hip
			motor.C1 = upperLocal:Inverse()
			motor:SetAttribute("Group", legIndex % 2) -- tripod gait: legs alternate in two groups
			motor.Parent = root

			local knee = Vector3.new(kneeOut, kneeUp, 0) * s
			local foot = Vector3.new(footOut, -footDown, 0) * s
			local lowerVec = foot - knee
			local lowerLocal = CFrame.lookAt(knee + lowerVec / 2, foot) -- Z axis along the leg
			local lower = Instance.new("Part")
			lower.Name = "LegLower"
			lower.Size = Vector3.new(0.24 * s, 0.24 * s, lowerVec.Magnitude)
			lower.Color = LEG_COLOR
			lower.Material = Enum.Material.Metal
			lower.CanCollide = false
			lower.Massless = true
			lower.CFrame = root.CFrame * hip * lowerLocal
			lower:SetAttribute("BaseColor", LEG_COLOR)
			lower.Parent = model
			local w = Instance.new("WeldConstraint")
			w.Part0 = upper
			w.Part1 = lower
			w.Parent = lower
			table.insert(bodyParts, upper)
			table.insert(bodyParts, lower)
		end
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- R15 uses HipHeight (the legs are only visual)
	humanoid.HipHeight = HIP
	humanoid.WalkSpeed = def.speed
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	for _, state in { Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Climbing } do
		humanoid:SetStateEnabled(state, false)
	end

	-- name, health bar, chant text
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(170, 52)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.2 * s, 0)
	billboard.MaxDistance = if def.boss then 200 else 90
	billboard.Adornee = bow
	billboard.LightInfluence = 0
	billboard.Parent = model
	local chant = Instance.new("TextLabel")
	chant.Size = UDim2.new(1, 0, 0, 22)
	chant.BackgroundTransparency = 1
	chant.Font = Enum.Font.Code
	chant.TextScaled = true
	chant.TextColor3 = if def.passive then Color3.fromRGB(255, 215, 70) else Color3.fromRGB(255, 70, 60)
	chant.TextStrokeTransparency = 0.3
	chant.Text = ""
	chant.Parent = billboard
	local barBack = Instance.new("Frame")
	barBack.AnchorPoint = Vector2.new(0.5, 0)
	barBack.Position = UDim2.new(0.5, 0, 0, 30)
	barBack.Size = UDim2.new(if def.boss then 1 else 0.6, 0, 0, if def.boss then 10 else 6)
	barBack.BackgroundColor3 = Color3.fromRGB(20, 15, 20)
	barBack.BorderSizePixel = 0
	barBack.Visible = def.boss == true
	barBack.Parent = billboard
	Instance.new("UICorner", barBack).CornerRadius = UDim.new(1, 0)
	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = if def.passive then Color3.fromRGB(255, 215, 70) else Color3.fromRGB(255, 90, 60)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

	local chantId = if def.boss and Config.Sounds.BossChant ~= "" then Config.Sounds.BossChant else Config.Sounds.KeisChant
	if chantId ~= "" and not def.passive then
		local sound = Instance.new("Sound")
		sound.Name = "Chant"
		sound.SoundId = chantId
		sound.Looped = false -- played in sync with the floating chant text (see Keis.new)
		sound.Volume = if def.boss then 1.8 else 0.9
		-- the boss uses the normal chant slowed down unless it has its own BossChant
		sound:SetAttribute("BaseSpeed", if def.boss and Config.Sounds.BossChant == "" then 0.78 else 1)
		sound.RollOffMinDistance = 8
		sound.RollOffMaxDistance = if def.boss then 160 else 75
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.Parent = root
	end

	return model, humanoid, root, face, bodyParts, chant, barBack, barFill
end

return KeisModel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Perks</string><ProtectedString name="Source"><![CDATA[--!strict
-- Perk cards: after every wave each player picks 1 of 3. They stack and combine into a build for the run.

local Perks = {}

Perks.Rarity = {
	Common = { weight = 64, color = Color3.fromRGB(215, 215, 222), label = "COMMON" },
	Rare = { weight = 28, color = Color3.fromRGB(90, 200, 255), label = "RARE" },
	Legendary = { weight = 8, color = Color3.fromRGB(255, 200, 60), label = "LEGENDARY" },
}

export type Perk = { id: string, name: string, desc: string, rarity: string, max: number, icon: string }

Perks.List = {
	{ id = "HollowPoints", name = "HOLLOW POINTS", desc = "+15% damage", rarity = "Common", max = 5, icon = "✦" },
	{ id = "QuickHands", name = "QUICK HANDS", desc = "Reload 30% faster", rarity = "Common", max = 3, icon = "↻" },
	{ id = "SuitPadding", name = "SUIT PADDING", desc = "+20 max health", rarity = "Common", max = 5, icon = "✚" },
	{ id = "Scavenger", name = "SCAVENGER", desc = "+25% credits from kills", rarity = "Common", max = 4, icon = "◆" },
	{ id = "LightStep", name = "LIGHT STEP", desc = "+8% move speed", rarity = "Common", max = 3, icon = "➤" },
	{ id = "Vampire", name = "VAMPIRE SUIT", desc = "Heal 4 HP for every kill", rarity = "Rare", max = 3, icon = "♥" },
	{ id = "Ricochet", name = "RICOCHET", desc = "Killing shots bounce to the next Keis", rarity = "Rare", max = 2, icon = "⤳" },
	{ id = "ExtendedMag", name = "EXTENDED MAG", desc = "+50% magazine size", rarity = "Rare", max = 2, icon = "▤" },
	{ id = "CritLens", name = "CRIT LENS", desc = "+10% crit chance on any hit, crits +75% damage", rarity = "Rare", max = 3, icon = "◎" },
	{ id = "KeyMagnet", name = "KEY MAGNET", desc = "Pull keys from far away, +20% key drops", rarity = "Rare", max = 2, icon = "⊕" },
	{ id = "Adrenaline", name = "ADRENALINE", desc = "Each kill: +30% fire rate for 2 seconds", rarity = "Rare", max = 2, icon = "⚡" },
	{ id = "ChainLightning", name = "CHAIN LIGHTNING", desc = "Every 5th hit zaps nearby Keis", rarity = "Legendary", max = 2, icon = "ϟ" },
	{ id = "SecondWind", name = "SECOND WIND", desc = "Once per wave, get back up instantly when downed", rarity = "Legendary", max = 1, icon = "↑" },
	{ id = "ExplosiveCrits", name = "EXPLOSIVE CRITS", desc = "Crits explode and hit every Keis nearby", rarity = "Legendary", max = 2, icon = "✸" },
	{ id = "GoldenTouch", name = "GOLDEN TOUCH", desc = "Kills have an 8% chance to drop 3 keys + 15 credits", rarity = "Legendary", max = 1, icon = "♛" },
	{ id = "Overclock", name = "OVERCLOCK", desc = "+40% fire rate and +15% damage", rarity = "Legendary", max = 1, icon = "⚙" },
} :: { Perk }

Perks.byId = {} :: { [string]: Perk }
for _, p in Perks.List do
	Perks.byId[p.id] = p
end

-- Draw `count` different perks the player hasn't maxed. luck (0..1) makes rare/legendary cards likelier.
function Perks.roll(rng: Random, stacks: { [string]: number }, count: number, luck: number, onlyRarity: string?): { string }
	local pool = {}
	for _, p in Perks.List do
		if (stacks[p.id] or 0) < p.max and (onlyRarity == nil or p.rarity == onlyRarity) then
			local w = Perks.Rarity[p.rarity].weight
			if p.rarity == "Legendary" then
				w *= 1 + luck * 2
			elseif p.rarity == "Rare" then
				w *= 1 + luck
			end
			table.insert(pool, { id = p.id, w = w })
		end
	end
	local picked = {}
	for _ = 1, count do
		local total = 0
		for _, e in pool do
			total += e.w
		end
		if total <= 0 then
			break
		end
		local roll = rng:NextNumber() * total
		for i, e in pool do
			roll -= e.w
			if roll <= 0 then
				table.insert(picked, e.id)
				table.remove(pool, i)
				break
			end
		end
	end
	return picked
end

-- "Id:2,Other:1" <-> table (how the server publishes a player's perks as an attribute)
function Perks.encode(stacks: { [string]: number }): string
	local parts = {}
	for _, p in Perks.List do
		local n = stacks[p.id]
		if n and n > 0 then
			table.insert(parts, p.id .. ":" .. n)
		end
	end
	return table.concat(parts, ",")
end

function Perks.decode(s: string?): { [string]: number }
	local out = {}
	for id, n in string.gmatch(s or "", "(%w+):(%d+)") do
		out[id] = tonumber(n) or 0
	end
	return out
end

return Perks
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">SpaceArt</string><ProtectedString name="Source"><![CDATA[--!strict
-- Jupiter, its moons and the starfield, built from parts (no assets). Shared by the ship, the moon and the menu.

local SpaceArt = {}

local function deco(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Jupiter's real band layout, from south pole (-1) to north pole (+1): {latitude, color}
local PROFILE = {
	{ -1.00, Color3.fromRGB(120, 118, 125) }, -- south polar region (blue-grey)
	{ -0.80, Color3.fromRGB(150, 140, 135) },
	{ -0.62, Color3.fromRGB(196, 170, 140) }, -- south temperate zone
	{ -0.50, Color3.fromRGB(160, 112, 80) }, -- south temperate belt
	{ -0.38, Color3.fromRGB(226, 205, 176) }, -- south tropical zone
	{ -0.25, Color3.fromRGB(168, 104, 66) }, -- south equatorial belt
	{ -0.15, Color3.fromRGB(196, 136, 92) },
	{ -0.05, Color3.fromRGB(242, 228, 205) }, -- equatorial zone
	{ 0.08, Color3.fromRGB(236, 214, 182) },
	{ 0.18, Color3.fromRGB(150, 92, 60) }, -- north equatorial belt
	{ 0.28, Color3.fromRGB(182, 120, 80) },
	{ 0.38, Color3.fromRGB(230, 210, 180) }, -- north tropical zone
	{ 0.48, Color3.fromRGB(170, 126, 92) }, -- north temperate belt
	{ 0.60, Color3.fromRGB(205, 184, 156) },
	{ 0.78, Color3.fromRGB(150, 140, 136) },
	{ 1.00, Color3.fromRGB(118, 116, 124) }, -- north polar region
}

local function bandColor(lat: number): Color3
	for i = 1, #PROFILE - 1 do
		local a, b = PROFILE[i], PROFILE[i + 1]
		if lat >= a[1] and lat <= b[1] then
			local t = (lat - a[1]) / (b[1] - a[1])
			t = t * t * (3 - 2 * t) -- smooth edges between bands
			return a[2]:Lerp(b[2], t)
		end
	end
	return PROFILE[#PROFILE][2]
end

-- Builds Jupiter facing `viewer`. sunSide = 1 lights the right side (from the viewer), -1 the left.
function SpaceArt.jupiter(parent: Instance, center: Vector3, R: number, viewer: Vector3, sunSide: number?): Model
	local model = Instance.new("Model")
	model.Name = "Jupiter"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	local rng = Random.new(2011)

	-- 1) banded body: thin discs stacked pole to pole, colors follow the real band profile + turbulence
	local slices = 110
	local t = 2 * R / slices
	for i = 0, slices - 1 do
		local y = -R + (i + 0.5) * t
		local r = math.sqrt(math.max(R * R - y * y, 1))
		local lat = y / R
		local color = bandColor(lat + rng:NextNumber(-0.012, 0.012))
		local shade = rng:NextNumber(0.94, 1.05)
		color = Color3.new(math.clamp(color.R * shade, 0, 1), math.clamp(color.G * shade, 0, 1), math.clamp(color.B * shade, 0, 1))
		deco(model, Vector3.new(t + 0.3, 2 * r, 2 * r), CFrame.new(center + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			color, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	end

	-- surface helpers on the visible hemisphere
	local toViewer = viewer - center
	local flat = Vector3.new(toViewer.X, 0, toViewer.Z).Unit
	local right = flat:Cross(Vector3.yAxis).Unit
	local function surfaceDir(latDeg: number, lonDeg: number): Vector3
		local lat, lon = math.rad(latDeg), math.rad(lonDeg)
		return ((flat * math.cos(lon) + right * math.sin(lon)) * math.cos(lat) + Vector3.yAxis * math.sin(lat)).Unit
	end
	local function spot(latDeg: number, lonDeg: number, radius: number, color: Color3, lift: number?)
		local dir = surfaceDir(latDeg, lonDeg)
		local pos = center + dir * (R * (1 + (lift or 0.002)))
		deco(model, Vector3.new(R * 0.008, radius * 2, radius * 2), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0),
			color, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	end

	-- 2) the Great Red Spot (layered) in the south tropical zone
	spot(-22, -18, R * 0.15, Color3.fromRGB(226, 196, 160), 0.002)
	spot(-22, -18, R * 0.12, Color3.fromRGB(205, 110, 70), 0.004)
	spot(-22, -18, R * 0.085, Color3.fromRGB(180, 75, 50), 0.006)
	spot(-22, -18, R * 0.04, Color3.fromRGB(150, 60, 45), 0.008)

	-- 3) white ovals and dark festoons along the belts
	for _ = 1, 14 do
		spot(rng:NextNumber(-42, -32), rng:NextNumber(-60, 60), R * rng:NextNumber(0.02, 0.045), Color3.fromRGB(240, 232, 220))
	end
	for _ = 1, 16 do
		spot(rng:NextNumber(8, 14), rng:NextNumber(-65, 65), R * rng:NextNumber(0.012, 0.03), Color3.fromRGB(110, 70, 55))
	end
	for _ = 1, 10 do
		spot(rng:NextNumber(26, 34), rng:NextNumber(-60, 60), R * rng:NextNumber(0.015, 0.03), Color3.fromRGB(236, 222, 200))
	end

	-- 4) atmosphere haze
	for i, a in { { 1.02, 0.9 }, { 1.05, 0.95 }, { 1.1, 0.975 } } do
		local glow = deco(model, Vector3.one * R * 2 * a[1], CFrame.new(center), Color3.fromRGB(255, 196 - i * 10, 150 - i * 15),
			Enum.Material.Neon, Enum.PartType.Ball)
		glow.Transparency = a[2]
	end

	-- 5) night side: dark spheres offset sideways make a soft terminator (shadow on the side away from the sun)
	local side = -(sunSide or 1)
	for _, layer in { { 0.62, 0.55 }, { 0.78, 0.3 }, { 0.92, 0.08 } } do
		local shadow = deco(model, Vector3.one * R * 2.02, CFrame.new(center + right * side * R * layer[1] + flat * R * 0.05),
			Color3.fromRGB(4, 4, 8), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		shadow.Transparency = layer[2]
	end

	-- 6) moons: Io, Europa, Ganymede
	for _, m in {
		{ offset = -right * R * 1.7 + Vector3.new(0, R * 0.3, 0), size = R * 0.07, color = Color3.fromRGB(230, 200, 110) },
		{ offset = right * R * 1.55 - Vector3.new(0, R * 0.45, 0) - flat * R * 0.4, size = R * 0.06, color = Color3.fromRGB(225, 222, 215) },
		{ offset = -right * R * 1.2 - Vector3.new(0, R * 0.7, 0) - flat * R * 0.8, size = R * 0.09, color = Color3.fromRGB(150, 140, 130) },
	} do
		local moonPos = center + m.offset
		deco(model, Vector3.one * m.size, CFrame.new(moonPos), m.color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		local ms = deco(model, Vector3.one * m.size * 1.01, CFrame.new(moonPos + right * side * m.size * 0.35), Color3.fromRGB(4, 4, 8),
			Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		ms.Transparency = 0.2
	end
	return model
end

-- A starfield on a sphere around `center`, skipping the patch of sky covered by Jupiter (if given).
function SpaceArt.stars(parent: Instance, center: Vector3, radius: number, count: number, seed: number?, avoidCenter: Vector3?, avoidRadius: number?): Model
	local model = Instance.new("Model")
	model.Name = "Stars"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	local rng = Random.new(seed or 7)
	local avoidDir, avoidAngle = nil, 0
	if avoidCenter and avoidRadius then
		local d = avoidCenter - center
		avoidDir = d.Unit
		avoidAngle = math.asin(math.clamp(avoidRadius / d.Magnitude, 0, 1)) + 0.06
	end
	local TINTS = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 220, 255), Color3.fromRGB(255, 240, 210), Color3.fromRGB(255, 210, 190) }
	local galacticPole = Vector3.new(0.3, 0.8, 0.5).Unit

	local function place(dir: Vector3, size: number, transparency: number)
		if avoidDir and math.acos(math.clamp(dir:Dot(avoidDir), -1, 1)) < avoidAngle then
			return
		end
		local s = deco(model, Vector3.one * size, CFrame.new(center + dir * radius), TINTS[rng:NextInteger(1, #TINTS)], Enum.Material.Neon, Enum.PartType.Ball)
		s.Transparency = transparency
	end

	for _ = 1, count do
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
		if dir.Magnitude > 0.05 then
			local bright = rng:NextNumber() ^ 3 -- mostly small, a few bright ones
			place(dir.Unit, radius * (0.0014 + bright * 0.004), rng:NextNumber(0, 0.35))
		end
	end
	-- the Milky Way: a dense band of faint stars around a great circle
	for _ = 1, math.floor(count * 0.7) do
		local v = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
		local inPlane = (v - galacticPole * v:Dot(galacticPole))
		if inPlane.Magnitude > 0.05 then
			local dir = (inPlane.Unit + galacticPole * rng:NextNumber(-0.12, 0.12)).Unit
			place(dir, radius * rng:NextNumber(0.0009, 0.0018), rng:NextNumber(0.35, 0.7))
		end
	end
	-- faint nebula clouds
	for _, n in { { Color3.fromRGB(120, 80, 200), 0.6 }, { Color3.fromRGB(60, 120, 220), -0.4 }, { Color3.fromRGB(200, 80, 120), 0.1 } } do
		local dir = (galacticPole:Cross(Vector3.xAxis).Unit * math.cos(n[2] * 3) + galacticPole:Cross(Vector3.zAxis).Unit * math.sin(n[2] * 3)).Unit
		if not (avoidDir and dir:Dot(avoidDir) > 0.85) then
			local cloud = deco(model, Vector3.one * math.min(radius * 0.5, 2000), CFrame.new(center + dir * radius * 1.05), n[1], Enum.Material.Neon, Enum.PartType.Ball)
			cloud.Transparency = 0.965
		end
	end
	return model
end

return SpaceArt
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">WeaponModel</string><ProtectedString name="Source"><![CDATA[--!strict
-- Detailed weapon models built from parts, with attachments (optic / laser / muzzle).
-- Used by the server (the tool other players see), the client viewmodel (first person) and the Armory preview.
-- Convention: the weapon points down -Z, +Y is up, the root part sits at the origin.

local WeaponModel = {}

export type Attachments = { Optic: string, Laser: string, Muzzle: string }
export type Built = {
	root: BasePart,
	muzzle: BasePart, -- invisible part at the barrel tip
	laser: BasePart?, -- invisible part at the laser lens
	sight: CFrame, -- where your eye goes when aiming down sights (relative to root)
	grip: CFrame, -- where the right hand holds it (relative to root)
	foregrip: CFrame, -- where the left hand holds it
	spin: Motor6D?, -- minigun barrel joint (clients spin it)
	parts: { BasePart },
}

local WHITE = Color3.fromRGB(226, 228, 232)
local DARK = Color3.fromRGB(46, 48, 54)
local GUNMETAL = Color3.fromRGB(70, 72, 78)
local BLACK = Color3.fromRGB(18, 18, 20)
local ORANGE = Color3.fromRGB(255, 138, 61)
local CYAN = Color3.fromRGB(90, 220, 255)
local OLIVE = Color3.fromRGB(88, 94, 60)
local BRASS = Color3.fromRGB(200, 160, 70)
local GLASS = Color3.fromRGB(150, 200, 230)

local function axisZ(): CFrame
	return CFrame.Angles(0, math.rad(90), 0) -- turns a cylinder's X axis to point along Z
end

function WeaponModel.build(weaponId: string, att: Attachments, parent: Instance, rootName: string?): Built
	local parts: { BasePart } = {}
	local root = Instance.new("Part")
	root.Name = rootName or "Root"
	root.CFrame = CFrame.new()
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.Material = Enum.Material.SmoothPlastic

	local function add(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, attachTo: BasePart?): Part
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Size = size
		p.CFrame = (attachTo or root).CFrame * cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = parent
		local w = Instance.new("WeldConstraint")
		w.Part0 = attachTo or root
		w.Part1 = p
		w.Parent = p
		table.insert(parts, p)
		return p
	end
	local function marker(name: string, cf: CFrame): Part
		local p = add(name, Vector3.new(0.05, 0.05, 0.05), cf, BLACK)
		p.Transparency = 1
		return p
	end

	local mountY: number -- top of the rail where optics sit
	local mountZ = 0 -- optic center along the gun
	local laserAt: CFrame
	local muzzleZ: number
	local barrelY: number
	local ironSight: CFrame
	local grip: CFrame
	local foregrip: CFrame
	local spin: Motor6D? = nil

	if weaponId == "Minigun" then
		root.Size = Vector3.new(0.8, 0.75, 1.3)
		root.Color = GUNMETAL
		root.Material = Enum.Material.Metal
		root.Parent = parent
		table.insert(parts, root)
		add("Motor", Vector3.new(0.62, 0.6, 0.6), CFrame.new(0, 0, 0.95), DARK, Enum.Material.Metal)
		for i = 0, 3 do
			add("Fin", Vector3.new(0.66, 0.04, 0.5), CFrame.new(0, -0.22 + i * 0.15, 0.95), BLACK, Enum.Material.Metal)
		end
		add("StripeL", Vector3.new(0.02, 0.1, 1.1), CFrame.new(-0.41, 0.12, 0), ORANGE)
		add("StripeR", Vector3.new(0.02, 0.1, 1.1), CFrame.new(0.41, 0.12, 0), ORANGE)
		add("FrontPlate", Vector3.new(0.86, 0.8, 0.1), CFrame.new(0, 0, -0.7), DARK, Enum.Material.Metal)
		-- carry handle with a rail on top
		for _, z in { -0.4, 0.4 } do
			add("HandlePost", Vector3.new(0.08, 0.3, 0.08), CFrame.new(0, 0.52, z), DARK, Enum.Material.Metal)
		end
		add("HandleBar", Vector3.new(0.1, 0.1, 0.92), CFrame.new(0, 0.7, 0), DARK, Enum.Material.Metal)
		add("Rail", Vector3.new(0.22, 0.05, 0.7), CFrame.new(0, 0.77, 0), BLACK, Enum.Material.Metal)
		mountY, mountZ = 0.8, 0
		-- spade grips at the back
		for _, x in { -0.25, 0.25 } do
			add("Spade", Vector3.new(0.1, 0.55, 0.1), CFrame.new(x, -0.05, 1.4), BLACK, Enum.Material.Fabric)
		end
		add("SpadeBar", Vector3.new(0.6, 0.08, 0.08), CFrame.new(0, 0.22, 1.4), DARK, Enum.Material.Metal)
		add("Trigger", Vector3.new(0.08, 0.08, 0.06), CFrame.new(0.25, 0.25, 1.4), Color3.fromRGB(255, 50, 40), Enum.Material.Neon)
		-- ammo box + belt
		add("AmmoBox", Vector3.new(0.6, 0.65, 0.85), CFrame.new(0.75, -0.25, 0.1), OLIVE, Enum.Material.Metal)
		add("AmmoLid", Vector3.new(0.62, 0.06, 0.87), CFrame.new(0.75, 0.1, 0.1), Color3.fromRGB(70, 75, 48), Enum.Material.Metal)
		add("Stencil", Vector3.new(0.02, 0.2, 0.5), CFrame.new(1.06, -0.25, 0.1), Color3.fromRGB(220, 210, 160))
		for i = 0, 4 do
			add("Belt", Vector3.new(0.12, 0.12, 0.14), CFrame.new(0.62 - i * 0.05, 0.18 + i * 0.05, 0.05 - i * 0.12) * CFrame.Angles(0, 0, math.rad(20)), BRASS, Enum.Material.Metal)
		end
		-- rotating barrel cluster on a Motor6D
		local hub = add("Hub", Vector3.new(0.3, 0.56, 0.56), CFrame.new(0, 0, -0.9) * axisZ(), GUNMETAL, Enum.Material.Metal, Enum.PartType.Cylinder)
		hub:FindFirstChildOfClass("WeldConstraint"):Destroy()
		local motor = Instance.new("Motor6D")
		motor.Name = "Spin"
		motor.Part0 = root
		motor.Part1 = hub
		motor.C0 = CFrame.new(0, 0, -0.9) * axisZ()
		motor.Parent = root
		spin = motor
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			add("Barrel", Vector3.new(2.6, 0.17, 0.17), CFrame.new(0, math.cos(a) * 0.2, math.sin(a) * 0.2) * CFrame.new(1.3, 0, 0), -- hub local +X points forward
				Color3.fromRGB(60, 60, 64), Enum.Material.Metal, Enum.PartType.Cylinder, hub)
		end
		for _, x in { 0.7, 2.0, 2.55 } do
			add("Clamp", Vector3.new(0.12, 0.62, 0.62), CFrame.new(x, 0, 0), DARK, Enum.Material.Metal, Enum.PartType.Cylinder, hub)
		end
		barrelY, muzzleZ = 0, -3.55
		laserAt = CFrame.new(-0.48, 0.12, -0.55)
		ironSight = CFrame.new(0, 0.86, 0.9)
		add("IronRing", Vector3.new(0.04, 0.12, 0.12), CFrame.new(0, 0.86, -0.35) * axisZ(), BLACK, Enum.Material.Metal, Enum.PartType.Cylinder)
		grip = CFrame.new(0.25, -0.05, 1.4)
		foregrip = CFrame.new(-0.25, 0.65, 0)
	else
		-- BLASTER: sci-fi carbine
		root.Size = Vector3.new(0.5, 0.55, 1.6)
		root.Color = WHITE
		root.Parent = parent
		table.insert(parts, root)
		add("UpperReceiver", Vector3.new(0.46, 0.18, 1.5), CFrame.new(0, 0.36, -0.05), DARK, Enum.Material.Metal)
		add("Rail", Vector3.new(0.3, 0.06, 1.3), CFrame.new(0, 0.48, -0.05), BLACK, Enum.Material.Metal)
		for i = 0, 5 do
			add("RailNotch", Vector3.new(0.32, 0.04, 0.06), CFrame.new(0, 0.52, -0.6 + i * 0.22), BLACK, Enum.Material.Metal)
		end
		mountY, mountZ = 0.52, 0.05
		for _, x in { -0.26, 0.26 } do
			add("Stripe", Vector3.new(0.02, 0.08, 1.1), CFrame.new(x, 0.05, 0), ORANGE)
			for _, z in { -0.55, 0.45 } do
				add("Bolt", Vector3.new(0.04, 0.07, 0.07), CFrame.new(x + (if x > 0 then 0.01 else -0.01), -0.15, z), GUNMETAL, Enum.Material.Metal, Enum.PartType.Cylinder)
			end
		end
		add("EjectionPort", Vector3.new(0.02, 0.14, 0.35), CFrame.new(0.26, 0.18, -0.2), BLACK)
		add("ChargingHandle", Vector3.new(0.12, 0.07, 0.22), CFrame.new(0.31, 0.3, 0.45), DARK, Enum.Material.Metal)
		add("StatusLED", Vector3.new(0.05, 0.05, 0.05), CFrame.new(-0.26, 0.28, 0.55), Color3.fromRGB(80, 255, 120), Enum.Material.Neon)
		-- shroud with cooling vents
		add("Shroud", Vector3.new(0.4, 0.4, 1.3), CFrame.new(0, 0.12, -1.45), DARK, Enum.Material.Metal)
		add("ShroudRail", Vector3.new(0.26, 0.05, 0.9), CFrame.new(0, 0.345, -1.45), BLACK, Enum.Material.Metal)
		for k = 0, 2 do
			for _, x in { -0.205, 0.205 } do
				add("Vent", Vector3.new(0.02, 0.09, 0.22), CFrame.new(x, 0.14, -1.05 - k * 0.35), BLACK)
			end
		end
		add("CoilGlow", Vector3.new(0.41, 0.05, 0.9), CFrame.new(0, -0.06, -1.45), CYAN, Enum.Material.Neon)
		local long = att.Muzzle == "LongBarrel"
		local barrelLen = if long then 1.25 else 0.65
		add("Barrel", Vector3.new(barrelLen, 0.2, 0.2), CFrame.new(0, 0.12, -2.1 - barrelLen / 2) * axisZ(), GUNMETAL, Enum.Material.Metal, Enum.PartType.Cylinder)
		barrelY, muzzleZ = 0.12, -2.1 - barrelLen
		-- energy cell (magazine)
		add("Cell", Vector3.new(0.28, 0.62, 0.4), CFrame.new(0, -0.48, -0.35) * CFrame.Angles(math.rad(-8), 0, 0), DARK, Enum.Material.Metal)
		add("CellWindow", Vector3.new(0.3, 0.36, 0.1), CFrame.new(0, -0.45, -0.52) * CFrame.Angles(math.rad(-8), 0, 0), CYAN, Enum.Material.Neon)
		add("CellCap", Vector3.new(0.3, 0.08, 0.42), CFrame.new(0, -0.79, -0.31) * CFrame.Angles(math.rad(-8), 0, 0), BLACK, Enum.Material.Metal)
		add("TriggerGuard", Vector3.new(0.06, 0.06, 0.42), CFrame.new(0, -0.36, 0.12), DARK, Enum.Material.Metal)
		add("Trigger", Vector3.new(0.04, 0.16, 0.04), CFrame.new(0, -0.28, 0.06), BLACK, Enum.Material.Metal)
		add("Grip", Vector3.new(0.26, 0.62, 0.34), CFrame.new(0, -0.5, 0.42) * CFrame.Angles(math.rad(18), 0, 0), BLACK, Enum.Material.Fabric)
		add("StockTube", Vector3.new(0.7, 0.18, 0.18), CFrame.new(0, 0.05, 1.12) * axisZ(), GUNMETAL, Enum.Material.Metal, Enum.PartType.Cylinder)
		add("Stock", Vector3.new(0.24, 0.42, 0.55), CFrame.new(0, -0.08, 1.45), WHITE)
		add("ButtPad", Vector3.new(0.26, 0.5, 0.08), CFrame.new(0, -0.08, 1.76), BLACK, Enum.Material.Fabric)
		add("Foregrip", Vector3.new(0.2, 0.38, 0.24), CFrame.new(0, -0.24, -1.3), BLACK, Enum.Material.Fabric)
		laserAt = CFrame.new(0.25, 0.02, -1.5)
		ironSight = CFrame.new(0, 0.6, 0.95)
		grip = CFrame.new(0, -0.45, 0.42)
		foregrip = CFrame.new(0, -0.3, -1.3)
	end

	-- Muzzle device --------------------------------------------------------------------------------
	if weaponId ~= "Minigun" then
		if att.Muzzle == "Compensator" then
			add("Compensator", Vector3.new(0.3, 0.3, 0.42), CFrame.new(0, barrelY, muzzleZ - 0.2), DARK, Enum.Material.Metal)
			for k = 0, 2 do
				add("Port", Vector3.new(0.18, 0.02, 0.06), CFrame.new(0, barrelY + 0.15, muzzleZ - 0.08 - k * 0.12), BLACK)
			end
			muzzleZ -= 0.42
		else
			add("MuzzleBrake", Vector3.new(0.26, 0.26, 0.18), CFrame.new(0, barrelY, muzzleZ - 0.09), BLACK, Enum.Material.Metal)
			muzzleZ -= 0.18
		end
	end
	local muzzle = marker("Muzzle", CFrame.new(0, barrelY, muzzleZ - 0.05))

	-- Optic -------------------------------------------------------------------------------------------
	local sightY = ironSight.Y
	local optic = att.Optic or "Iron"
	local my, mz = mountY, mountZ
	if optic == "Iron" then
		if weaponId ~= "Minigun" then
			add("FrontSightBase", Vector3.new(0.12, 0.1, 0.12), CFrame.new(0, 0.42, -1.95), BLACK, Enum.Material.Metal)
			add("FrontSightPost", Vector3.new(0.03, 0.14, 0.03), CFrame.new(0, 0.53, -1.95), BLACK, Enum.Material.Metal)
			add("RearSightL", Vector3.new(0.05, 0.14, 0.08), CFrame.new(-0.07, 0.6, 0.55), BLACK, Enum.Material.Metal)
			add("RearSightR", Vector3.new(0.05, 0.14, 0.08), CFrame.new(0.07, 0.6, 0.55), BLACK, Enum.Material.Metal)
			sightY = 0.58
		end
	elseif optic == "RedDot" then
		add("OpticBase", Vector3.new(0.2, 0.06, 0.32), CFrame.new(0, my + 0.03, mz), BLACK, Enum.Material.Metal)
		for _, x in { -0.12, 0.12 } do
			add("OpticPost", Vector3.new(0.04, 0.26, 0.3), CFrame.new(x, my + 0.18, mz), DARK, Enum.Material.Metal)
		end
		add("OpticTop", Vector3.new(0.28, 0.04, 0.3), CFrame.new(0, my + 0.32, mz), DARK, Enum.Material.Metal)
		local glass = add("OpticGlass", Vector3.new(0.2, 0.22, 0.02), CFrame.new(0, my + 0.18, mz - 0.1), GLASS, Enum.Material.Glass)
		glass.Transparency = 0.7
		add("RedDot", Vector3.new(0.018, 0.018, 0.01), CFrame.new(0, my + 0.18, mz - 0.11), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		sightY = my + 0.18
	elseif optic == "Holo" then
		add("OpticBase", Vector3.new(0.26, 0.06, 0.46), CFrame.new(0, my + 0.03, mz), BLACK, Enum.Material.Metal)
		add("HoloBody", Vector3.new(0.3, 0.1, 0.46), CFrame.new(0, my + 0.1, mz), DARK, Enum.Material.Metal)
		for _, x in { -0.15, 0.15 } do
			add("HoloPost", Vector3.new(0.04, 0.24, 0.4), CFrame.new(x, my + 0.26, mz - 0.03), DARK, Enum.Material.Metal)
		end
		add("HoloTop", Vector3.new(0.34, 0.05, 0.42), CFrame.new(0, my + 0.4, mz - 0.03), DARK, Enum.Material.Metal)
		local glass = add("OpticGlass", Vector3.new(0.26, 0.22, 0.02), CFrame.new(0, my + 0.26, mz - 0.18), GLASS, Enum.Material.Glass)
		glass.Transparency = 0.7
		local c = Color3.fromRGB(255, 60, 50)
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			add("Reticle", Vector3.new(0.014, 0.014, 0.01), CFrame.new(math.cos(a) * 0.05, my + 0.26 + math.sin(a) * 0.05, mz - 0.19), c, Enum.Material.Neon)
		end
		add("Reticle", Vector3.new(0.012, 0.012, 0.01), CFrame.new(0, my + 0.26, mz - 0.19), c, Enum.Material.Neon)
		sightY = my + 0.26
	elseif optic == "ACOG" or optic == "Sniper" then
		local sniper = optic == "Sniper"
		local len = if sniper then 1.25 else 0.72
		local r = if sniper then 0.3 else 0.27
		local h = if sniper then 0.3 else 0.24
		for _, z in { -len * 0.3, len * 0.3 } do
			add("ScopeMount", Vector3.new(0.16, h - 0.04, 0.1), CFrame.new(0, my + (h - 0.04) / 2, mz + z), BLACK, Enum.Material.Metal)
			add("ScopeRing", Vector3.new(0.1, r + 0.06, r + 0.06), CFrame.new(0, my + h, mz + z) * axisZ(), DARK, Enum.Material.Metal, Enum.PartType.Cylinder)
		end
		add("ScopeTube", Vector3.new(len, r, r), CFrame.new(0, my + h, mz) * axisZ(), BLACK, Enum.Material.Metal, Enum.PartType.Cylinder)
		add("ScopeBellFront", Vector3.new(if sniper then 0.3 else 0.12, r + 0.12, r + 0.12), CFrame.new(0, my + h, mz - len / 2) * axisZ(), BLACK, Enum.Material.Metal, Enum.PartType.Cylinder)
		add("ScopeBellRear", Vector3.new(0.16, r + 0.06, r + 0.06), CFrame.new(0, my + h, mz + len / 2) * axisZ(), BLACK, Enum.Material.Metal, Enum.PartType.Cylinder)
		local lens = add("Lens", Vector3.new(0.02, r + 0.08, r + 0.08), CFrame.new(0, my + h, mz - len / 2 - (if sniper then 0.16 else 0.07)) * axisZ(),
			Color3.fromRGB(120, 170, 255), Enum.Material.Glass, Enum.PartType.Cylinder)
		lens.Transparency = 0.35
		if sniper then
			add("TurretTop", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, my + h + 0.2, mz) * CFrame.Angles(0, 0, math.rad(90)), DARK, Enum.Material.Metal, Enum.PartType.Cylinder)
			add("TurretSide", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0.2, my + h, mz), DARK, Enum.Material.Metal, Enum.PartType.Cylinder)
		else
			add("AcogFin", Vector3.new(0.04, 0.08, 0.3), CFrame.new(0, my + h + 0.17, mz), Color3.fromRGB(255, 60, 40), Enum.Material.Neon)
		end
		sightY = my + h
	end

	-- Laser ---------------------------------------------------------------------------------------------
	local laserPart: BasePart? = nil
	if att.Laser and att.Laser ~= "None" then
		local color = if att.Laser == "Green" then Color3.fromRGB(60, 255, 90) else Color3.fromRGB(255, 40, 40)
		add("LaserBox", Vector3.new(0.16, 0.16, 0.42), laserAt, DARK, Enum.Material.Metal)
		add("LaserLens", Vector3.new(0.08, 0.08, 0.03), laserAt * CFrame.new(0, 0, -0.22), color, Enum.Material.Neon)
		add("LaserSwitch", Vector3.new(0.04, 0.05, 0.08), laserAt * CFrame.new(0, 0.09, 0.1), color, Enum.Material.Neon)
		laserPart = marker("LaserEmitter", laserAt * CFrame.new(0, 0, -0.25))
		laserPart:SetAttribute("Color", color)
	end

	return {
		root = root,
		muzzle = muzzle,
		laser = laserPart,
		sight = CFrame.new(0, sightY, ironSight.Z),
		grip = grip,
		foregrip = foregrip,
		spin = spin,
		parts = parts,
	}
end

-- "Optic=RedDot;Laser=Red;Muzzle=None" <-> table
function WeaponModel.decode(s: string?): Attachments
	local out = { Optic = "Iron", Laser = "None", Muzzle = "None" }
	for k, v in string.gmatch(s or "", "(%w+)=(%w+)") do
		(out :: any)[k] = v
	end
	return out
end

function WeaponModel.encode(a: Attachments): string
	return `Optic={a.Optic};Laser={a.Laser};Muzzle={a.Muzzle}`
end

return WeaponModel
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000016"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- Weapons, credits and upgrades. The server checks every shot and purchase; clients only send intent.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Keis = require(script.Parent:WaitForChild("KeisAI"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local PerkSystem = require(script.Parent:WaitForChild("PerkSystem"))
local WeaponModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WeaponModel"))

local Combat = {}

type State = {
	weapon: string,
	attachments: { Optic: string, Laser: string, Muzzle: string },
	owned: { [string]: boolean }, -- "Optic.RedDot" = true
	credits: number,
	upgrades: { [string]: number },
	ammo: number,
	reloading: boolean,
	lastShot: number,
	kills: number,
	damageDealt: number,
}
local states: { [Player]: State } = {}
Combat.adrenalineUntil = {} :: { [Player]: number }
local hitCounter: { [Player]: number } = {}

Combat.hooks = {
	canShoot = function(_player: Player): boolean
		return true
	end,
	repairReactor = function(_player: Player): boolean
		return false
	end,
}

local remotes: Folder

local function upgradeDef(id: string)
	for _, u in Config.Upgrades do
		if u.id == id then
			return u
		end
	end
	return nil
end

function Combat.stats(player: Player)
	local st = states[player]
	local up = if st then st.upgrades else {}
	local data = PlayerData.get(player)
	local level = if data then data.Level else 1
	local W = Config.Weapons[if st then st.weapon else "Blaster"] or Config.Weapons.Blaster
	local function perk(id: string): number
		return PerkSystem.get(player, id)
	end
	local att = if st then st.attachments else { Optic = "Iron", Laser = "None", Muzzle = "None" }
	local overclock = perk("Overclock")
	local adrenaline = if (Combat.adrenalineUntil[player] or 0) > os.clock() then perk("Adrenaline") else 0
	return {
		damage = W.damage * (if att.Muzzle == "LongBarrel" then 1.12 else 1) * (1 + 0.2 * (up.Damage or 0)) * (1 + Config.LEVEL_DAMAGE_BONUS * (level - 1))
			* (1 + 0.15 * perk("HollowPoints")) * (1 + 0.15 * overclock),
		interval = W.interval * (0.88 ^ (up.FireRate or 0)) / (1 + 0.4 * overclock) / (1 + 0.3 * adrenaline),
		mag = math.floor((W.mag + W.magPerLevel * (up.Mag or 0)) * (1 + 0.5 * perk("ExtendedMag"))),
		reload = W.reload * (0.7 ^ perk("QuickHands")),
		jitter = W.jitter * (if att.Laser ~= "None" then 0.5 else 1) * (if att.Muzzle == "Compensator" then 0.6 else 1),
		pellets = 1 + (up.Multishot or 0),
		maxHealth = Config.BASE_HEALTH + 25 * (up.MaxHealth or 0) + 20 * perk("SuitPadding"),
		walkSpeed = (Config.BASE_WALKSPEED + 1.5 * (up.Speed or 0)) * (1 + 0.08 * perk("LightStep")),
		critChance = 0.1 * perk("CritLens") + (if att.Laser == "Red" then 0.03 elseif att.Laser == "Green" then 0.05 else 0),
		critMult = Config.Weapon.CritMultiplier + 0.75 * perk("CritLens"),
	}
end

local function publish(player: Player)
	local st = states[player]
	if not st then
		return
	end
	local s = Combat.stats(player)
	player:SetAttribute("Credits", st.credits)
	player:SetAttribute("Weapon", st.weapon)
	player:SetAttribute("Attachments", WeaponModel.encode(st.attachments))
	local owned = {}
	for k in st.owned do
		table.insert(owned, k)
	end
	player:SetAttribute("OwnedAttachments", table.concat(owned, ","))
	player:SetAttribute("Ammo", st.ammo)
	player:SetAttribute("MagSize", s.mag)
	player:SetAttribute("Reloading", st.reloading)
	player:SetAttribute("FireInterval", s.interval)
	player:SetAttribute("RunKills", st.kills)
	for _, u in Config.Upgrades do
		player:SetAttribute("Up_" .. u.id, st.upgrades[u.id] or 0)
	end
end

function Combat.reset(player: Player)
	states[player] = {
		weapon = "Blaster",
		attachments = { Optic = "Iron", Laser = "None", Muzzle = "None" },
		owned = {},
		credits = 0,
		upgrades = {},
		ammo = Config.Weapons.Blaster.mag,
		reloading = false,
		lastShot = 0,
		kills = 0,
		damageDealt = 0,
	}
	publish(player)
end

function Combat.remove(player: Player)
	states[player] = nil
end

function Combat.getRunStats(player: Player): (number, number)
	local st = states[player]
	if not st then
		return 0, 0
	end
	return st.kills, math.floor(st.damageDealt)
end

function Combat.refresh(player: Player)
	local st = states[player]
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local s = Combat.stats(player)
	if humanoid then
		local ratio = humanoid.Health / math.max(humanoid.MaxHealth, 1)
		humanoid.MaxHealth = s.maxHealth
		humanoid.Health = math.max(1, s.maxHealth * ratio)
		if not player:GetAttribute("Downed") then
			humanoid.WalkSpeed = s.walkSpeed
		end
	end
	if st and not st.reloading then
		st.ammo = math.max(st.ammo, math.min(st.ammo + 0, s.mag))
	end
	publish(player)
end

function Combat.onKill(player: Player)
	if PerkSystem.get(player, "Adrenaline") > 0 then
		Combat.adrenalineUntil[player] = os.clock() + 2
		publish(player)
		task.delay(2.05, function()
			if player.Parent then
				publish(player)
			end
		end)
	end
end

function Combat.addCredits(player: Player, amount: number)
	local st = states[player]
	if st then
		st.credits += amount
		publish(player)
	end
end

function Combat.addKill(player: Player)
	local st = states[player]
	if st then
		st.kills += 1
		publish(player)
	end
end

local function makeWeapon(weaponId: string, att: any): Tool
	local tool = Instance.new("Tool")
	tool.Name = if weaponId == "Minigun" then "Minigun" else "Blaster"
	tool.ToolTip = "Hold to fire · R reload · Right-click aim"
	tool.CanBeDropped = false
	tool:SetAttribute("IsWeapon", true)
	tool:SetAttribute("WeaponId", weaponId)
	local built = WeaponModel.build(weaponId, att, tool, "Handle")
	tool.Grip = CFrame.new(built.grip.Position)
	return tool
end

local function findWeapon(container: Instance?): Tool?
	if not container then
		return nil
	end
	for _, t in container:GetChildren() do
		if t:IsA("Tool") and t:GetAttribute("IsWeapon") then
			return t
		end
	end
	return nil
end

local function giveWeapon(player: Player, humanoid: Humanoid)
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in { backpack, player.Character } do
		local old = findWeapon(container)
		while old do
			old:Destroy()
			old = findWeapon(container)
		end
	end
	local st = states[player]
	local tool = makeWeapon(if st then st.weapon else "Blaster", if st then st.attachments else { Optic = "Iron", Laser = "None", Muzzle = "None" })
	tool.Parent = backpack
	task.defer(function()
		if humanoid.Parent and not player:GetAttribute("Downed") then
			humanoid:EquipTool(tool)
		end
	end)
end

function Combat.applyCharacter(player: Player, character: Model)
	if not states[player] then
		Combat.reset(player)
	end
	local s = Combat.stats(player)
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if humanoid then
		humanoid.MaxHealth = s.maxHealth
		humanoid.Health = s.maxHealth
		humanoid.WalkSpeed = s.walkSpeed
	end
	local st = states[player]
	st.ammo = s.mag
	st.reloading = false
	publish(player)
	player:WaitForChild("Backpack", 5)
	if humanoid then
		giveWeapon(player, humanoid)
	end
end

local function startReload(player: Player)
	local st = states[player]
	if not st or st.reloading then
		return
	end
	st.reloading = true
	publish(player)
	;(remotes:FindFirstChild("CrewAction") :: RemoteEvent):FireAllClients(player.UserId, "Reloading!!")
	task.delay(Combat.stats(player).reload, function()
		if states[player] == st then
			st.ammo = Combat.stats(player).mag
			st.reloading = false
			publish(player)
		end
	end)
end

local arcFrom: (Player, Vector3, number, number, number, any, string) -> ()
local explode: (Player, Vector3, number, any) -> ()

-- deals damage, records stats, tells the shooter (damage numbers / hitmarkers)
local function hitKeis(player: Player, k: any, dmg: number, at: Vector3, crit: boolean): boolean
	local st = states[player]
	if st then
		st.damageDealt += math.min(dmg, k.hp)
	end
	local killed = k:takeDamage(dmg, player)
	;(remotes:FindFirstChild("HitConfirm") :: RemoteEvent):FireClient(player, at, math.floor(dmg), crit, killed,
		if killed then k.def.reward else 0, k.def.passive == true)
	return killed
end

local function keisNear(pos: Vector3, radius: number, except: any): { any }
	local list = {}
	for _, other in Keis.registry do
		if other.alive and other ~= except and (other.root.Position - pos).Magnitude <= radius then
			table.insert(list, other)
		end
	end
	table.sort(list, function(a, b)
		return (a.root.Position - pos).Magnitude < (b.root.Position - pos).Magnitude
	end)
	return list
end

-- Chain Lightning / Ricochet: jump from Keis to Keis
arcFrom = function(player: Player, from: Vector3, dmg: number, jumps: number, radius: number, first: any, kind: string)
	local points = { from }
	local last, pos = first, from
	for _ = 1, jumps do
		local target = keisNear(pos, radius, last)[1]
		if not target then
			break
		end
		local tp = target.root.Position + Vector3.new(0, 3 * target.def.scale, 0)
		table.insert(points, tp)
		hitKeis(player, target, dmg, tp, false)
		last, pos = target, tp
	end
	if #points > 1 then
		;(remotes:FindFirstChild("Arc") :: RemoteEvent):FireAllClients(kind, points)
	end
end

-- Explosive Crits
explode = function(player: Player, at: Vector3, dmg: number, except: any)
	for _, k in keisNear(at, 9, except) do
		hitKeis(player, k, dmg, k.root.Position + Vector3.new(0, 3, 0), false)
	end
	;(remotes:FindFirstChild("Arc") :: RemoteEvent):FireAllClients("boom", { at })
end

local function onShoot(player: Player, aimPos: any)
	if typeof(aimPos) ~= "Vector3" then
		return
	end
	local st = states[player]
	if not st or st.reloading or not Combat.hooks.canShoot(player) then
		return
	end
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	local tool = findWeapon(character)
	if not character or not head or not tool then
		return
	end
	local s = Combat.stats(player)
	local now = os.clock()
	if now - st.lastShot < s.interval * 0.75 then
		return
	end
	st.lastShot = now
	if st.ammo <= 0 then
		startReload(player)
		return
	end
	st.ammo -= 1

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	params.FilterDescendantsInstances = ignore

	local origin = head.Position
	local baseDir = (aimPos - origin)
	if baseDir.Magnitude < 0.1 then
		return
	end
	baseDir = baseDir.Unit
	local hits = {}
	for i = 1, s.pellets do
		local dir = baseDir
		if s.jitter > 0 then
			dir = (CFrame.fromAxisAngle(Vector3.yAxis, (math.random() - 0.5) * s.jitter)
				* CFrame.fromAxisAngle(Vector3.xAxis, (math.random() - 0.5) * s.jitter) * dir).Unit
		end
		if s.pellets > 1 then
			local angle = (i - (s.pellets + 1) / 2) * Config.Weapon.Spread
			dir = (CFrame.fromAxisAngle(Vector3.yAxis, angle) * dir)
		end
		local result = workspace:Raycast(origin, dir * Config.Weapon.Range, params)
		local hitPos = if result then result.Position else origin + dir * Config.Weapon.Range
		table.insert(hits, hitPos)
		if result then
			local k = Keis.fromPart(result.Instance)
			if k and k.alive then
				local crit = result.Instance.Name == "Face" or result.Instance.Name == "Bow" or math.random() < s.critChance
				local dmg = s.damage * (if crit then s.critMult else 1)
				local killed = hitKeis(player, k, dmg, hitPos, crit)
				-- perks that trigger on hits
				if crit and PerkSystem.get(player, "ExplosiveCrits") > 0 then
					explode(player, hitPos, s.damage * 0.4 * PerkSystem.get(player, "ExplosiveCrits"), k)
				end
				local chain = PerkSystem.get(player, "ChainLightning")
				if chain > 0 then
					hitCounter[player] = (hitCounter[player] or 0) + 1
					if hitCounter[player] % 5 == 0 then
						arcFrom(player, hitPos, s.damage * 0.5, 1 + 2 * chain, 22, k, "zap")
					end
				end
				local bounces = PerkSystem.get(player, "Ricochet")
				if killed and bounces > 0 then
					arcFrom(player, hitPos, s.damage * 0.6, bounces, 16, k, "ricochet")
				end
			end
		end
	end
	;(remotes:FindFirstChild("ShotFx") :: RemoteEvent):FireAllClients(player, origin, hits)
	if st.ammo <= 0 then
		startReload(player)
	else
		publish(player)
	end
end

local function onBuy(player: Player, id: any)
	if type(id) ~= "string" then
		return
	end
	local st = states[player]
	if id == "Minigun" then
		local cost = Config.Weapons.Minigun.cost
		if st and st.weapon ~= "Minigun" and st.credits >= cost then
			st.credits -= cost
			st.weapon = "Minigun"
			st.reloading = false
			st.ammo = Combat.stats(player).mag
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				giveWeapon(player, humanoid)
			end
			publish(player)
			;(remotes:FindFirstChild("Purchased") :: RemoteEvent):FireClient(player, id)
			;(remotes:FindFirstChild("CrewAction") :: RemoteEvent):FireAllClients(player.UserId, "I GOT A MINIGUN")
		end
		return
	end
	local def = upgradeDef(id)
	if not st or not def then
		return
	end
	local level = st.upgrades[id] or 0
	if level >= def.max then
		return
	end
	local cost = Config.upgradeCost(def, level)
	if st.credits < cost then
		return
	end
	st.credits -= cost
	st.upgrades[id] = level + 1
	-- apply health/speed right away
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local s = Combat.stats(player)
	if humanoid then
		if id == "MaxHealth" then
			humanoid.MaxHealth = s.maxHealth
			humanoid.Health = math.min(humanoid.Health + 25, s.maxHealth)
		elseif id == "Speed" and not player:GetAttribute("Downed") then
			humanoid.WalkSpeed = s.walkSpeed
		end
	end
	if id == "Mag" and not st.reloading then
		st.ammo = s.mag
	end
	publish(player)
	;(remotes:FindFirstChild("Purchased") :: RemoteEvent):FireClient(player, id)
end

local function onAttachment(player: Player, slot: any, id: any)
	if type(slot) ~= "string" or type(id) ~= "string" then
		return
	end
	local st = states[player]
	local def = Config.attachment(slot, id)
	if not st or not def or (slot ~= "Optic" and slot ~= "Laser" and slot ~= "Muzzle") then
		return
	end
	local key = slot .. "." .. id
	if def.price > 0 and not st.owned[key] then
		if st.credits < def.price then
			return
		end
		st.credits -= def.price
		st.owned[key] = true
		;(remotes:FindFirstChild("Purchased") :: RemoteEvent):FireClient(player, key)
	end
	;(st.attachments :: any)[slot] = id
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		giveWeapon(player, humanoid)
	end
	publish(player)
end

local function onRepair(player: Player)
	local st = states[player]
	if not st or st.credits < Config.REPAIR_COST then
		return
	end
	if Combat.hooks.repairReactor(player) then
		st.credits -= Config.REPAIR_COST
		publish(player)
		;(remotes:FindFirstChild("Purchased") :: RemoteEvent):FireClient(player, "Repair")
	end
end

function Combat.init(remoteFolder: Folder)
	remotes = remoteFolder
	;(remotes:FindFirstChild("Shoot") :: RemoteEvent).OnServerEvent:Connect(onShoot)
	;(remotes:FindFirstChild("Reload") :: RemoteEvent).OnServerEvent:Connect(function(player)
		local st = states[player]
		if st and st.ammo < Combat.stats(player).mag then
			startReload(player)
		end
	end)
	;(remotes:FindFirstChild("BuyUpgrade") :: RemoteEvent).OnServerEvent:Connect(onBuy)
	;(remotes:FindFirstChild("RepairReactor") :: RemoteEvent).OnServerEvent:Connect(onRepair)
	;(remotes:FindFirstChild("Attachment") :: RemoteEvent).OnServerEvent:Connect(onAttachment)
end

return Combat
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX0000000B"><Properties><string name="Name">GameManager</string><ProtectedString name="Source"><![CDATA[--!strict
-- JUPITER 2011 INCIDENT — run / wave loop.
-- Lobby → Wave 1 → break (shop) → Wave 2 → … → the reactor falls or the whole crew is down → Game Over → Lobby.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local ShipBuilder = require(script.Parent:WaitForChild("ShipBuilder"))
local Keis = require(script.Parent:WaitForChild("KeisAI"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Combat = require(script.Parent:WaitForChild("Combat"))
local Suit = require(script.Parent:WaitForChild("Suit"))
local MoonBuilder = require(script.Parent:WaitForChild("MoonBuilder"))
local PerkSystem = require(script.Parent:WaitForChild("PerkSystem"))
local Loot = require(script.Parent:WaitForChild("Loot"))
local Missions = require(script.Parent:WaitForChild("Missions"))
local Perks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Perks"))
local ServerStorage = game:GetService("ServerStorage")

-- Remotes ---------------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local R: { [string]: RemoteEvent } = {}
for _, name in {
	"Notify", -- (text, colorName)
	"Narrate", -- (text) narrator caption bar
	"CrewAction", -- (userId, text) line in the crew roster
	"Announce", -- (title, subtitle, style) big center banner
	"HitConfirm", -- (pos, dmg, crit, killed, reward, golden) to the shooter
	"ShotFx", -- (shooter, origin, hits) tracers for everyone
	"PlayerHurt", -- (damage)
	"LevelUp", -- (level, title)
	"GameOver", -- (summary)
	"Purchased", -- (id)
	"Transition", -- (text, seconds) fade to black and back
	"PerkOffer", -- (offerId, cards, rarity) pick-1-of-3
	"Arc", -- (kind, points) chain lightning / ricochet / explosion visuals
	"OpenArmory", -- () open the armory screen
	"PickPerk", "RerollPerk", "Attachment", -- client → server
	"Shoot", "Reload", "BuyUpgrade", "RepairReactor", "PlayRequest", -- client → server
} do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	R[name] = r
end
remotes.Parent = ReplicatedStorage

local function setAttr(name: string, value: any)
	ReplicatedStorage:SetAttribute(name, value)
end
local function setPhase(phase: string, timeLeft: number?)
	setAttr("Phase", phase)
	setAttr("TimeLeft", timeLeft or 0)
end

-- players who pressed PLAY in the menu
local function crew(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("InGame") then
			table.insert(list, p)
		end
	end
	return list
end

local function narrate(key: string, name: string?)
	local template = (Config.Narration :: any)[key] or key
	R.Narrate:FireAllClients((string.gsub(template, "{name}", name or "someone")))
end

-- World -------------------------------------------------------------------------------------
local baseplate = workspace:FindFirstChild("Baseplate")
if baseplate then
	baseplate:Destroy()
end
local ship = ShipBuilder.build()
local keisFolder = Instance.new("Folder")
keisFolder.Name = "Keis"
keisFolder.Parent = workspace

local rng = Random.new()
local running = false
local wave = 0
local reactorHp = Config.REACTOR_MAX_HP
local reactorWarned = false
setAttr("ReactorHP", reactorHp)
setAttr("ReactorMax", Config.REACTOR_MAX_HP)
setAttr("Wave", 0)
setAttr("KeisLeft", 0)
setAttr("PowerOut", false)
setAttr("Alarm", false)
setPhase("Lobby")

-- Reactor visuals: rings spin, core shifts from cyan to red as it takes damage
-- the current stage: the ship, or Io after wave 10
type Stage = { name: string, spawn: SpawnLocation, reactor: BasePart, reactorRadius: number, vents: { Vector3 }, roomCenters: { Vector3 } }
local shipStage: Stage = { name = "Ship", spawn = ship.spawn, reactor = ship.reactor, reactorRadius = ship.reactorRadius,
	vents = ship.vents, roomCenters = ship.roomCenters }
local stage: Stage = shipStage
local moon: any = nil

local rings = {}
local function collectRings()
	rings = {}
	for _, d in (stage.reactor.Parent :: Instance):GetChildren() do
		if d.Name == "ReactorRing" then
			table.insert(rings, { part = d :: BasePart, base = (d :: BasePart).CFrame, speed = (#rings + 1) * 0.6 * (if #rings % 2 == 0 then 1 else -1) })
		end
	end
end
collectRings()
task.spawn(function()
	local angle = 0
	while true do
		angle += 0.05
		for _, r in rings do
			r.part.CFrame = r.base * CFrame.Angles(0, math.sin(angle * r.speed) * 0.45, 0) -- gyroscope wobble
		end
		local frac = reactorHp / Config.REACTOR_MAX_HP
		local core = stage.reactor
		if core.Parent then
			core.Color = Color3.fromRGB(90, 220, 255):Lerp(Color3.fromRGB(255, 50, 40), 1 - frac)
			local l = core:FindFirstChildOfClass("PointLight")
			if l then
				l.Color = core.Color
			end
		end
		task.wait(0.05)
	end
end)

-- Lights: power outage + alarm -------------------------------------------------------------
local modSpeed = 0 -- extra Keis speed from the wave modifier
local lastMission: string? = nil
local activeMod: any = nil -- the current wave modifier (Config.Modifiers entry) or nil
local function setPower(on: boolean)
	setAttr("PowerOut", not on)
	Keis.hooks.speedBonus = modSpeed + (if on then 0 else Config.Waves.OutageSpeedBonus)
	for _, panel in CollectionService:GetTagged("ShipLight") do
		local l = panel:FindFirstChildOfClass("PointLight")
		if l then
			l.Enabled = on
		end
		if panel:IsA("BasePart") then
			panel.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
	for _, player in Players:GetPlayers() do
		local head = player.Character and player.Character:FindFirstChild("Head")
		local flashlight = head and head:FindFirstChild("Flashlight") :: SpotLight?
		if flashlight then
			flashlight.Enabled = not on
		end
	end
end

local alarmOn = false
local function setAlarm(on: boolean)
	alarmOn = on
	setAttr("Alarm", on)
	for _, beacon in CollectionService:GetTagged("AlarmLight") do
		local l = beacon:FindFirstChildOfClass("PointLight")
		if l then
			l.Enabled = on
		end
		if beacon:IsA("BasePart") then
			beacon.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end
task.spawn(function()
	while true do
		if alarmOn then
			local b = (math.sin(os.clock() * 4) + 1) * 0.6
			for _, beacon in CollectionService:GetTagged("AlarmLight") do
				local l = beacon:FindFirstChildOfClass("PointLight")
				if l then
					l.Brightness = b
				end
			end
		end
		task.wait(0.1)
	end
end)

-- XP & rewards -------------------------------------------------------------------------------
local function grantXP(player: Player, amount: number)
	local gained = PlayerData.addXP(player, amount)
	if gained > 0 then
		local data = PlayerData.get(player)
		if data then
			local title = Config.titleFor(data.Level)
			R.LevelUp:FireClient(player, data.Level, title)
			R.Notify:FireAllClients(`{player.DisplayName} reached LEVEL {data.Level} · {title}`, "gold")
		end
	end
end

-- Crew: health, downed, revive ------------------------------------------------------------------
local function crewStatus(player: Player): string?
	return player:GetAttribute("CrewStatus") :: string?
end

local function aliveCrew(): number
	local n = 0
	for _, p in crew() do
		if crewStatus(p) == "alive" then
			n += 1
		end
	end
	return n
end

local function revive(player: Player, by: Player?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not player:GetAttribute("Downed") then
		return
	end
	player:SetAttribute("Downed", false)
	player:SetAttribute("CrewStatus", "alive")
	local s = Combat.stats(player)
	humanoid.Health = humanoid.MaxHealth * Config.REVIVE_HEALTH
	humanoid.WalkSpeed = s.walkSpeed
	local hrp = (character :: Model):FindFirstChild("HumanoidRootPart")
	local prompt = hrp and hrp:FindFirstChild("RevivePrompt")
	if prompt then
		prompt:Destroy()
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local tool: Tool? = nil
	if backpack then
		for _, t in backpack:GetChildren() do
			if t:IsA("Tool") and t:GetAttribute("IsWeapon") then
				tool = t
			end
		end
	end
	if tool then
		humanoid:EquipTool(tool)
	end
	if by then
		narrate("Revived", player.DisplayName)
		R.CrewAction:FireAllClients(by.UserId, "*Revives " .. player.DisplayName .. "*")
		Combat.addCredits(by, 10)
		grantXP(by, 10)
	end
end

local function down(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp or player:GetAttribute("Downed") then
		return
	end
	if PerkSystem.get(player, "SecondWind") > 0 and not player:GetAttribute("SecondWindUsed") then
		player:SetAttribute("SecondWindUsed", true)
		humanoid.Health = humanoid.MaxHealth * 0.5
		R.CrewAction:FireAllClients(player.UserId, "*Second Wind*")
		R.Notify:FireAllClients(`{player.DisplayName} refused to go down (SECOND WIND)`, "gold")
		return
	end
	player:SetAttribute("Downed", true)
	player:SetAttribute("CrewStatus", "downed")
	humanoid.Health = 1
	humanoid.WalkSpeed = 4
	humanoid:UnequipTools()
	narrate("Downed", player.DisplayName)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = Config.REVIVE_TIME
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = hrp
	prompt.Triggered:Connect(function(by)
		if by ~= player and crewStatus(by) == "alive" then
			revive(player, by)
		end
	end)

	local downedAt = os.clock()
	player:SetAttribute("DownedUntil", workspace:GetServerTimeNow() + Config.DOWNED_BLEEDOUT)
	task.spawn(function()
		while player.Parent and player:GetAttribute("Downed") and humanoid.Parent and humanoid.Health > 0 do
			if os.clock() - downedAt >= Config.DOWNED_BLEEDOUT then
				humanoid.Health = 0
				break
			end
			task.wait(0.25)
		end
	end)
end

local function hurt(player: Player, damage: number)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or player:GetAttribute("Downed") then
		return
	end
	R.PlayerHurt:FireClient(player, damage)
	if humanoid.Health - damage <= 1 then
		down(player)
	else
		humanoid:TakeDamage(damage)
	end
end

local function onCharacter(player: Player, character: Model)
	player:SetAttribute("Downed", false)
	player:SetAttribute("CrewStatus", "alive")
	local head = character:WaitForChild("Head", 5)
	if head then
		local flashlight = Instance.new("SpotLight")
		flashlight.Name = "Flashlight"
		flashlight.Range = 45
		flashlight.Angle = 55
		flashlight.Brightness = 3
		flashlight.Color = Color3.fromRGB(255, 240, 215)
		flashlight.Shadows = true
		flashlight.Enabled = ReplicatedStorage:GetAttribute("PowerOut") == true
		flashlight.Parent = head
	end
	Combat.applyCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = if stage.name == "Moon" then Config.MOON_JUMP_POWER else 50
		humanoid.Died:Connect(function()
			player:SetAttribute("Downed", false)
			if running then
				player:SetAttribute("CrewStatus", "dead")
				narrate("Deceased", player.DisplayName)
				-- comes back at the next break
			else
				task.delay(3, function()
					if player.Parent and not running and player:GetAttribute("InGame") then
						player:LoadCharacter()
					end
				end)
			end
		end)
	end
end

Players.CharacterAutoLoads = false
local function onPlayerAdded(player: Player)
	PlayerData.load(player)
	Combat.reset(player)
	PerkSystem.reset(player)
	Loot.resetKeys(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player.CharacterAppearanceLoaded:Connect(function(character)
		if Config.SPACESUITS then
			Suit.apply(character)
		end
	end)
	-- the character spawns when the player presses PLAY in the menu (PlayRequest)
end
R.PlayRequest.OnServerEvent:Connect(function(player)
	if player:GetAttribute("InGame") then
		return
	end
	player:SetAttribute("InGame", true)
	player:LoadCharacter()
	if running then
		R.Notify:FireAllClients(`{player.DisplayName} joined the crew`, "cyan")
	end
end)
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end
Players.PlayerRemoving:Connect(function(player)
	PlayerData.release(player)
	Combat.remove(player)
	PerkSystem.remove(player)
end)
game:BindToClose(function()
	for _, p in Players:GetPlayers() do
		PlayerData.save(p)
	end
end)

-- Keis wiring ----------------------------------------------------------------------------------
local function spawnKeis(typeId: string, at: Vector3?, hpScale: number)
	local pos = at or stage.vents[rng:NextInteger(1, #stage.vents)]
	pos += Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
	if stage.name == "Moon" then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { keisFolder }
		local hit = workspace:Raycast(pos + Vector3.new(0, 80, 0), Vector3.new(0, -200, 0), params)
		if hit then
			pos = hit.Position + Vector3.new(0, 3, 0)
		end
	end
	return Keis.new(typeId, pos, hpScale)
end

local currentHpScale = 1
Keis.hooks.folder = keisFolder
Keis.hooks.reactor = ship.reactor
Keis.hooks.reactorRadius = ship.reactorRadius
Keis.hooks.roomCenters = ship.roomCenters
Keis.hooks.getTargets = function(): { Model }
	local list = {}
	for _, p in crew() do
		if crewStatus(p) == "alive" and p.Character then
			table.insert(list, p.Character)
		end
	end
	return list
end
Keis.hooks.onAttackPlayer = function(_k, character: Model, damage: number)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		hurt(player, damage)
	end
end
Keis.hooks.onAttackReactor = function(_k, damage: number)
	if not running then
		return
	end
	reactorHp = math.max(0, reactorHp - damage)
	setAttr("ReactorHP", reactorHp)
	if not reactorWarned and reactorHp < Config.REACTOR_MAX_HP * 0.3 then
		reactorWarned = true
		narrate("ReactorLow")
	end
end
Keis.hooks.onSummon = function(k)
	for _ = 1, k.def.summonCount or 3 do
		local offset = Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
		spawnKeis(k.def.summon, k.root.Position - Vector3.new(0, k.root.Position.Y - 3, 0) + offset, currentHpScale)
	end
	R.Notify:FireAllClients("KEIS KEIS KEIS O ALGO O ALGO", "red")
end
Keis.hooks.onExpired = function(k)
	if k.def.passive then
		narrate("GoldenEscaped")
	end
end
Keis.hooks.onKilled = function(k, killer: Player?)
	local def = k.def
	local mod = activeMod or {}
	local dropAt = k.root.Position
	if killer then
		local creditMult = (1 + 0.25 * PerkSystem.get(killer, "Scavenger")) * (mod.credits or 1)
		Combat.addCredits(killer, math.floor(def.reward * creditMult))
		Combat.onKill(killer)
		local vamp = PerkSystem.get(killer, "Vampire")
		local hum = killer.Character and killer.Character:FindFirstChildOfClass("Humanoid")
		if vamp > 0 and hum and hum.Health > 0 and not killer:GetAttribute("Downed") then
			hum.Health = math.min(hum.MaxHealth, hum.Health + 4 * vamp)
		end
		if PerkSystem.get(killer, "GoldenTouch") > 0 and rng:NextNumber() < 0.08 then
			Loot.dropKeys(dropAt, 1, true)
			Combat.addCredits(killer, 15)
		end
		local keyChance = Config.KEY_DROP_CHANCE * (1 + 0.2 * PerkSystem.get(killer, "KeyMagnet"))
		local keyCount = def.keys or (if def.boss then 6 elseif def.passive then 2 elseif rng:NextNumber() < keyChance then 1 else 0)
		if keyCount > 0 then
			Loot.dropKeys(dropAt, keyCount * (mod.keys or 1), def.passive == true)
		end
		Combat.addKill(killer)
		PlayerData.addKill(killer)
		grantXP(killer, def.xp)
		if def.passive then
			narrate("GoldenCaught", killer.DisplayName)
			R.CrewAction:FireAllClients(killer.UserId, "*Catches the golden keis*")
		elseif def.boss then
			R.Announce:FireAllClients("MASTER KEIS DESTROYED", killer.DisplayName .. " landed the final shot", "gold")
			for _, p in crew() do
				Combat.addCredits(p, 50)
			end
		end
	end
	if def.splitInto then
		local pos = k.root.Position
		for _ = 1, def.splitCount or 3 do
			local offset = Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
			spawnKeis(def.splitInto, Vector3.new(pos.X, 3, pos.Z) + offset, currentHpScale)
		end
	end
end

Combat.hooks.canShoot = function(player: Player): boolean
	return crewStatus(player) == "alive"
end
Combat.hooks.repairReactor = function(player: Player): boolean
	if not running or reactorHp >= Config.REACTOR_MAX_HP then
		return false
	end
	reactorHp = math.min(Config.REACTOR_MAX_HP, reactorHp + Config.REPAIR_AMOUNT)
	setAttr("ReactorHP", reactorHp)
	if reactorHp >= Config.REACTOR_MAX_HP * 0.3 then
		reactorWarned = false
	end
	R.Notify:FireAllClients(`{player.DisplayName} repaired the reactor`, "cyan")
	return true
end
Combat.init(remotes)
ship.armoryPrompt.Triggered:Connect(function(player)
	R.OpenArmory:FireClient(player)
end)

PerkSystem.init(remotes)
PerkSystem.hooks.onChanged = function(player: Player)
	Combat.refresh(player)
end
PerkSystem.hooks.spendKey = function(player: Player): boolean
	return Loot.spendKeys(player, 1)
end
PerkSystem.hooks.onPicked = function(player: Player, perkId: string)
	local perk = Perks.byId[perkId]
	if perk then
		R.CrewAction:FireAllClients(player.UserId, `*{perk.name}*`)
		if perk.rarity == "Legendary" then
			R.Notify:FireAllClients(`{player.DisplayName} took {perk.name}`, "gold")
		end
	end
end

Loot.hooks.magnetRange = function(player: Player): number
	return 8 + 14 * PerkSystem.get(player, "KeyMagnet")
end
Loot.hooks.onCrateReward = function(player: Player, kind: string)
	if kind == "Credits" then
		local c = 30 + wave * 6
		Combat.addCredits(player, c)
		R.Notify:FireClient(player, `CRATE · +{c} CREDITS`, "gold")
	elseif kind == "Heal" then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = hum.MaxHealth
		end
		R.Notify:FireClient(player, "CRATE · SUIT REPAIRED (FULL HEALTH)", "green")
	elseif kind == "Perk" then
		PerkSystem.offer(player, wave)
		R.Notify:FireClient(player, "CRATE · EXTRA PERK CARD", "cyan")
	elseif kind == "Keys" then
		Loot.addKeys(player, 2)
		R.Notify:FireClient(player, "CRATE · +2 KEYS", "gold")
	elseif kind == "Legendary" then
		PerkSystem.offer(player, wave, "Legendary")
		R.Notify:FireAllClients(`{player.DisplayName} found a LEGENDARY card in a crate`, "gold")
	end
end

-- Global leaderboard on the bridge ---------------------------------------------------------------
local function renderBoard(entries: { { name: string, wave: number } })
	local frame = ship.leaderboard
	frame:ClearAllChildren()
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.Parent = frame
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 24)
	pad.PaddingRight = UDim.new(0, 24)
	pad.PaddingTop = UDim.new(0, 18)
	pad.Parent = frame
	local function row(text: string, color: Color3, size: number, font: Enum.Font)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, size + 8)
		l.Font = font
		l.TextSize = size
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = color
		l.Text = text
		l.Parent = frame
	end
	row("TOP CREW · BEST WAVE", Color3.fromRGB(255, 138, 61), 30, Enum.Font.GothamBlack)
	if #entries == 0 then
		row("No records yet. Be the first.", Color3.fromRGB(150, 138, 128), 22, Enum.Font.GothamMedium)
	end
	for i, e in entries do
		local color = if i == 1 then Color3.fromRGB(255, 205, 64) else Color3.fromRGB(245, 236, 222)
		row(string.format("%2d.  %-18s  WAVE %d", i, e.name, e.wave), color, 22, Enum.Font.Code)
	end
end
task.spawn(function()
	while true do
		renderBoard(PlayerData.fetchTop(10))
		task.wait(90)
	end
end)

-- Waves ------------------------------------------------------------------------------------------
local function pickType(n: number): string
	local total, pool = 0, {}
	for id, def in Config.KeisTypes do
		if def.weight > 0 and def.unlockWave <= n then
			total += def.weight
			table.insert(pool, { id = id, w = def.weight })
		end
	end
	local roll = rng:NextNumber() * total
	for _, e in pool do
		roll -= e.w
		if roll <= 0 then
			return e.id
		end
	end
	return "Basic"
end

local function randomCrewName(): string?
	local names = {}
	for _, p in crew() do
		if crewStatus(p) == "alive" then
			table.insert(names, p.DisplayName)
		end
	end
	return if #names > 0 then names[rng:NextInteger(1, #names)] else nil
end

-- floor positions for mission objects and crates on the current stage
local function stagePoints(): { Vector3 }
	if stage.name ~= "Moon" then
		return stage.roomCenters
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { keisFolder }
	local out = {}
	for _, p in stage.roomCenters do
		local hit = workspace:Raycast(p + Vector3.new(0, 60, 0), Vector3.new(0, -150, 0), params)
		table.insert(out, if hit then hit.Position else p)
	end
	return out
end

local function runWave(n: number): (boolean, string, string, boolean)
	local W = Config.Waves
	local kind = Missions.pick(n, rng, lastMission, W.BossEvery)
	lastMission = kind
	local def = Missions.Defs[kind]

	-- a wave modifier from wave 3
	activeMod = nil
	if n >= Config.MODIFIER_FROM_WAVE and kind ~= "GoldRush" and rng:NextNumber() < Config.MODIFIER_CHANCE then
		local ids = {}
		for id in Config.Modifiers do
			table.insert(ids, id)
		end
		table.sort(ids)
		activeMod = Config.Modifiers[ids[rng:NextInteger(1, #ids)]]
	end
	local mod = activeMod or {}

	local playerCount = math.max(1, #crew())
	local count = math.floor((W.BaseCount + W.CountPerWave * (n - 1)) * (1 + (playerCount - 1) * W.ExtraPlayerMultiplier) * (mod.count or 1))
	if kind == "Boss" then
		count = math.floor(count * 0.6)
	end
	currentHpScale = (1 + W.HealthScalePerWave * (n - 1)) * (mod.hp or 1)
	local interval = math.max(W.SpawnIntervalMin, W.SpawnIntervalStart - 0.06 * (n - 1)) / (mod.count or 1)
	modSpeed = mod.speed or 0
	Keis.hooks.speedBonus = modSpeed

	setPhase("Wave")
	setAttr("Wave", n)
	setAttr("Mission", def.name)
	setAttr("Modifier", if activeMod then `{activeMod.name} · {string.upper(activeMod.desc)}` else "")
	setAlarm(true)
	Loot.clearCrates()
	for _, p in crew() do
		p:SetAttribute("SecondWindUsed", false)
		PerkSystem.resolvePending(p)
	end

	local title = if kind == "Boss" then `BOSS WAVE {n}` else `WAVE {n} · {def.name}`
	local sub = def.desc .. (if activeMod then `   ·   {activeMod.name}` else "")
	R.Announce:FireAllClients(title, sub, if kind == "Boss" then "boss" else "wave")
	if mod.dark then
		setPower(false)
	end

	local ctx = {
		n = n,
		rng = rng,
		folder = keisFolder.Parent :: Instance,
		reactorPos = stage.reactor.Position,
		points = stagePoints(),
		count = count,
		spawnKeis = function(typeId: string, at: Vector3?, hpScale: number)
			return spawnKeis(typeId, at, hpScale)
		end,
		hpScale = currentHpScale,
		isAlive = function(p: Player): boolean
			return crewStatus(p) == "alive"
		end,
		setPower = setPower,
		narrate = narrate,
		notify = function(text: string, color: string)
			R.Notify:FireAllClients(text, color)
		end,
		setObjective = function(text: string, progress: number?)
			setAttr("Objective", text)
			setAttr("ObjectiveProgress", progress or -1)
		end,
		damageReactor = function(amount: number)
			reactorHp = math.max(0, reactorHp - amount)
			setAttr("ReactorHP", reactorHp)
		end,
	}
	local mission = Missions.create(kind, ctx :: any)
	mission:start()
	if kind == "Defend" then
		narrate("Vents", randomCrewName())
	end

	local spawned = 0
	local nextSpawn = os.clock() + 1.5
	local last = os.clock()
	local result, reason = true, ""
	while true do
		if reactorHp <= 0 then
			result, reason = false, "THE REACTOR WAS DESTROYED"
			break
		end
		if #crew() == 0 then
			result, reason = false, "THE SHIP WAS ABANDONED"
			break
		end
		if aliveCrew() == 0 then
			result, reason = false, "THE WHOLE CREW WENT DOWN"
			break
		end
		local now = os.clock()
		local dt = now - last
		last = now
		local hostile = Keis.countHostile()
		if mission.spawnMode == "count" then
			if spawned < count and now >= nextSpawn and hostile < W.MaxAlive then
				spawnKeis(pickType(n), nil, currentHpScale)
				spawned += 1
				nextSpawn = now + interval * rng:NextNumber(0.6, 1.4)
				if rng:NextNumber() < W.GoldenChance then
					spawnKeis("Golden", nil, 1)
					narrate("Golden")
				end
			end
		else
			-- timed missions: Keis keep coming until the objective is done
			local cap = math.min(W.MaxAlive, 6 + n * 2 + (playerCount - 1) * 3)
			if now >= nextSpawn and hostile < cap then
				spawnKeis(pickType(n), nil, currentHpScale)
				nextSpawn = now + interval * rng:NextNumber(1, 1.8)
			end
		end
		hostile = Keis.countHostile()
		local left = if mission.spawnMode == "count" then (count - spawned) + hostile else hostile
		setAttr("KeisLeft", left)
		local done = mission:tick(dt, left)
		if mission.spawnMode == "count" and spawned >= count and hostile == 0 then
			done = true
		end
		if done then
			break
		end
		task.wait(0.2)
	end
	mission:cleanup()
	if result and mission.spawnMode == "timed" then
		Keis.clearAll() -- the rest retreat into the vents
		narrate("Retreat")
	end
	setAttr("Objective", "")
	setAttr("ObjectiveProgress", -1)
	modSpeed = 0
	if ReplicatedStorage:GetAttribute("PowerOut") then
		setPower(true)
	end
	Keis.hooks.speedBonus = 0
	setAlarm(false)
	return result, reason, kind, mission.success
end

local function applyStage(newStage: Stage)
	stage = newStage
	setAttr("Stage", newStage.name)
	Keis.hooks.reactor = newStage.reactor
	Keis.hooks.reactorRadius = newStage.reactorRadius
	Keis.hooks.roomCenters = newStage.roomCenters
	ship.spawn.Enabled = newStage.name == "Ship"
	if moon then
		moon.spawn.Enabled = newStage.name == "Moon"
	end
	-- only one Jupiter in the sky at a time
	for _, m in ship.space do
		m.Parent = if newStage.name == "Ship" then ship.folder else ServerStorage
	end
	workspace.Gravity = if newStage.name == "Moon" then 196.2 * Config.MOON_GRAVITY else 196.2
	for _, p in crew() do
		local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = if newStage.name == "Moon" then Config.MOON_JUMP_POWER else 50
		end
	end
	collectRings()
end

local function landOnIo()
	R.Transition:FireAllClients("DESCENDING TO IO", 4)
	task.wait(1.2) -- screens are black now
	if not moon then
		moon = MoonBuilder.build()
		moon.armoryPrompt.Triggered:Connect(function(player)
			R.OpenArmory:FireClient(player)
		end)
	end
	applyStage({ name = "Moon", spawn = moon.spawn, reactor = moon.reactor, reactorRadius = moon.reactorRadius,
		vents = moon.vents, roomCenters = moon.roomCenters })
	reactorHp = Config.REACTOR_MAX_HP
	reactorWarned = false
	setAttr("ReactorHP", reactorHp)
	for _, p in crew() do
		local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			p.Character:PivotTo(moon.spawn.CFrame + Vector3.new(rng:NextNumber(-4, 4), 4, rng:NextNumber(-3, 3)))
		end
	end
	R.Announce:FireAllClients("IO", "JUPITER'S VOLCANIC MOON · LOW GRAVITY · DEFEND THE GENERATOR", "gold")
	narrate("Landing")
end

local function returnToShip()
	if stage.name ~= "Ship" then
		applyStage(shipStage)
	end
	if moon then
		MoonBuilder.clear()
		moon = nil
	end
end

local function respawnCrew()
	for _, p in crew() do
		local humanoid = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if p:GetAttribute("Downed") then
			revive(p, nil)
		elseif not humanoid or humanoid.Health <= 0 then
			p:LoadCharacter()
		end
	end
end

local function gameOver(reason: string)
	Keis.clearAll()
	Loot.clearKeys()
	Loot.clearCrates()
	setAttr("Mission", "")
	setAttr("Modifier", "")
	setAlarm(false)
	setPower(true)
	local summary = { wave = wave, reason = reason, crew = {} :: { any }, mvp = 0 }
	local bestKills = -1
	for _, p in crew() do
		local kills, damage = Combat.getRunStats(p)
		table.insert(summary.crew, { userId = p.UserId, name = p.DisplayName, kills = kills, damage = damage,
			level = p:GetAttribute("Level") or 1 })
		if kills > bestKills then
			bestKills = kills
			summary.mvp = p.UserId
		end
		PlayerData.save(p)
	end
	R.GameOver:FireAllClients(summary)
	narrate("GameOver")
	setPhase("GameOver", Config.GAMEOVER_TIME)
	task.wait(Config.GAMEOVER_TIME)
	running = false
	returnToShip()
	reactorHp = Config.REACTOR_MAX_HP
	setAttr("ReactorHP", reactorHp)
	setAttr("Wave", 0)
	setAttr("KeisLeft", 0)
	for _, p in crew() do
		Combat.reset(p)
		p:LoadCharacter()
	end
end

local function startRun()
	running = true
	wave = 0
	reactorHp = Config.REACTOR_MAX_HP
	reactorWarned = false
	setAttr("ReactorHP", reactorHp)
	lastMission = nil
	for _, p in crew() do
		Combat.reset(p)
		PerkSystem.reset(p)
		Loot.resetKeys(p)
		PlayerData.addRun(p)
		p:LoadCharacter()
	end
	narrate("RunStart")
	task.wait(2)

	while true do
		wave += 1
		local cleared, reason, kind, success = runWave(wave)
		if not cleared then
			gameOver(reason)
			return
		end
		local bonus = Config.Waves.ClearBonusBase + Config.Waves.ClearBonusPerWave * wave
		local special = kind ~= "Defend" and success
		for _, p in crew() do
			Combat.addCredits(p, bonus)
			grantXP(p, Config.XP_PER_WAVE * wave)
			PlayerData.recordWave(p, wave)
			if special then
				Loot.addKeys(p, Config.MISSION_KEY_REWARD)
			end
			-- pick-1-of-3 perk card (bosses give a legendary choice)
			PerkSystem.offer(p, wave, if kind == "Boss" then "Legendary" else nil)
		end
		local missionName = Missions.Defs[kind].name
		R.Announce:FireAllClients(if success then `{missionName} COMPLETE` else `{missionName} FAILED`,
			`+{bonus} CREDITS{if special then ` · +{Config.MISSION_KEY_REWARD} KEYS` else ""} · PICK A PERK · OPEN CRATES`, if success then "clear" else "boss")
		narrate("WaveClear")
		-- supply crates around the map (open them with keys)
		local spots = {}
		for _, p in stagePoints() do
			if (Vector3.new(p.X, 0, p.Z) - Vector3.new(stage.reactor.Position.X, 0, stage.reactor.Position.Z)).Magnitude > 14 then
				table.insert(spots, p + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6)))
			end
		end
		Loot.spawnCrates(spots, Config.CRATES_PER_BREAK)
		if wave == Config.LANDING_WAVE and stage.name == "Ship" then
			landOnIo()
		end
		respawnCrew()
		local breakTime = if wave % Config.Waves.BossEvery == 0 then Config.BOSS_BREAK_TIME else Config.BREAK_TIME
		for t = breakTime, 1, -1 do
			setPhase("Break", t)
			task.wait(1)
		end
	end
end

while true do
	setPhase("Lobby")
	while #crew() < Config.MIN_PLAYERS do
		task.wait(1)
	end
	local ready = true
	for t = Config.LOBBY_TIME, 1, -1 do
		setPhase("Lobby", t)
		task.wait(1)
		if #crew() < Config.MIN_PLAYERS then
			ready = false
			break
		end
	end
	if ready then
		local ok, err = pcall(startRun)
		if not ok then
			warn("[Jupiter2011] run crashed:", err)
			Keis.clearAll()
			running = false
			setAlarm(false)
			setPower(true)
			pcall(returnToShip)
		end
	end
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">KeisAI</string><ProtectedString name="Source"><![CDATA[--!strict
-- The Keis: key-shaped entities with faces that chant "keis keis keis o algo o algo".
-- They crawl out of the vents and go for the reactor, or for any crew member who gets close.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Keis = {}
Keis.__index = Keis

-- Set by the GameManager -----------------------------------------------------------------
Keis.registry = {} :: { [Model]: any }
Keis.chantsPlaying = 0 -- how many chant sounds are playing right now (capped so it never turns into noise)
Keis.hooks = {
	folder = nil :: Folder?,
	reactor = nil :: BasePart?,
	reactorRadius = 8,
	roomCenters = {} :: { Vector3 },
	speedBonus = 0,
	getTargets = function(): { Model }
		return {}
	end,
	onKilled = function(_keis: any, _killer: Player?) end,
	onAttackPlayer = function(_keis: any, _character: Model, _damage: number) end,
	onAttackReactor = function(_keis: any, _damage: number) end,
	onSummon = function(_keis: any) end,
	onExpired = function(_keis: any) end,
}

local KeisModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("KeisModel"))
local buildModel = KeisModel.build


function Keis.new(typeId: string, position: Vector3, hpScale: number)
	local def = (Config.KeisTypes :: any)[typeId]
	assert(def, "unknown Keis type " .. typeId)
	local self = setmetatable({}, Keis)
	local model, humanoid, root, face, bodyParts, chant, barBack, barFill = buildModel(def, position)
	self.typeId = typeId
	self.def = def
	self.model = model
	self.humanoid = humanoid
	self.root = root
	self.face = face
	self.bodyParts = bodyParts
	self.chant = chant
	self.barBack = barBack
	self.barFill = barFill
	self.maxHp = def.hp * hpScale
	self.hp = self.maxHp
	self.alive = true
	self.bornAt = os.clock()
	self.lastAttack = 0
	self.lastSummon = os.clock()
	self.lastPath = 0
	self.waypoints = nil :: { PathWaypoint }?
	self.wpIndex = 1
	self.lastPos = root.Position
	self.lastProgress = os.clock()
	self.wanderGoal = nil :: Vector3?
	self.path = PathfindingService:CreatePath({
		AgentRadius = math.min(1.6 * def.scale, 3.5),
		AgentHeight = math.min(10 * def.scale, 14),
		AgentCanJump = false,
		WaypointSpacing = 6,
	})

	model.Parent = Keis.hooks.folder or workspace
	root:SetNetworkOwner(nil)
	Keis.registry[model] = self

	task.spawn(function()
		task.wait(math.random() * 0.15)
		while self.alive do
			local ok, err = pcall(self.step, self)
			if not ok then
				warn("[Keis] step error:", err)
			end
			task.wait(0.15)
		end
	end)
	-- the chant: "keis keis keis o algo o algo" — text + sound together, now and then
	task.spawn(function()
		local rng = Random.new()
		local sound = root:FindFirstChild("Chant") :: Sound?
		task.wait(rng:NextNumber(0.3, 2.5))
		while self.alive do
			if def.boss or rng:NextNumber() < Config.KEIS_CHANT_CHANCE then
				self.chant.Text = Config.KeisChatter[rng:NextInteger(1, #Config.KeisChatter)]
				self.chant.Rotation = rng:NextNumber(-5, 5)
				local duration = rng:NextNumber(1.5, 2.6)
				if sound and sound.Parent and (def.boss or Keis.chantsPlaying < Config.MAX_SIMULTANEOUS_CHANTS) then
					local speed = ((sound:GetAttribute("BaseSpeed") :: number?) or 1) * rng:NextNumber(0.92, 1.08)
					sound.PlaybackSpeed = speed
					sound.TimePosition = 0
					sound:Play()
					Keis.chantsPlaying += 1
					duration = if sound.TimeLength > 0 then sound.TimeLength / speed else 5
					task.delay(duration, function()
						Keis.chantsPlaying -= 1
					end)
				end
				task.wait(duration)
				self.chant.Text = ""
			end
			task.wait(if def.boss then rng:NextNumber(1, 2.5) else rng:NextNumber(2, 6))
		end
	end)
	return self
end

function Keis.fromPart(instance: Instance): any?
	local node: Instance? = instance
	while node and node ~= workspace do
		if node:IsA("Model") and Keis.registry[node] then
			return Keis.registry[node]
		end
		node = node.Parent
	end
	return nil
end

function Keis.countHostile(): number
	local n = 0
	for _, k in Keis.registry do
		if k.alive and not k.def.passive then
			n += 1
		end
	end
	return n
end

function Keis.clearAll()
	for _, k in Keis.registry do
		k:destroy()
	end
	Keis.registry = {}
end

-- Damage ----------------------------------------------------------------------------------
function Keis:takeDamage(amount: number, killer: Player?): boolean
	if not self.alive then
		return false
	end
	self.hp -= amount
	self.barBack.Visible = true
	self.barFill.Size = UDim2.fromScale(math.clamp(self.hp / self.maxHp, 0, 1), 1)
	-- hit flash
	for _, p in self.bodyParts do
		p.Color = Color3.new(1, 1, 1)
	end
	task.delay(0.07, function()
		for _, p in self.bodyParts do
			if p.Parent then
				p.Color = (p:GetAttribute("BaseColor") :: Color3?) or self.def.color
			end
		end
	end)
	if self.hp <= 0 then
		self:die(killer)
		return true
	end
	return false
end

function Keis:die(killer: Player?)
	if not self.alive then
		return
	end
	self.alive = false
	Keis.registry[self.model] = nil
	Keis.hooks.onKilled(self, killer)

	-- pop: shrink + fade, and a burst
	local center = self.root.Position + Vector3.new(0, 4 * self.def.scale, 0)
	local burst = Instance.new("Part")
	burst.Shape = Enum.PartType.Ball
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.Material = Enum.Material.Neon
	burst.Color = if self.def.passive then Color3.fromRGB(255, 215, 70) else Color3.fromRGB(255, 120, 60)
	burst.Size = Vector3.one * 2
	burst.CFrame = CFrame.new(center)
	burst.Parent = workspace
	TweenService:Create(burst, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.one * 9 * self.def.scale, Transparency = 1 }):Play()
	task.delay(0.4, function()
		burst:Destroy()
	end)
	for _, d in self.model:GetDescendants() do
		if d:IsA("BasePart") then
			TweenService:Create(d, TweenInfo.new(0.25), { Transparency = 1 }):Play()
		end
	end
	local chant = self.root:FindFirstChild("Chant")
	if chant then
		chant:Destroy()
	end
	self.humanoid.WalkSpeed = 0
	task.delay(0.3, function()
		self.model:Destroy()
	end)
end

function Keis:destroy()
	self.alive = false
	Keis.registry[self.model] = nil
	self.model:Destroy()
end

-- Movement ----------------------------------------------------------------------------------
function Keis:hasLineOfSight(pos: Vector3, ignore: Instance?): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list: { Instance } = { Keis.hooks.folder or self.model }
	if ignore then
		table.insert(list, ignore)
	end
	params.FilterDescendantsInstances = list
	local from = self.root.Position + Vector3.new(0, 1, 0)
	local to = Vector3.new(pos.X, from.Y, pos.Z)
	return workspace:Raycast(from, to - from, params) == nil
end

function Keis:pathTo(pos: Vector3)
	self.lastPath = os.clock()
	local ok = pcall(function()
		self.path:ComputeAsync(self.root.Position, pos)
	end)
	if ok and self.path.Status == Enum.PathStatus.Success then
		self.waypoints = self.path:GetWaypoints()
		self.wpIndex = 2
	else
		self.waypoints = nil
	end
end

function Keis:moveTowards(pos: Vector3, ignore: Instance?)
	local flat = Vector3.new(pos.X - self.root.Position.X, 0, pos.Z - self.root.Position.Z)
	if flat.Magnitude < 45 and self:hasLineOfSight(pos, ignore) then
		self.waypoints = nil
		self.humanoid:MoveTo(pos)
		return
	end
	if self.waypoints == nil or os.clock() - self.lastPath > 1.2 then
		self:pathTo(pos)
	end
	local wps = self.waypoints
	if wps and self.wpIndex <= #wps then
		local wp = wps[self.wpIndex]
		self.humanoid:MoveTo(wp.Position)
		local d = Vector3.new(wp.Position.X - self.root.Position.X, 0, wp.Position.Z - self.root.Position.Z)
		if d.Magnitude < 3 * math.max(1, self.def.scale) then
			self.wpIndex += 1
		end
	end
end

function Keis:step()
	if not self.model.Parent then
		self.alive = false
		Keis.registry[self.model] = nil
		return
	end
	local def = self.def
	local hooks = Keis.hooks
	self.humanoid.WalkSpeed = def.speed + (if def.passive then 0 else hooks.speedBonus)

	-- unstick
	if (self.root.Position - self.lastPos).Magnitude > 1 then
		self.lastPos = self.root.Position
		self.lastProgress = os.clock()
	elseif os.clock() - self.lastProgress > 2.5 then
		self.waypoints = nil
		self.lastPath = 0
		self.wanderGoal = nil
		self.lastProgress = os.clock()
	end

	-- golden keis: runs around, then escapes
	if def.passive then
		if os.clock() - self.bornAt > (def.lifetime or 25) then
			self.alive = false
			Keis.registry[self.model] = nil
			hooks.onExpired(self)
			self.model:Destroy()
			return
		end
		if self.wanderGoal == nil or (self.root.Position - self.wanderGoal).Magnitude < 6 then
			local rooms = hooks.roomCenters
			self.wanderGoal = rooms[math.random(1, #rooms)] + Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
			self.waypoints = nil
		end
		self:moveTowards(self.wanderGoal :: Vector3)
		return
	end

	-- the boss summons minis
	if def.summon and os.clock() - self.lastSummon > (def.summonEvery or 8) then
		self.lastSummon = os.clock()
		hooks.onSummon(self)
	end

	-- pick a target: a nearby crew member, otherwise the reactor
	local aggro = if def.boss then 70 else 45
	local best: Model? = nil
	local bestDist = aggro
	for _, character in hooks.getTargets() do
		local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local d = (hrp.Position - self.root.Position).Magnitude
			if d < bestDist then
				best, bestDist = character, d
			end
		end
	end

	local now = os.clock()
	local cooldown = if def.boss then 1.4 else 1
	if best then
		local hrp = best:FindFirstChild("HumanoidRootPart") :: BasePart
		if bestDist <= 3.5 + 1.6 * def.scale then
			self.humanoid:MoveTo(hrp.Position)
			if now - self.lastAttack > cooldown then
				self.lastAttack = now
				hooks.onAttackPlayer(self, best, def.damage)
			end
			return
		end
		self:moveTowards(hrp.Position, best)
		return
	end

	local reactor = hooks.reactor
	if reactor then
		local flat = Vector3.new(reactor.Position.X - self.root.Position.X, 0, reactor.Position.Z - self.root.Position.Z)
		if flat.Magnitude <= hooks.reactorRadius + 2 + 1.6 * def.scale then
			self.humanoid:MoveTo(self.root.Position)
			if now - self.lastAttack > cooldown then
				self.lastAttack = now
				hooks.onAttackReactor(self, def.damage)
			end
			return
		end
		-- walk to the edge of the reactor (its center is solid, so a path there would fail)
		local out = Vector3.new(-flat.X, 0, -flat.Z)
		if out.Magnitude < 0.1 then
			out = Vector3.new(1, 0, 0)
		end
		local goal = Vector3.new(reactor.Position.X, self.root.Position.Y, reactor.Position.Z) + out.Unit * (hooks.reactorRadius + 1.5)
		self:moveTowards(goal)
	end
end

return Keis
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Loot</string><ProtectedString name="Source"><![CDATA[--!strict
-- Keys (dropped by Keis, pulled toward players) and supply crates (opened with keys between waves).

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Loot = {}

Loot.hooks = {
	crewChars = function(): { Model }
		return {}
	end,
	magnetRange = function(_player: Player): number
		return 8
	end,
	onKeysCollected = function(_player: Player, _amount: number) end,
	onCrateReward = function(_player: Player, _kind: string) end,
}

local folder = Instance.new("Folder")
folder.Name = "Loot"
folder.Parent = workspace

local BRASS = Color3.fromRGB(214, 172, 70)
local GOLD = Color3.fromRGB(255, 205, 64)

type Key = { model: Model, value: number, born: number, base: Vector3 }
local keys: { Key } = {}
local crates: { Model } = {}

function Loot.getKeys(player: Player): number
	return (player:GetAttribute("Keys") :: number?) or 0
end

function Loot.addKeys(player: Player, amount: number)
	player:SetAttribute("Keys", Loot.getKeys(player) + amount)
end

function Loot.spendKeys(player: Player, amount: number): boolean
	local have = Loot.getKeys(player)
	if have < amount then
		return false
	end
	player:SetAttribute("Keys", have - amount)
	return true
end

function Loot.resetKeys(player: Player)
	player:SetAttribute("Keys", 0)
end

local function keyModel(pos: Vector3, golden: boolean): Model
	local m = Instance.new("Model")
	m.Name = "KeyPickup"
	local color = if golden then GOLD else BRASS
	local shaft = Instance.new("Part")
	shaft.Name = "Shaft"
	shaft.Size = Vector3.new(0.3, 1.4, 0.3)
	shaft.Material = Enum.Material.Neon
	shaft.Color = color
	shaft.Anchored = true
	shaft.CanCollide = false
	shaft.CanQuery = false
	shaft.CanTouch = false
	shaft.CFrame = CFrame.new(pos)
	shaft.Parent = m
	local bow = shaft:Clone()
	bow.Name = "Bow"
	bow.Shape = Enum.PartType.Cylinder
	bow.Size = Vector3.new(0.25, 0.9, 0.9)
	bow.CFrame = CFrame.new(pos + Vector3.new(0, 0.95, 0)) * CFrame.Angles(0, math.rad(90), 0)
	bow.Parent = m
	local bit = shaft:Clone()
	bit.Name = "Bit"
	bit.Size = Vector3.new(0.45, 0.25, 0.3)
	bit.CFrame = CFrame.new(pos + Vector3.new(0.25, -0.5, 0))
	bit.Parent = m
	m.PrimaryPart = shaft
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = if golden then 12 else 7
	light.Brightness = 1.5
	light.Parent = shaft
	m.Parent = folder
	return m
end

function Loot.dropKeys(pos: Vector3, count: number, golden: boolean?)
	for i = 1, count do
		local offset = Vector3.new(math.random(-20, 20) / 10, 1.6, math.random(-20, 20) / 10)
		local base = pos + offset
		table.insert(keys, { model = keyModel(base, golden == true), value = if golden then 3 else 1, born = os.clock() + i * 0.05, base = base })
	end
end

function Loot.clearKeys()
	for _, k in keys do
		k.model:Destroy()
	end
	keys = {}
end

-- spin, bob, magnet and collect
task.spawn(function()
	while true do
		local dt = task.wait(0.05)
		local now = os.clock()
		local players = {}
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("CrewStatus") == "alive" and p.Character then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp then
					table.insert(players, { player = p, pos = hrp.Position, range = Loot.hooks.magnetRange(p) })
				end
			end
		end
		for i = #keys, 1, -1 do
			local k = keys[i]
			if now - k.born > 45 or not k.model.Parent then
				k.model:Destroy()
				table.remove(keys, i)
				continue
			end
			local target, best = nil, math.huge
			for _, e in players do
				local d = (e.pos - k.base).Magnitude
				if d < e.range and d < best then
					target, best = e, d
				end
			end
			if target and best < 3 then
				Loot.addKeys(target.player, k.value)
				Loot.hooks.onKeysCollected(target.player, k.value)
				k.model:Destroy()
				table.remove(keys, i)
				continue
			elseif target then
				k.base = k.base:Lerp(target.pos, math.min(dt * 9, 1))
			end
			local spin = CFrame.Angles(0, now * 3, 0)
			k.model:PivotTo(CFrame.new(k.base + Vector3.new(0, math.sin(now * 3 + i) * 0.25, 0)) * spin)
		end
	end
end)

-- Supply crates -------------------------------------------------------------------------------------
local REWARDS = {
	{ kind = "Credits", w = 38 },
	{ kind = "Heal", w = 20 },
	{ kind = "Perk", w = 24 },
	{ kind = "Keys", w = 12 },
	{ kind = "Legendary", w = 6 },
}

local function rollReward(): string
	local total = 0
	for _, r in REWARDS do
		total += r.w
	end
	local roll = math.random() * total
	for _, r in REWARDS do
		roll -= r.w
		if roll <= 0 then
			return r.kind
		end
	end
	return "Credits"
end

local function crate(pos: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "SupplyCrate"
	local function piece(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, collide: boolean): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = collide
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material
		p.Parent = m
		return p
	end
	local body = piece("Body", Vector3.new(4.2, 2.6, 2.8), CFrame.new(pos + Vector3.new(0, 1.3, 0)), Color3.fromRGB(70, 74, 82), Enum.Material.DiamondPlate, true)
	piece("Lid", Vector3.new(4.4, 0.5, 3), CFrame.new(pos + Vector3.new(0, 2.85, 0)), Color3.fromRGB(90, 95, 104), Enum.Material.Metal, false)
	piece("Stripe", Vector3.new(4.25, 0.35, 2.85), CFrame.new(pos + Vector3.new(0, 1.9, 0)), Color3.fromRGB(255, 138, 61), Enum.Material.SmoothPlastic, false)
	local lock = piece("Lock", Vector3.new(0.7, 0.7, 0.2), CFrame.new(pos + Vector3.new(0, 1.9, -1.5)), Color3.fromRGB(255, 205, 64), Enum.Material.Neon, false)
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 205, 64)
	l.Range = 9
	l.Parent = lock
	m.PrimaryPart = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Unlock (1 key)"
	prompt.ObjectText = "SUPPLY CRATE"
	prompt.HoldDuration = 0.8
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		if player:GetAttribute("CrewStatus") ~= "alive" or not prompt.Enabled then
			return
		end
		if not Loot.spendKeys(player, 1) then
			return
		end
		prompt.Enabled = false
		local lid = m:FindFirstChild("Lid") :: BasePart
		TweenService:Create(lid, TweenInfo.new(0.4, Enum.EasingStyle.Back), { CFrame = lid.CFrame * CFrame.new(0, 0.8, 1.2) * CFrame.Angles(math.rad(-70), 0, 0) }):Play()
		lock.Color = Color3.fromRGB(110, 230, 150)
		l.Color = lock.Color
		Loot.hooks.onCrateReward(player, rollReward())
		Debris:AddItem(m, 6)
	end)
	m.Parent = folder
	return m
end

function Loot.spawnCrates(points: { Vector3 }, count: number)
	Loot.clearCrates()
	local pool = table.clone(points)
	for _ = 1, math.min(count, #pool) do
		local i = math.random(1, #pool)
		local p = pool[i]
		table.remove(pool, i)
		table.insert(crates, crate(p))
	end
end

function Loot.clearCrates()
	for _, c in crates do
		c:Destroy()
	end
	crates = {}
end

return Loot
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Missions</string><ProtectedString name="Source"><![CDATA[--!strict
-- Wave missions. Every wave picks one, so no two waves play the same.
--   Defend   – destroy every Keis (classic)
--   Boss     – the Master Keis boards (every 5th wave)
--   Blackout – power is dead: find 3 fuses and carry them to the fuse box
--   Upload   – stand in the beacon zone until the signal is transmitted
--   Hunt     – kill the Keymaster before it escapes
--   GoldRush – golden Keis everywhere for a short time

local Players = game:GetService("Players")

local Missions = {}

Missions.Defs = {
	Defend = { name = "HOLD THE LINE", desc = "DESTROY EVERY KEIS", weight = 4, minWave = 1 },
	Blackout = { name = "BLACKOUT", desc = "FIND 3 FUSES · BRING THEM TO THE FUSE BOX", weight = 3, minWave = 2 },
	Upload = { name = "TRANSMIT", desc = "HOLD THE BEACON ZONE UNTIL THE SIGNAL IS SENT", weight = 3, minWave = 3 },
	Hunt = { name = "KEYMASTER HUNT", desc = "KILL THE KEYMASTER BEFORE IT ESCAPES", weight = 2, minWave = 4 },
	GoldRush = { name = "GOLD RUSH", desc = "GOLDEN KEIS EVERYWHERE · GRAB WHAT YOU CAN", weight = 1, minWave = 4 },
	Boss = { name = "MASTER KEIS", desc = "DESTROY THE MASTER KEIS", weight = 0, minWave = 99 },
}

function Missions.pick(n: number, rng: Random, last: string?, bossEvery: number): string
	if n % bossEvery == 0 then
		return "Boss"
	end
	if n == 1 then
		return "Defend"
	end
	local pool, total = {}, 0
	for kind, def in Missions.Defs do
		if def.weight > 0 and n >= def.minWave and kind ~= last then
			table.insert(pool, { kind = kind, w = def.weight })
			total += def.weight
		end
	end
	local roll = rng:NextNumber() * total
	for _, e in pool do
		roll -= e.w
		if roll <= 0 then
			return e.kind
		end
	end
	return "Defend"
end

export type Ctx = {
	n: number,
	rng: Random,
	folder: Instance,
	reactorPos: Vector3,
	points: { Vector3 }, -- floor positions around the map (room centers / moon spots)
	count: number, -- how many Keis a count-based wave spawns
	spawnKeis: (typeId: string, at: Vector3?, hpScale: number) -> any,
	hpScale: number,
	isAlive: (player: Player) -> boolean,
	setPower: (on: boolean) -> (),
	narrate: (key: string, name: string?) -> (),
	notify: (text: string, color: string) -> (),
	setObjective: (text: string, progress: number?) -> (),
	damageReactor: (amount: number) -> (),
}

local function neon(parent: Instance, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, text: string, color: Color3): TextLabel
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 40)
	bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 400
	bb.Adornee = adornee
	bb.Parent = adornee
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.3
	l.Text = text
	l.Parent = bb
	return l
end

local function farPoints(ctx: Ctx, minDist: number): { Vector3 }
	local list = {}
	for _, p in ctx.points do
		if (Vector3.new(p.X, 0, p.Z) - Vector3.new(ctx.reactorPos.X, 0, ctx.reactorPos.Z)).Magnitude >= minDist then
			table.insert(list, p)
		end
	end
	return if #list > 0 then list else ctx.points
end

local function aliveChars(ctx: Ctx): { [Player]: BasePart }
	local out = {}
	for _, p in Players:GetPlayers() do
		if ctx.isAlive(p) and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				out[p] = hrp
			end
		end
	end
	return out
end

-- A mission: spawnMode "count" (wave ends when all Keis are dead) or "timed" (Keis keep coming until tick() says done)
export type Mission = {
	kind: string,
	spawnMode: string,
	success: boolean,
	start: (self: Mission) -> (),
	tick: (self: Mission, dt: number, hostileLeft: number) -> boolean,
	cleanup: (self: Mission) -> (),
}

function Missions.create(kind: string, ctx: Ctx): Mission
	local m: any = { kind = kind, spawnMode = "count", success = true }
	local objects = Instance.new("Folder")
	objects.Name = "MissionObjects"
	objects.Parent = ctx.folder

	function m:cleanup()
		objects:Destroy()
		for _, p in Players:GetPlayers() do
			p:SetAttribute("CarryingFuse", nil)
		end
	end

	if kind == "Defend" or kind == "Boss" then
		function m:start()
			if kind == "Boss" then
				ctx.spawnKeis("Master", nil, ctx.hpScale * (1 + 0.35 * (#Players:GetPlayers() - 1)))
				ctx.narrate("Boss")
			end
		end
		function m:tick(_dt: number, hostileLeft: number): boolean
			ctx.setObjective(`{Missions.Defs[kind].desc} · {hostileLeft} LEFT`, nil)
			return false -- count mode: the wave loop ends it
		end

	elseif kind == "Blackout" then
		m.spawnMode = "timed"
		local inserted = 0
		local fuses: { { part: BasePart, prompt: ProximityPrompt, carrier: Player?, home: Vector3, done: boolean } } = {}
		local box: BasePart
		function m:start()
			ctx.setPower(false)
			ctx.narrate("Outage")
			-- fuse box next to the reactor
			local bp = ctx.reactorPos + Vector3.new(11, 0, 11)
			box = Instance.new("Part")
			box.Anchored = true
			box.Size = Vector3.new(3, 5, 1.5)
			box.CFrame = CFrame.new(Vector3.new(bp.X, ctx.points[1].Y + 2.5, bp.Z))
			box.Color = Color3.fromRGB(60, 62, 70)
			box.Material = Enum.Material.Metal
			box.Name = "FuseBox"
			box.Parent = objects
			neon(objects, Vector3.new(3.1, 0.4, 1.6), box.CFrame * CFrame.new(0, 1.8, 0), Color3.fromRGB(255, 200, 40))
			billboard(box, "FUSE BOX", Color3.fromRGB(255, 205, 64))
			local boxPrompt = Instance.new("ProximityPrompt")
			boxPrompt.ActionText = "Insert fuse"
			boxPrompt.ObjectText = "FUSE BOX"
			boxPrompt.HoldDuration = 0.6
			boxPrompt.RequiresLineOfSight = false
			boxPrompt.MaxActivationDistance = 9
			boxPrompt.Parent = box
			boxPrompt.Triggered:Connect(function(player)
				for _, f in fuses do
					if f.carrier == player and not f.done then
						f.done = true
						f.carrier = nil
						player:SetAttribute("CarryingFuse", nil)
						f.part:Destroy()
						inserted += 1
						ctx.notify(`{player.DisplayName} inserted a fuse ({inserted}/3)`, "gold")
						break
					end
				end
			end)
			-- 3 fuses in far rooms
			local spots = farPoints(ctx, 25)
			for i = 1, 3 do
				local _ = i
				local p = spots[ctx.rng:NextInteger(1, #spots)] + Vector3.new(ctx.rng:NextNumber(-5, 5), 1.2, ctx.rng:NextNumber(-5, 5))
				local fuse = neon(objects, Vector3.new(2.2, 0.9, 0.9), CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 200, 40), Enum.PartType.Cylinder)
				fuse.Name = "Fuse"
				local l = Instance.new("PointLight")
				l.Color = fuse.Color
				l.Range = 14
				l.Brightness = 2
				l.Parent = fuse
				billboard(fuse, "FUSE", Color3.fromRGB(255, 205, 64))
				local prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "Pick up"
				prompt.ObjectText = "FUSE"
				prompt.RequiresLineOfSight = false
				prompt.MaxActivationDistance = 8
				prompt.Parent = fuse
				local entry = { part = fuse :: BasePart, prompt = prompt, carrier = nil :: Player?, home = p, done = false }
				prompt.Triggered:Connect(function(player)
					if entry.carrier or not ctx.isAlive(player) or player:GetAttribute("CarryingFuse") then
						return
					end
					entry.carrier = player
					player:SetAttribute("CarryingFuse", true)
					prompt.Enabled = false
				end)
				table.insert(fuses, entry)
			end
		end
		function m:tick(_dt: number, _hostile: number): boolean
			for _, f in fuses do
				if f.carrier and not f.done then
					local c = f.carrier :: Player
					local hrp = c.Character and c.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if not ctx.isAlive(c) or not hrp then
						-- dropped where the carrier went down
						c:SetAttribute("CarryingFuse", nil)
						f.carrier = nil
						f.prompt.Enabled = true
						if hrp then
							f.part.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, 0, math.rad(90))
						end
					else
						f.part.CFrame = hrp.CFrame * CFrame.new(0, 0.5, 1.2) * CFrame.Angles(0, 0, math.rad(90))
					end
				end
			end
			ctx.setObjective(`FUSES {inserted} / 3 · BRING THEM TO THE FUSE BOX`, inserted / 3)
			if inserted >= 3 then
				ctx.setPower(true)
				ctx.narrate("PowerBack")
				return true
			end
			return false
		end

	elseif kind == "Upload" then
		m.spawnMode = "timed"
		local progress = 0
		local center: Vector3
		local label: TextLabel
		local RADIUS = 10
		function m:start()
			local spots = farPoints(ctx, 20)
			center = spots[ctx.rng:NextInteger(1, #spots)]
			neon(objects, Vector3.new(0.3, RADIUS * 2, RADIUS * 2), CFrame.new(center + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color3.fromRGB(90, 220, 255), Enum.PartType.Cylinder).Transparency = 0.55
			local beam = neon(objects, Vector3.new(60, 3, 3), CFrame.new(center + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color3.fromRGB(90, 220, 255), Enum.PartType.Cylinder)
			beam.Transparency = 0.7
			local l = Instance.new("PointLight")
			l.Color = Color3.fromRGB(90, 220, 255)
			l.Range = 30
			l.Brightness = 2
			l.Parent = beam
			label = billboard(beam, "UPLOAD 0%", Color3.fromRGB(90, 220, 255))
			ctx.notify("A beacon is online. Stand in the zone to transmit", "cyan")
		end
		function m:tick(dt: number, _hostile: number): boolean
			local inside = 0
			for _, hrp in aliveChars(ctx) do
				if (Vector3.new(hrp.Position.X - center.X, 0, hrp.Position.Z - center.Z)).Magnitude <= RADIUS then
					inside += 1
				end
			end
			if inside > 0 then
				progress += dt / 40 * (1 + 0.3 * (inside - 1))
			else
				progress = math.max(0, progress - dt / 120)
			end
			progress = math.min(progress, 1)
			label.Text = `UPLOAD {math.floor(progress * 100)}%`
			ctx.setObjective(if inside > 0 then `TRANSMITTING · {math.floor(progress * 100)}%` else `GET IN THE BEACON ZONE · {math.floor(progress * 100)}%`, progress)
			return progress >= 1
		end

	elseif kind == "Hunt" then
		m.spawnMode = "timed"
		local keymaster: any = nil
		local deadline = 0
		function m:start()
			keymaster = ctx.spawnKeis("Keymaster", nil, ctx.hpScale)
			local hl = Instance.new("Highlight")
			hl.FillColor = Color3.fromRGB(255, 200, 40)
			hl.OutlineColor = Color3.fromRGB(255, 60, 30)
			hl.FillTransparency = 0.6
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = keymaster.model
			billboard(keymaster.root, "▼ KEYMASTER ▼", Color3.fromRGB(255, 205, 64))
			deadline = os.clock() + 75
		end
		function m:tick(_dt: number, _hostile: number): boolean
			local left = math.max(0, math.ceil(deadline - os.clock()))
			ctx.setObjective(string.format("KILL THE KEYMASTER · %d:%02d", left // 60, left % 60), 1 - left / 75)
			if keymaster and not keymaster.alive then
				return true
			end
			if left <= 0 then
				m.success = false
				if keymaster and keymaster.alive then
					keymaster:destroy()
				end
				ctx.damageReactor(250)
				ctx.notify("The Keymaster escaped and sabotaged the reactor", "red")
				return true
			end
			return false
		end

	elseif kind == "GoldRush" then
		m.spawnMode = "timed"
		local endsAt = 0
		local nextGold = 0
		function m:start()
			endsAt = os.clock() + 35
			ctx.narrate("Golden")
		end
		function m:tick(_dt: number, _hostile: number): boolean
			local now = os.clock()
			if now >= nextGold then
				nextGold = now + 1.1
				ctx.spawnKeis("Golden", nil, 1 + ctx.n * 0.05)
			end
			local left = math.max(0, math.ceil(endsAt - now))
			ctx.setObjective(`GOLD RUSH · {left}s`, 1 - left / 35)
			return now >= endsAt
		end
	end

	return m :: Mission
end

return Missions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">MoonBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- IO: Jupiter's volcanic moon. Built with Terrain + parts after the crew survives wave 10.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpaceArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpaceArt"))
local Props = require(script.Parent:WaitForChild("Props"))

local MoonBuilder = {}

MoonBuilder.ORIGIN = Vector3.new(0, 0, -3200)
local SIZE = 420
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function deco(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = part(parent, size, cf, color, material, shape)
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	return p
end

local function emitter(parent: Instance, props: { [string]: any })
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
end

export type MoonInfo = {
	folder: Folder,
	spawn: SpawnLocation,
	reactor: BasePart,
	reactorRadius: number,
	vents: { Vector3 },
	roomCenters: { Vector3 },
	space: { Instance },
	armoryPrompt: ProximityPrompt,
}

function MoonBuilder.clear()
	local old = workspace:FindFirstChild("Io")
	if old then
		old:Destroy()
	end
	local M = MoonBuilder.ORIGIN
	workspace.Terrain:FillBlock(CFrame.new(M + Vector3.new(0, 20, 0)), Vector3.new(SIZE + 120, 200, SIZE + 120), Enum.Material.Air)
end

function MoonBuilder.build(): MoonInfo
	MoonBuilder.clear()
	local M = MoonBuilder.ORIGIN
	local T = workspace.Terrain
	local rng = Random.new(1610) -- Io was discovered in 1610

	T:SetMaterialColor(Enum.Material.Basalt, Color3.fromRGB(62, 50, 40))
	T:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(150, 108, 58))
	T:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(222, 196, 88)) -- sulfur
	T:SetMaterialColor(Enum.Material.Salt, Color3.fromRGB(238, 232, 196)) -- sulfur dioxide frost
	T:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(176, 92, 42))
	T:SetMaterialColor(Enum.Material.CrackedLava, Color3.fromRGB(70, 40, 30))

	local folder = Instance.new("Folder")
	folder.Name = "Io"
	folder.Parent = workspace

	-- base ground
	T:FillBlock(CFrame.new(M + Vector3.new(0, -12, 0)), Vector3.new(SIZE, 24, SIZE), Enum.Material.Basalt)
	-- rolling mounds
	local mats = { Enum.Material.Rock, Enum.Material.Sand, Enum.Material.Ground, Enum.Material.Basalt }
	for _ = 1, 70 do
		local r = rng:NextNumber(8, 28)
		local p = M + Vector3.new(rng:NextNumber(-190, 190), -r * rng:NextNumber(0.55, 0.85), rng:NextNumber(-190, 190))
		T:FillBall(p, r, mats[rng:NextInteger(1, #mats)])
	end
	-- sulfur / frost patches on the surface
	for _ = 1, 26 do
		local p = M + Vector3.new(rng:NextNumber(-190, 190), -0.6, rng:NextNumber(-190, 190))
		T:FillCylinder(CFrame.new(p), 2, rng:NextNumber(8, 22), if rng:NextNumber() < 0.6 then Enum.Material.Sand else Enum.Material.Salt)
	end
	-- impact craters with raised rims
	for _ = 1, 12 do
		local r = rng:NextNumber(10, 26)
		local c = M + Vector3.new(rng:NextNumber(-170, 170), 0, rng:NextNumber(-170, -40) * (if rng:NextNumber() < 0.5 then 1 else -1))
		T:FillBall(c + Vector3.new(0, r * 0.45, 0), r, Enum.Material.Air)
		for k = 1, 12 do
			local a = k / 12 * math.pi * 2
			T:FillBall(c + Vector3.new(math.cos(a) * r * 1.05, -1, math.sin(a) * r * 1.05), r * 0.3, Enum.Material.Rock)
		end
	end
	-- lava lakes
	for _ = 1, 3 do
		local c = M + Vector3.new(rng:NextNumber(-150, 150), 0, rng:NextNumber(-170, -80))
		local r = rng:NextNumber(10, 16)
		T:FillCylinder(CFrame.new(c + Vector3.new(0, 2, 0)), 8, r, Enum.Material.Air)
		T:FillCylinder(CFrame.new(c + Vector3.new(0, -2.5, 0)), 3, r, Enum.Material.CrackedLava)
		local glow = deco(folder, Vector3.new(0.2, r * 1.8, r * 1.8), CFrame.new(c + Vector3.new(0, -0.9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(255, 110, 30), Enum.Material.Neon, Enum.PartType.Cylinder)
		glow.Transparency = 0.35
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 120, 40)
		l.Range = 40
		l.Brightness = 2
		l.Parent = glow
	end
	-- the volcano (Loki-style), with a glowing crater and a smoke plume
	local V = M + Vector3.new(-120, 0, -150)
	for i = 0, 7 do
		T:FillCylinder(CFrame.new(V + Vector3.new(0, i * 6 + 3, 0)), 6, 62 - i * 7, Enum.Material.Basalt)
	end
	T:FillBall(V + Vector3.new(0, 52, 0), 12, Enum.Material.Air)
	T:FillCylinder(CFrame.new(V + Vector3.new(0, 42, 0)), 3, 9, Enum.Material.CrackedLava)
	local vent = deco(folder, Vector3.new(14, 1, 14), CFrame.new(V + Vector3.new(0, 44, 0)), Color3.fromRGB(255, 120, 30), Enum.Material.Neon)
	vent.Transparency = 0.2
	local vl = Instance.new("PointLight")
	vl.Color = Color3.fromRGB(255, 120, 40)
	vl.Range = 60
	vl.Brightness = 3
	vl.Parent = vent
	emitter(vent, { Texture = FIRE, Rate = 25, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(10, 20), SpreadAngle = Vector2.new(20, 20),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 1) }), LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 160, 60), Color3.fromRGB(255, 60, 20)), EmissionDirection = Enum.NormalId.Top })
	emitter(vent, { Texture = SMOKE, Rate = 10, Lifetime = NumberRange.new(8, 12), Speed = NumberRange.new(14, 22), SpreadAngle = Vector2.new(15, 15),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 10), NumberSequenceKeypoint.new(1, 40) }), RotSpeed = NumberRange.new(-20, 20),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(200, 180, 140)), EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(4, 2, 0) })

	-- flat landing zone (cleared last so nothing pokes through)
	local LZ = M + Vector3.new(0, 0, 40)
	T:FillCylinder(CFrame.new(LZ + Vector3.new(0, 20, 0)), 40, 62, Enum.Material.Air)
	T:FillCylinder(CFrame.new(LZ + Vector3.new(0, -2, 0)), 4, 62, Enum.Material.Basalt)
	T:FillCylinder(CFrame.new(LZ + Vector3.new(0, -0.4, 0)), 0.8, 30, Enum.Material.Ground)

	-- boulders + sulfur crystals
	for _ = 1, 55 do
		local p = M + Vector3.new(rng:NextNumber(-195, 195), 0, rng:NextNumber(-195, 195))
		if (p - LZ).Magnitude > 70 then
			local s = rng:NextNumber(2, 8)
			part(folder, Vector3.new(s, s * rng:NextNumber(0.5, 1), s * rng:NextNumber(0.7, 1.3)),
				CFrame.new(p + Vector3.new(0, s * 0.2, 0)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), rng:NextNumber(0, 1)),
				Color3.fromRGB(rng:NextInteger(70, 110), rng:NextInteger(55, 80), rng:NextInteger(40, 55)), Enum.Material.Basalt)
		end
	end
	for _ = 1, 30 do
		local p = M + Vector3.new(rng:NextNumber(-190, 190), 0, rng:NextNumber(-190, 190))
		if (p - LZ).Magnitude > 70 then
			for k = 1, 3 do
				deco(folder, Vector3.new(0.6, rng:NextNumber(1.5, 3.5), 0.6), CFrame.new(p + Vector3.new(k * 0.6, 0.8, 0)) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-25, 25))),
					Color3.fromRGB(240, 220, 90), Enum.Material.Glass)
			end
		end
	end

	-- the landed ship (USS KEPLER) --------------------------------------------------------------------
	local S = M + Vector3.new(0, 0, 82)
	local hullW = Color3.fromRGB(205, 208, 212)
	local hullD = Color3.fromRGB(70, 74, 82)
	part(folder, Vector3.new(44, 12, 22), CFrame.new(S + Vector3.new(0, 11, 0)), hullW, Enum.Material.Metal)
	part(folder, Vector3.new(44, 4, 16), CFrame.new(S + Vector3.new(0, 19, 0)), hullW, Enum.Material.Metal)
	local nose = Instance.new("WedgePart")
	nose.Anchored = true
	nose.Size = Vector3.new(22, 12, 14)
	nose.CFrame = CFrame.new(S + Vector3.new(29, 11, 0)) * CFrame.Angles(0, math.rad(-90), 0)
	nose.Color = hullW
	nose.Material = Enum.Material.Metal
	nose.Parent = folder
	deco(folder, Vector3.new(6, 2.5, 14), CFrame.new(S + Vector3.new(24, 15, 0)), Color3.fromRGB(120, 200, 255), Enum.Material.Neon).Transparency = 0.35
	for _, z in { -6, 6 } do
		local eng = part(folder, Vector3.new(10, 8, 8), CFrame.new(S + Vector3.new(-26, 11, z)) * CFrame.Angles(0, 0, 0), hullD, Enum.Material.Metal, Enum.PartType.Cylinder)
		eng.Size = Vector3.new(10, 8, 8)
		local glow = deco(folder, Vector3.new(0.5, 6.5, 6.5), CFrame.new(S + Vector3.new(-31.3, 11, z)), Color3.fromRGB(90, 200, 255), Enum.Material.Neon, Enum.PartType.Cylinder)
		local gl = Instance.new("PointLight")
		gl.Color = Color3.fromRGB(90, 200, 255)
		gl.Range = 20
		gl.Parent = glow
	end
	for _, x in { -16, 16 } do
		for _, z in { -12, 12 } do
			part(folder, Vector3.new(1.4, 6, 1.4), CFrame.new(S + Vector3.new(x, 3, z)) * CFrame.Angles(math.rad(z > 0 and 15 or -15), 0, 0), hullD, Enum.Material.Metal)
			part(folder, Vector3.new(4, 0.6, 4), CFrame.new(S + Vector3.new(x, 0.3, z + (z > 0 and 0.8 or -0.8))), hullD, Enum.Material.Metal)
		end
	end
	-- ramp down toward the defense area
	local ramp = part(folder, Vector3.new(10, 0.8, 16), CFrame.new(S + Vector3.new(0, 2.6, -17)) * CFrame.Angles(math.rad(-18), 0, 0), hullD, Enum.Material.DiamondPlate)
	ramp.Name = "Ramp"
	deco(folder, Vector3.new(0.3, 30, 0.3), CFrame.new(S + Vector3.new(-12, 36, 4)), hullD, Enum.Material.Metal)
	local beacon = deco(folder, Vector3.new(0.8, 0.8, 0.8), CFrame.new(S + Vector3.new(-12, 51.4, 4)), Color3.fromRGB(255, 40, 30), Enum.Material.Neon, Enum.PartType.Ball)
	local bl = Instance.new("PointLight")
	bl.Color = Color3.fromRGB(255, 40, 30)
	bl.Range = 25
	bl.Parent = beacon
	-- hull lettering
	local plate = deco(folder, Vector3.new(16, 3, 0.1), CFrame.new(S + Vector3.new(-6, 13, -11.06)) * CFrame.Angles(0, math.rad(180), 0), hullW)
	plate.Transparency = 1
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.CanvasSize = Vector2.new(480, 90)
	sg.Parent = plate
	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.fromScale(1, 1)
	txt.BackgroundTransparency = 1
	txt.Font = Enum.Font.GothamBlack
	txt.TextScaled = true
	txt.TextColor3 = Color3.fromRGB(40, 42, 48)
	txt.Text = "USS KEPLER  ·  K-2011"
	txt.Parent = sg

	-- field generator: what the Keis attack here ---------------------------------------------------------
	local G = M + Vector3.new(0, 0, 32)
	local gbase = part(folder, Vector3.new(3, 14, 14), CFrame.new(G + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), hullD, Enum.Material.Metal, Enum.PartType.Cylinder)
	gbase.Name = "GeneratorBase"
	local core = part(folder, Vector3.new(12, 6, 6), CFrame.new(G + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(90, 220, 255), Enum.Material.Neon, Enum.PartType.Cylinder)
	core.Name = "ReactorCore"
	local cl = Instance.new("PointLight")
	cl.Color = core.Color
	cl.Range = 45
	cl.Brightness = 3
	cl.Shadows = true
	cl.Parent = core
	for k, y in { 5, 9, 13 } do
		local ring = deco(folder, Vector3.new(0.8, 10 + k, 10 + k), CFrame.new(G + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), hullW, Enum.Material.Metal, Enum.PartType.Cylinder)
		ring.Name = "ReactorRing"
	end
	part(folder, Vector3.new(1, 10, 10), CFrame.new(G + Vector3.new(0, 15.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), hullD, Enum.Material.Metal, Enum.PartType.Cylinder)

	-- floodlights around the defense area
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = G + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34)
		part(folder, Vector3.new(0.8, 10, 0.8), CFrame.new(p + Vector3.new(0, 5, 0)), hullD, Enum.Material.Metal)
		local head = deco(folder, Vector3.new(2, 1.2, 1.2), CFrame.lookAt(p + Vector3.new(0, 10.5, 0), p + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)),
			Color3.fromRGB(255, 245, 220), Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Range = 60
		spot.Angle = 70
		spot.Brightness = 2.5
		spot.Shadows = true
		spot.Color = Color3.fromRGB(255, 240, 215)
		spot.Parent = head
	end

	-- armory bench next to the ramp
	local armoryPrompt = Props.armoryBench(folder, CFrame.new(S + Vector3.new(16, 0, -24)))

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Enabled = false
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 0.4, 8)
	spawn.CFrame = CFrame.new(S + Vector3.new(0, 0.2, -30))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = folder

	-- glowing fissures: where the Keis crawl out
	local vents = {}
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local d = rng:NextNumber(130, 175)
		local p = G + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
		T:FillBlock(CFrame.new(p + Vector3.new(0, 1, 0)) * CFrame.Angles(0, a, 0), Vector3.new(4, 6, 14), Enum.Material.Air)
		local crack = deco(folder, Vector3.new(2, 0.3, 12), CFrame.new(p + Vector3.new(0, -1.8, 0)) * CFrame.Angles(0, a, 0), Color3.fromRGB(255, 50, 30), Enum.Material.Neon)
		emitter(crack, { Texture = SMOKE, Rate = 3, Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(2, 4),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 8) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 140, 100)), EmissionDirection = Enum.NormalId.Top })
		local cl2 = Instance.new("PointLight")
		cl2.Color = Color3.fromRGB(255, 60, 30)
		cl2.Range = 18
		cl2.Brightness = 1.5
		cl2.Parent = crack
		table.insert(vents, p + Vector3.new(0, 6, 0))
	end

	local roomCenters = {}
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		table.insert(roomCenters, G + Vector3.new(math.cos(a) * 60, 3, math.sin(a) * 60))
	end

	-- keep everyone inside the map
	for _, w in { { Vector3.new(SIZE, 300, 2), Vector3.new(0, 150, SIZE / 2) }, { Vector3.new(SIZE, 300, 2), Vector3.new(0, 150, -SIZE / 2) },
		{ Vector3.new(2, 300, SIZE), Vector3.new(SIZE / 2, 150, 0) }, { Vector3.new(2, 300, SIZE), Vector3.new(-SIZE / 2, 150, 0) } } do
		local wall = part(folder, w[1], CFrame.new(M + w[2]), Color3.new(0, 0, 0))
		wall.Transparency = 1
		wall.CanQuery = false
	end

	-- sky: Jupiter hangs huge over the horizon
	local jc, jr = M + Vector3.new(420, 520, -1050), 620
	local space = {
		SpaceArt.jupiter(folder, jc, jr, M, 1),
		SpaceArt.stars(folder, M, 1700, 450, 9, jc, jr * 2.1),
	}

	return {
		folder = folder,
		spawn = spawn,
		reactor = core,
		reactorRadius = 8,
		vents = vents,
		roomCenters = roomCenters,
		space = space,
		armoryPrompt = armoryPrompt,
	}
end

return MoonBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">PerkSystem</string><ProtectedString name="Source"><![CDATA[--!strict
-- Server side of the perk cards: offers, picks, rerolls (cost 1 key), stacks per player for the current run.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Perks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Perks"))

local PerkSystem = {}

type Offer = { id: number, cards: { string }, rarity: string?, wave: number }
local stacks: { [Player]: { [string]: number } } = {}
local queues: { [Player]: { Offer } } = {}
local seq = 0
local rng = Random.new()
local remotes: Folder

PerkSystem.hooks = {
	onChanged = function(_player: Player) end, -- refresh health/speed/ammo after a pick
	spendKey = function(_player: Player): boolean
		return false
	end,
	onPicked = function(_player: Player, _perkId: string) end,
}

local function publish(player: Player)
	player:SetAttribute("Perks", Perks.encode(stacks[player] or {}))
end

local function send(player: Player)
	local q = queues[player]
	local offer = q and q[1]
	if offer then
		(remotes:FindFirstChild("PerkOffer") :: RemoteEvent):FireClient(player, offer.id, offer.cards, offer.rarity)
	end
end

function PerkSystem.get(player: Player, id: string): number
	local s = stacks[player]
	return if s then s[id] or 0 else 0
end

function PerkSystem.reset(player: Player)
	stacks[player] = {}
	queues[player] = {}
	publish(player)
	;(remotes:FindFirstChild("PerkOffer") :: RemoteEvent):FireClient(player, 0, {}, nil) -- closes any open picker
end

function PerkSystem.remove(player: Player)
	stacks[player] = nil
	queues[player] = nil
end

-- queue a pick-1-of-3 for this player. onlyRarity forces e.g. "Legendary" (boss reward).
function PerkSystem.offer(player: Player, wave: number, onlyRarity: string?)
	stacks[player] = stacks[player] or {}
	queues[player] = queues[player] or {}
	local luck = math.clamp(wave / 20, 0, 1)
	local cards = Perks.roll(rng, stacks[player], 3, luck, onlyRarity)
	if #cards == 0 then
		cards = Perks.roll(rng, stacks[player], 3, luck, nil)
	end
	if #cards == 0 then
		return -- everything maxed
	end
	seq += 1
	table.insert(queues[player], { id = seq, cards = cards, rarity = onlyRarity, wave = wave })
	if #queues[player] == 1 then
		send(player)
	end
end

local function pick(player: Player, offerId: any, index: any)
	local q = queues[player]
	local offer = q and q[1]
	if not offer or offer.id ~= offerId or type(index) ~= "number" then
		return
	end
	local id = offer.cards[math.clamp(math.floor(index), 1, #offer.cards)]
	table.remove(q, 1)
	stacks[player][id] = (stacks[player][id] or 0) + 1
	publish(player)
	PerkSystem.hooks.onChanged(player)
	PerkSystem.hooks.onPicked(player, id)
	send(player)
end

-- any offers still open when the next wave starts get a random pick
function PerkSystem.resolvePending(player: Player)
	local q = queues[player]
	while q and q[1] do
		pick(player, q[1].id, rng:NextInteger(1, #q[1].cards))
	end
end

function PerkSystem.init(remoteFolder: Folder)
	remotes = remoteFolder
	;(remotes:FindFirstChild("PickPerk") :: RemoteEvent).OnServerEvent:Connect(pick)
	;(remotes:FindFirstChild("RerollPerk") :: RemoteEvent).OnServerEvent:Connect(function(player, offerId)
		local q = queues[player]
		local offer = q and q[1]
		if not offer or offer.id ~= offerId then
			return
		end
		if not PerkSystem.hooks.spendKey(player) then
			return
		end
		local cards = Perks.roll(rng, stacks[player], 3, math.clamp(offer.wave / 20, 0, 1), offer.rarity)
		if #cards > 0 then
			offer.cards = cards
		end
		send(player)
	end)
end

return PerkSystem
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Permanent progress: level, XP, best wave, total Keis destroyed. Saved with DataStores.
-- In Studio, enable Game Settings → Security → "Enable Studio Access to API Services" to test saving.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local PlayerData = {}

export type Data = { Level: number, XP: number, BestWave: number, TotalKeis: number, Runs: number }

local store: DataStore? = nil
local bestWaveStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DATASTORE_NAME)
		bestWaveStore = DataStoreService:GetOrderedDataStore(Config.DATASTORE_NAME .. "_BestWave")
	end)
	if not ok then
		warn("[PlayerData] DataStores unavailable, progress won't save:", err)
	end
end

local cache: { [Player]: Data } = {}

local function defaults(): Data
	return { Level = 1, XP = 0, BestWave = 0, TotalKeis = 0, Runs = 0 }
end

local function publish(player: Player, data: Data)
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPNeeded", Config.xpForLevel(data.Level))
	player:SetAttribute("BestWave", data.BestWave)
	player:SetAttribute("Title", Config.titleFor(data.Level))
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Level") :: IntValue).Value = data.Level;
		(stats:FindFirstChild("Best Wave") :: IntValue).Value = data.BestWave
	end
end

function PlayerData.load(player: Player): Data
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Level", "Best Wave" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player

	local data = defaults()
	if store then
		local ok, saved = pcall(function()
			return (store :: DataStore):GetAsync("u" .. player.UserId)
		end)
		if ok and type(saved) == "table" then
			for k, v in saved do
				if (data :: any)[k] ~= nil and type(v) == "number" then
					(data :: any)[k] = v
				end
			end
		end
	end
	cache[player] = data
	publish(player, data)
	return data
end

function PlayerData.get(player: Player): Data?
	return cache[player]
end

-- returns the number of levels gained
function PlayerData.addXP(player: Player, amount: number): number
	local data = cache[player]
	if not data then
		return 0
	end
	data.XP += math.floor(amount)
	local gained = 0
	while data.XP >= Config.xpForLevel(data.Level) do
		data.XP -= Config.xpForLevel(data.Level)
		data.Level += 1
		gained += 1
	end
	publish(player, data)
	return gained
end

function PlayerData.addKill(player: Player)
	local data = cache[player]
	if data then
		data.TotalKeis += 1
	end
end

function PlayerData.recordWave(player: Player, wave: number)
	local data = cache[player]
	if data and wave > data.BestWave then
		data.BestWave = wave
		publish(player, data)
	end
end

function PlayerData.addRun(player: Player)
	local data = cache[player]
	if data then
		data.Runs += 1
	end
end

function PlayerData.save(player: Player)
	local data = cache[player]
	if not data or not store then
		return
	end
	pcall(function()
		(store :: DataStore):SetAsync("u" .. player.UserId, data)
	end)
	if bestWaveStore and data.BestWave > 0 then
		pcall(function()
			(bestWaveStore :: OrderedDataStore):SetAsync(tostring(player.UserId), data.BestWave)
		end)
	end
end

function PlayerData.release(player: Player)
	PlayerData.save(player)
	cache[player] = nil
end

local nameCache: { [number]: string } = {}
function PlayerData.fetchTop(count: number): { { name: string, wave: number } }
	local results = {}
	if not bestWaveStore then
		return results
	end
	local ok, pages = pcall(function()
		return (bestWaveStore :: OrderedDataStore):GetSortedAsync(false, count)
	end)
	if not ok then
		return results
	end
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(entry.key) or 0
		local name = nameCache[userId]
		if not name then
			local okName, n = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			name = if okName then n else "???"
			nameCache[userId] = name
		end
		table.insert(results, { name = name :: string, wave = entry.value })
	end
	return results
end

return PlayerData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[--!strict
-- Detailed set pieces. Right now: the Armory bench where players upgrade weapons and change attachments.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WeaponModel"))

local Props = {}

local DARK = Color3.fromRGB(52, 55, 62)
local STEEL = Color3.fromRGB(120, 124, 130)
local ORANGE = Color3.fromRGB(255, 138, 61)
local HAZARD = Color3.fromRGB(230, 180, 30)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = collide == true
	p.CanQuery = collide == true
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function displayWeapon(parent: Instance, weaponId: string, att: any, cf: CFrame)
	local holder = Instance.new("Model")
	holder.Name = "Display" .. weaponId
	holder.Parent = parent
	local built = WeaponModel.build(weaponId, att, holder, "Root")
	built.root.Anchored = true
	built.root.Transparency = 0
	built.root.CFrame = cf
	if built.spin then
		built.spin.Parent = nil -- displays don't spin
	end
end

-- cf: floor point at the front-center of the bench; the bench faces -Z (players stand at -Z)
function Props.armoryBench(parent: Instance, cf: CFrame): ProximityPrompt
	local m = Instance.new("Model")
	m.Name = "ArmoryBench"
	m.Parent = parent
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	-- floor marking
	for i = 0, 9 do
		part(m, Vector3.new(1, 0.05, 0.4), at(-4.5 + i, 0.03, -2.3) * CFrame.Angles(0, math.rad(45), 0), if i % 2 == 0 then HAZARD else Color3.fromRGB(20, 20, 20))
	end
	-- table
	local top = part(m, Vector3.new(9, 0.4, 3.4), at(0, 3.4, 0), DARK, Enum.Material.DiamondPlate, nil, true)
	top.Name = "BenchTop"
	part(m, Vector3.new(9.05, 0.12, 0.12), at(0, 3.55, -1.72), ORANGE, Enum.Material.Neon)
	for _, x in { -4.2, 4.2 } do
		for _, z in { -1.4, 1.4 } do
			part(m, Vector3.new(0.4, 3.2, 0.4), at(x, 1.6, z), STEEL, Enum.Material.Metal, nil, true)
		end
	end
	part(m, Vector3.new(8.6, 0.2, 3), at(0, 1, 0), STEEL, Enum.Material.Metal)
	-- stuff on the shelf
	part(m, Vector3.new(1.6, 0.9, 1.2), at(-2.8, 1.55, 0.2), Color3.fromRGB(88, 94, 60), Enum.Material.Metal)
	part(m, Vector3.new(1.2, 0.7, 1), at(-1.2, 1.45, 0.4), Color3.fromRGB(150, 40, 35), Enum.Material.Metal)
	for i = 0, 3 do
		part(m, Vector3.new(0.35, 0.6, 0.35), at(1.2 + i * 0.45, 1.4, -0.4), Color3.fromRGB(200, 160, 70), Enum.Material.Metal, Enum.PartType.Cylinder)
	end

	-- pegboard wall with tools
	part(m, Vector3.new(9, 6.4, 0.3), at(0, 6.8, 1.75), Color3.fromRGB(70, 74, 80), Enum.Material.Metal, nil, true)
	for row = 0, 4 do
		part(m, Vector3.new(8.8, 0.08, 0.05), at(0, 4.4 + row * 1.2, 1.58), Color3.fromRGB(40, 42, 46), Enum.Material.Metal)
	end
	-- wrench
	part(m, Vector3.new(0.2, 1.6, 0.08), at(3.4, 7.6, 1.55) * CFrame.Angles(0, 0, math.rad(10)), STEEL, Enum.Material.Metal)
	part(m, Vector3.new(0.55, 0.35, 0.08), at(3.27, 8.4, 1.55), STEEL, Enum.Material.Metal)
	-- screwdrivers
	for i = 0, 2 do
		part(m, Vector3.new(0.12, 0.9, 0.12), at(2.3 + i * 0.35, 7.2, 1.55), STEEL, Enum.Material.Metal)
		part(m, Vector3.new(0.2, 0.45, 0.2), at(2.3 + i * 0.35, 7.8, 1.55), if i == 1 then ORANGE else Color3.fromRGB(40, 90, 180))
	end
	-- spare scopes on a shelf
	part(m, Vector3.new(2.4, 0.12, 0.6), at(-3, 5.4, 1.35), STEEL, Enum.Material.Metal)
	for i = 0, 1 do
		part(m, Vector3.new(0.9, 0.3, 0.3), at(-3.6 + i * 1.1, 5.65, 1.35) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(20, 20, 22), Enum.Material.Metal, Enum.PartType.Cylinder)
	end
	-- a spare rifle hanging on the wall + one lying on the table
	displayWeapon(m, "Blaster", { Optic = "ACOG", Laser = "Red", Muzzle = "Compensator" }, at(-0.6, 8.3, 1.4) * CFrame.Angles(0, math.rad(90), 0))
	displayWeapon(m, "Blaster", { Optic = "RedDot", Laser = "None", Muzzle = "None" }, at(0.4, 4.0, -0.2) * CFrame.Angles(0, math.rad(80), math.rad(90)))
	-- vise
	part(m, Vector3.new(0.8, 0.6, 0.8), at(3.7, 3.9, -0.9), Color3.fromRGB(40, 90, 160), Enum.Material.Metal)
	part(m, Vector3.new(0.9, 0.3, 0.2), at(3.7, 4.3, -1.25), STEEL, Enum.Material.Metal)

	-- monitor
	part(m, Vector3.new(0.3, 1, 0.3), at(-3, 4.1, 0.7), DARK, Enum.Material.Metal)
	local screen = part(m, Vector3.new(2.6, 1.6, 0.15), at(-3, 5, 0.65) * CFrame.Angles(math.rad(-8), 0, 0), Color3.fromRGB(10, 14, 18))
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(260, 160)
	sg.LightInfluence = 0
	sg.Brightness = 1.6
	sg.Parent = screen
	for i, line in { "ARMORY // WEAPON SYSTEMS", "OPTICS ....... READY", "LASER MODULES  READY", "BARREL KITS .. READY", "> PRESS E TO MODIFY" } do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromOffset(10, 6 + (i - 1) * 30)
		l.Size = UDim2.new(1, -20, 0, 26)
		l.Font = Enum.Font.Code
		l.TextSize = 17
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = if i == 5 then ORANGE else Color3.fromRGB(110, 255, 160)
		l.Text = line
		l.Parent = sg
	end

	-- desk lamp shining on the table
	part(m, Vector3.new(0.5, 0.15, 0.5), at(2.2, 3.68, 0.9), DARK, Enum.Material.Metal)
	part(m, Vector3.new(0.12, 1.8, 0.12), at(2.2, 4.5, 0.9) * CFrame.Angles(math.rad(-20), 0, 0), DARK, Enum.Material.Metal)
	local lampHead = part(m, Vector3.new(0.7, 0.35, 0.5), at(2.2, 5.35, 0.45) * CFrame.Angles(math.rad(-50), 0, 0), Color3.fromRGB(255, 236, 200), Enum.Material.Neon)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Range = 10
	spot.Angle = 80
	spot.Brightness = 2
	spot.Shadows = true
	spot.Color = Color3.fromRGB(255, 236, 200)
	spot.Parent = lampHead

	-- sign
	local sign = part(m, Vector3.new(5, 1.2, 0.1), at(0, 10.4, 1.55), Color3.new(0, 0, 0))
	sign.Transparency = 1
	local sg2 = Instance.new("SurfaceGui")
	sg2.Face = Enum.NormalId.Front
	sg2.CanvasSize = Vector2.new(500, 120)
	sg2.LightInfluence = 0
	sg2.Brightness = 2
	sg2.Parent = sign
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = ORANGE
	t.Text = "ARMORY"
	t.Parent = sg2
	local signLight = Instance.new("PointLight")
	signLight.Color = ORANGE
	signLight.Range = 10
	signLight.Brightness = 1
	signLight.Parent = sign

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open Armory"
	prompt.ObjectText = "WEAPON BENCH"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = top
	return prompt
end

return Props
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">ShipBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Builds the ship (USS KEPLER), the space outside it, and Jupiter. Parts only, no assets.
--
--   Top view (X →, Z ↓). Jupiter is off to +X/+Z, so the bridge, medbay and observation deck face it.
--
--                 [Crew Qtrs]   [Engine]
--   [Cargo Bay]==[Corridor A]==[REACTOR]==[Corridor B]==[Bridge] (spawn)
--                               [Observ.]   [Medbay]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SpaceArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpaceArt"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Props = require(script.Parent:WaitForChild("Props"))
local Lighting = game:GetService("Lighting")

local ShipBuilder = {}

local H = 16 -- ceiling height
local DOOR_W, DOOR_H = 10, 11

local HULL = Color3.fromRGB(150, 154, 156)
local HULL_DARK = Color3.fromRGB(62, 66, 76)
local FLOOR = Color3.fromRGB(56, 58, 60)
local TRIM = Color3.fromRGB(255, 138, 61)
local GLASS = Color3.fromRGB(150, 200, 255)

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if name then
		p.Name = name
	end
	p.Parent = parent
	return p
end

local function deco(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, size, cf, color, material)
	p.CanCollide = false
	p.CanQuery = false -- decorations never block shots or the Keis' line of sight
	p.CastShadow = false
	return p
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number, tag: string?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	if tag then
		CollectionService:AddTag(parent, tag)
	end
	return l
end

type Hole = { side: string, offset: number, width: number, kind: string, bottom: number?, top: number? }
type RoomDef = { name: string, code: string, cam: string, center: Vector3, size: Vector2, holes: { Hole } }

local HAZARD_Y = Color3.fromRGB(230, 180, 30)
local PIPE = Color3.fromRGB(96, 92, 86)
local GRATE = Color3.fromRGB(24, 25, 28)
local RIB = Color3.fromRGB(120, 124, 128)
local STEEL_RING = Color3.fromRGB(150, 154, 160)

local function hazardPost(parent: Instance, size: Vector3, cf: CFrame)
	-- yellow/black striped post (stacked bands)
	local bands = math.max(2, math.floor(size.Y / 1.2))
	local h = size.Y / bands
	for i = 0, bands - 1 do
		deco(parent, Vector3.new(size.X, h, size.Z), cf * CFrame.new(0, -size.Y / 2 + h * (i + 0.5), 0),
			if i % 2 == 0 then HAZARD_Y else Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic)
	end
end

local function sectorLabel(parent: Instance, cf: CFrame, code: string)
	local board = deco(parent, Vector3.new(7, 4.5, 0.05), cf, Color3.new(0, 0, 0))
	board.Transparency = 1
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(350, 225)
	sg.LightInfluence = 1
	sg.Parent = board
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(225, 222, 210)
	l.TextTransparency = 0.15
	l.Text = code
	l.Parent = sg
end

-- a looping 3D sound if its id is set in Config.Sounds
local function sound3d(parent: Instance, id: string, volume: number, range: number, speed: number?)
	if id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = volume
	s.PlaybackSpeed = speed or 1
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 4
	s.RollOffMaxDistance = range
	s.Parent = parent
	s:Play()
end

-- Detail pass ----------------------------------------------------------------------------------------
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local doorKeys: { [string]: boolean } = {}

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- sliding double doors; clients animate them (Doors.client) when anyone gets close
local function slidingDoor(parent: Instance, center: Vector3, alongX: boolean, width: number, key: string)
	if doorKeys[key] then
		return
	end
	doorKeys[key] = true
	local along = if alongX then Vector3.xAxis else Vector3.zAxis
	for _, sideSign in { -1, 1 } do
		local leafCenter = center + along * sideSign * (width / 4)
		local leafSize = if alongX then Vector3.new(width / 2, DOOR_H, 0.5) else Vector3.new(0.5, DOOR_H, width / 2)
		local leaf = deco(parent, leafSize, CFrame.new(leafCenter), Color3.fromRGB(105, 110, 116), Enum.Material.DiamondPlate)
		local stripeSize = if alongX then Vector3.new(width / 2, 1, 0.6) else Vector3.new(0.6, 1, width / 2)
		local stripe = deco(parent, stripeSize, CFrame.new(leafCenter + Vector3.new(0, -DOOR_H / 2 + 2, 0)), HAZARD_Y, Enum.Material.SmoothPlastic)
		local winSize = if alongX then Vector3.new(0.9, 3, 0.6) else Vector3.new(0.6, 3, 0.9)
		local win = deco(parent, winSize, CFrame.new(leafCenter + Vector3.new(0, 1.5, 0) - along * sideSign * (width / 4 - 1.2)),
			Color3.fromRGB(120, 200, 255), Enum.Material.Neon)
		win.Transparency = 0.3
		for _, p in { leaf, stripe, win } do
			p:SetAttribute("ClosedCF", p.CFrame)
			p:SetAttribute("OpenOffset", along * sideSign * (width / 2 - 0.4))
			p:SetAttribute("DoorCenter", center)
			CollectionService:AddTag(p, "DoorLeaf")
		end
	end
end

local function freeSpots(def: RoomDef, side: string, length: number, margin: number): { number }
	local spots = {}
	local t = -length / 2 + margin
	while t <= length / 2 - margin do
		local ok = true
		for _, h in def.holes do
			if h.side == side and math.abs(t - h.offset) < h.width / 2 + margin then
				ok = false
			end
		end
		if ok then
			table.insert(spots, t)
		end
		t += 2
	end
	return spots
end

local SCREEN_LINES = {
	{ "REACTOR OUTPUT", "98.2%", "CORE TEMP 3412K", "COOLANT FLOW OK" },
	{ "NAV // JUPITER ORBIT", "ALT 71,492 KM", "VEL 42.1 KM/S", "DRIFT +0.003" },
	{ "LIFE SUPPORT", "O2 20.9%", "CO2 0.04%", "HULL PRESSURE OK" },
	{ "SENSOR SWEEP", "UNKNOWN SIGNAL", "SOURCE: VENTS", "PATTERN: K-E-I-S" },
	{ "COMMS // EARTH", "SIGNAL LOST", "LAST CONTACT", "07/14/2011 23:31" },
}
local SIGNS = { "DANGER\nHIGH VOLTAGE", "AUTHORIZED\nPERSONNEL ONLY", "CAUTION\nLOW GRAVITY AREA", "WARNING\nVENT ACCESS", "SECTOR\nSEALED" }

local function console(parent: Instance, cf: CFrame, rng: Random)
	-- cf: at floor, facing into the room (LookVector = into the room)
	part(parent, Vector3.new(3.4, 3, 1.4), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
	local screen = deco(parent, Vector3.new(3, 1.8, 0.15), cf * CFrame.new(0, 3.6, 0.15) * CFrame.Angles(math.rad(25), 0, 0),
		Color3.fromRGB(10, 18, 14), Enum.Material.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(300, 180)
	sg.LightInfluence = 0
	sg.Brightness = 1.6
	sg.Parent = screen
	local lines = SCREEN_LINES[rng:NextInteger(1, #SCREEN_LINES)]
	local color = if rng:NextNumber() < 0.5 then Color3.fromRGB(90, 255, 140) else Color3.fromRGB(255, 170, 70)
	for i, line in lines do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromOffset(12, 8 + (i - 1) * 32)
		l.Size = UDim2.new(1, -24, 0, 28)
		l.Font = Enum.Font.Code
		l.TextSize = 22
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = color
		l.Text = line
		l.Parent = sg
	end
	CollectionService:AddTag(screen, "ConsoleScreen")
	light(screen, color, 7, 0.5)
	-- button strip
	for i = -1, 1 do
		deco(parent, Vector3.new(0.35, 0.15, 0.35), cf * CFrame.new(i * 0.8, 3.05, -0.3),
			if i == 0 then Color3.fromRGB(255, 60, 50) else Color3.fromRGB(255, 200, 60), Enum.Material.Neon)
	end
end

local function sign(parent: Instance, cf: CFrame, text: string)
	local board = deco(parent, Vector3.new(4.2, 2.4, 0.1), cf, HAZARD_Y, Enum.Material.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(210, 120)
	sg.LightInfluence = 1
	sg.Parent = board
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(20, 20, 20)
	l.Text = text
	l.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = l
end

local function detailRoom(folder: Folder, def: RoomDef, rng: Random)
	local c, sx, sz = def.center, def.size.X, def.size.Y
	local alongX = sx >= sz
	local long, short = math.max(sx, sz), math.min(sx, sz)

	-- ceiling arches across the short axis, with corner braces
	local t = -long / 2 + 4
	while t < long / 2 - 2 do
		local pos = if alongX then c + Vector3.new(t, H - 0.6, 0) else c + Vector3.new(0, H - 0.6, t)
		local beam = if alongX then Vector3.new(1.2, 1.2, short - 2) else Vector3.new(short - 2, 1.2, 1.2)
		deco(folder, beam, CFrame.new(pos), RIB, Enum.Material.Metal)
		for _, sgn in { -1, 1 } do
			local off = if alongX then Vector3.new(0, -1.4, sgn * (short / 2 - 2)) else Vector3.new(sgn * (short / 2 - 2), -1.4, 0)
			local rot = if alongX then CFrame.Angles(sgn * math.rad(45), 0, 0) else CFrame.Angles(0, 0, -sgn * math.rad(45))
			deco(folder, Vector3.new(0.9, 3.4, 0.9), CFrame.new(pos + off) * rot, RIB, Enum.Material.Metal)
		end
		t += 8
	end

	-- cable bundles along the ceiling
	for _, off in { -short / 2 + 3, short / 2 - 3.6 } do
		for k = 0, 1 do
			local pos = if alongX then c + Vector3.new(0, H - 1.8 - k * 0.45, off + k * 0.5) else c + Vector3.new(off + k * 0.5, H - 1.8 - k * 0.45, 0)
			local cable = deco(folder, Vector3.new(long - 3, 0.35, 0.35), CFrame.new(pos) * (if alongX then CFrame.new() else CFrame.Angles(0, math.rad(90), 0)),
				if k == 0 then Color3.fromRGB(25, 25, 28) else Color3.fromRGB(150, 40, 35), Enum.Material.SmoothPlastic)
			cable.Shape = Enum.PartType.Cylinder
		end
	end

	-- consoles and signs on walls with free space
	local placedConsoles, placedSigns = 0, 0
	for _, side in { "N", "S", "E", "W" } do
		local sideAlongX = side == "N" or side == "S"
		local length = if sideAlongX then sx else sz
		local spots = freeSpots(def, side, length, 5)
		if #spots > 0 then
			local inward = if side == "N" then Vector3.new(0, 0, 1) elseif side == "S" then Vector3.new(0, 0, -1)
				elseif side == "E" then Vector3.new(-1, 0, 0) else Vector3.new(1, 0, 0)
			local fixed = if side == "N" then c.Z - sz / 2 elseif side == "S" then c.Z + sz / 2 elseif side == "E" then c.X + sx / 2 else c.X - sx / 2
			local function wallPoint(tt: number, y: number, depth: number): Vector3
				local base = if sideAlongX then Vector3.new(c.X + tt, c.Y + y, fixed) else Vector3.new(fixed, c.Y + y, c.Z + tt)
				return base + inward * depth
			end
			if placedConsoles < 2 and rng:NextNumber() < 0.75 then
				local tt = spots[rng:NextInteger(1, #spots)]
				local p = wallPoint(tt, 0, 2)
				console(folder, CFrame.lookAt(p, p + inward), rng)
				placedConsoles += 1
			end
			if placedSigns < 1 and rng:NextNumber() < 0.6 then
				local tt = spots[rng:NextInteger(1, #spots)]
				local p = wallPoint(tt, 7.5, 1.3)
				sign(folder, CFrame.lookAt(p, p + inward), SIGNS[rng:NextInteger(1, #SIGNS)])
				placedSigns += 1
			end
		end
	end

	-- steam leaking from the pipes
	for _ = 1, 2 do
		local side = if rng:NextNumber() < 0.5 then 1 else -1
		local tt = rng:NextNumber(-long / 2 + 4, long / 2 - 4)
		local pos = if alongX then c + Vector3.new(tt, H - 1, side * (short / 2 - 1.6)) else c + Vector3.new(side * (short / 2 - 1.6), H - 1, tt)
		local holder = deco(folder, Vector3.new(0.6, 0.6, 0.6), CFrame.new(pos), PIPE, Enum.Material.Metal)
		emitter(holder, {
			Texture = SMOKE, Rate = 4, Lifetime = NumberRange.new(2, 3.5), Speed = NumberRange.new(2, 4),
			SpreadAngle = Vector2.new(25, 25), EmissionDirection = Enum.NormalId.Bottom, RotSpeed = NumberRange.new(-30, 30),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 5) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(Color3.fromRGB(220, 225, 230)), LightInfluence = 0.8,
		})
		sound3d(holder, Config.Sounds.Steam, 0.5, 28, rng:NextNumber(0.9, 1.1))
	end

	-- a broken, sparking wall panel in some rooms
	if rng:NextNumber() < 0.45 then
		local side = if rng:NextNumber() < 0.5 then 1 else -1
		local tt = rng:NextNumber(-long / 2 + 5, long / 2 - 5)
		local pos = if alongX then c + Vector3.new(tt, 9, side * (short / 2 - 1.1)) else c + Vector3.new(side * (short / 2 - 1.1), 9, tt)
		local box = deco(folder, Vector3.new(1.6, 1.6, 1.6), CFrame.new(pos), Color3.fromRGB(40, 40, 44), Enum.Material.CorrodedMetal)
		emitter(box, {
			Texture = SPARK, Rate = 6, Lifetime = NumberRange.new(0.3, 0.7), Speed = NumberRange.new(8, 14),
			SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, -40, 0), LightEmission = 1,
			Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(Color3.fromRGB(255, 200, 90)),
		})
		sound3d(box, Config.Sounds.Sparks, 0.6, 30)
		local l = light(box, Color3.fromRGB(255, 170, 80), 12, 1.2)
		task.spawn(function()
			while box.Parent do
				l.Enabled = math.random() < 0.5
				task.wait(math.random() * 0.25)
			end
		end)
	end

	-- lockers in quarters and medbay
	if def.name == "Crew Quarters" or def.name == "Medbay" then
		-- quarters: against the south wall; medbay: against the north wall (both away from windows)
		local facing = if def.name == "Medbay" then 1 else -1
		local wallZ = if facing == 1 then c.Z - sz / 2 + 1.6 else c.Z + sz / 2 - 1.6
		for i = 0, 3 do
			local x = c.X + sx / 2 - 2.5 - i * 2.3
			part(folder, Vector3.new(2.2, 7, 1.8), CFrame.new(x, 3.5, wallZ), Color3.fromRGB(85, 95, 110), Enum.Material.Metal)
			for k = 0, 2 do
				deco(folder, Vector3.new(1.2, 0.12, 0.1), CFrame.new(x, 5.6 + k * 0.4, wallZ + facing * 0.92), Color3.fromRGB(30, 30, 35), Enum.Material.Metal)
			end
		end
	end
end

-- Greebles: the "stuff sticking out" pass --------------------------------------------------------------
local COPPER = Color3.fromRGB(170, 100, 60)
local VALVE_RED = Color3.fromRGB(180, 40, 35)

local function cyl(parent: Instance, len: number, d: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	-- cylinder along the CFrame's X axis
	local p = deco(parent, Vector3.new(len, d, d), cf, color, material or Enum.Material.Metal)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, d: number, pos: Vector3, color: Color3): Part
	local p = deco(parent, Vector3.one * d, CFrame.new(pos), color, Enum.Material.Metal)
	p.Shape = Enum.PartType.Ball
	return p
end

-- a pipe that sticks out of the wall, bends, and runs to the floor or ceiling, with flanges and a valve wheel
local function wallPipe(parent: Instance, base: Vector3, inward: Vector3, rng: Random)
	local color = if rng:NextNumber() < 0.5 then PIPE else COPPER
	local d = rng:NextNumber(0.6, 0.9)
	local out = rng:NextNumber(1.4, 2.2)
	local y = rng:NextNumber(4, 9)
	local start = base + Vector3.new(0, y, 0)
	local elbow = start + inward * out
	cyl(parent, out, d, CFrame.lookAt(start + inward * out / 2, elbow) * CFrame.Angles(0, math.rad(90), 0), color)
	cyl(parent, 0.25, d + 0.35, CFrame.lookAt(start + inward * 0.15, elbow) * CFrame.Angles(0, math.rad(90), 0), STEEL_RING)
	ball(parent, d * 1.15, elbow, color)
	local up = rng:NextNumber() < 0.5
	local endY = if up then H - 0.5 else 0
	local runLen = math.abs(endY - y)
	local mid = elbow + Vector3.new(0, (endY - y) / 2, 0)
	cyl(parent, runLen, d, CFrame.new(mid) * CFrame.Angles(0, 0, math.rad(90)), color)
	local k = 2
	while k < runLen - 0.5 do
		cyl(parent, 0.25, d + 0.3, CFrame.new(elbow + Vector3.new(0, (if up then 1 else -1) * k, 0)) * CFrame.Angles(0, 0, math.rad(90)), STEEL_RING)
		k += 3
	end
	-- valve wheel on the horizontal stub
	local vpos = start + inward * (out * 0.5) + Vector3.new(0, d / 2 + 0.45, 0)
	cyl(parent, 0.4, 0.15, CFrame.new(vpos - Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90)), STEEL_RING)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		deco(parent, Vector3.new(0.38, 0.1, 0.12), CFrame.new(vpos + Vector3.new(math.cos(a) * 0.45, 0, math.sin(a) * 0.45)) * CFrame.Angles(0, -a + math.pi / 2, 0),
			VALVE_RED, Enum.Material.Metal)
	end
	for i = 0, 1 do
		local a = i * math.pi / 2
		deco(parent, Vector3.new(0.9, 0.06, 0.08), CFrame.new(vpos) * CFrame.Angles(0, a, 0), VALVE_RED, Enum.Material.Metal)
	end
end

local function junctionBox(parent: Instance, base: Vector3, inward: Vector3, rng: Random)
	local pos = base + Vector3.new(0, 5.5, 0) + inward * 0.45
	local face = CFrame.lookAt(pos, pos + inward)
	part(parent, Vector3.new(2.2, 2.8, 0.9), face, Color3.fromRGB(90, 96, 104), Enum.Material.Metal)
	deco(parent, Vector3.new(1.9, 2.5, 0.08), face * CFrame.new(0, 0, -0.48), Color3.fromRGB(110, 116, 124), Enum.Material.Metal)
	deco(parent, Vector3.new(0.12, 0.5, 0.1), face * CFrame.new(0.75, 0, -0.55), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	deco(parent, Vector3.new(0.9, 0.5, 0.02), face * CFrame.new(-0.3, 0.8, -0.53), HAZARD_Y, Enum.Material.SmoothPlastic)
	for i = 0, 2 do
		local led = deco(parent, Vector3.new(0.14, 0.14, 0.06), face * CFrame.new(-0.6 + i * 0.3, -0.9, -0.54),
			if i == 0 then Color3.fromRGB(80, 255, 120) elseif i == 1 then Color3.fromRGB(255, 190, 40) else Color3.fromRGB(255, 50, 40), Enum.Material.Neon)
		led:SetAttribute("BlinkRate", rng:NextNumber(0.3, 2))
		CollectionService:AddTag(led, "BlinkLED")
	end
	-- conduit up to the ceiling
	local top = pos + Vector3.new(0, 1.4, 0)
	cyl(parent, H - top.Y, 0.35, CFrame.new(top + Vector3.new(0, (H - top.Y) / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(40, 42, 46))
end

local function gauges(parent: Instance, base: Vector3, inward: Vector3, rng: Random)
	local pos = base + Vector3.new(0, 6, 0) + inward * 0.9
	local along = inward:Cross(Vector3.yAxis)
	cyl(parent, 3.2, 0.5, CFrame.lookAt(pos, pos + along) * CFrame.Angles(0, math.rad(90), 0), PIPE)
	for i = -1, 1 do
		local gp = pos + along * i * 1.1 + Vector3.new(0, 0.75, 0)
		cyl(parent, 0.5, 0.25, CFrame.new(gp - Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), STEEL_RING)
		local dial = cyl(parent, 0.2, 0.9, CFrame.lookAt(gp, gp + inward) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(40, 40, 44))
		local face = deco(parent, Vector3.new(0.75, 0.75, 0.02), CFrame.lookAt(gp + inward * 0.11, gp + inward * 2), Color3.new(1, 1, 1))
		face.Transparency = 1
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.CanvasSize = Vector2.new(100, 100)
		sg.LightInfluence = 0.6
		sg.Parent = face
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(235, 232, 220)
		bg.Parent = sg
		Instance.new("UICorner", bg).CornerRadius = UDim.new(0.5, 0)
		local red = Instance.new("Frame")
		red.AnchorPoint = Vector2.new(0.5, 0.5)
		red.Position = UDim2.fromScale(0.78, 0.3)
		red.Size = UDim2.fromScale(0.18, 0.18)
		red.BackgroundColor3 = Color3.fromRGB(220, 50, 40)
		red.Parent = bg
		Instance.new("UICorner", red).CornerRadius = UDim.new(0.5, 0)
		local needle = Instance.new("Frame")
		needle.Name = "Needle"
		needle.AnchorPoint = Vector2.new(0.5, 1)
		needle.Position = UDim2.fromScale(0.5, 0.5)
		needle.Size = UDim2.fromScale(0.05, 0.42)
		needle.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		needle.BorderSizePixel = 0
		needle.Rotation = rng:NextNumber(-60, 60)
		needle.Parent = bg
		CollectionService:AddTag(face, "Gauge")
		local _ = dial
	end
end

local function wallFan(parent: Instance, base: Vector3, inward: Vector3)
	local pos = base + Vector3.new(0, 11.5, 0) + inward * 0.6
	local face = CFrame.lookAt(pos, pos + inward)
	for _, o in { { 0, 1.5, 3.4, 0.3 }, { 0, -1.5, 3.4, 0.3 }, { 1.55, 0, 0.3, 3.4 }, { -1.55, 0, 0.3, 3.4 } } do
		deco(parent, Vector3.new(o[3], o[4], 0.5), face * CFrame.new(o[1], o[2], 0), STEEL_RING, Enum.Material.Metal)
	end
	deco(parent, Vector3.new(3, 3, 0.1), face * CFrame.new(0, 0, 0.2), Color3.fromRGB(15, 15, 18), Enum.Material.SmoothPlastic)
	local fan = Instance.new("Model")
	fan.Name = "Fan"
	fan.Parent = parent
	local hub = cyl(fan, 0.3, 0.6, face * CFrame.new(0, 0, -0.05) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(60, 62, 68))
	fan.PrimaryPart = hub
	for i = 0, 3 do
		deco(fan, Vector3.new(0.5, 1.3, 0.06), face * CFrame.Angles(0, 0, i * math.pi / 2) * CFrame.new(0, 0.75, -0.05) * CFrame.Angles(0, math.rad(20), 0),
			Color3.fromRGB(80, 84, 90), Enum.Material.Metal)
	end
	CollectionService:AddTag(fan, "Fan")
	-- grille bars in front
	for i = -2, 2 do
		deco(parent, Vector3.new(0.06, 3, 0.06), face * CFrame.new(i * 0.6, 0, -0.3), STEEL_RING, Enum.Material.Metal)
	end
end

-- a bundle of wires sagging across the ceiling
local function sagWire(parent: Instance, a: Vector3, b: Vector3, sag: number, color: Color3, thickness: number)
	local segs = 8
	local prev = a
	for i = 1, segs do
		local t = i / segs
		local p = a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
		local len = (p - prev).Magnitude
		cyl(parent, len + 0.05, thickness, CFrame.lookAt((prev + p) / 2, p) * CFrame.Angles(0, math.rad(90), 0), color, Enum.Material.SmoothPlastic)
		prev = p
	end
end

local function greebleRoom(folder: Folder, def: RoomDef, rng: Random)
	local c, sx, sz = def.center, def.size.X, def.size.Y
	local alongX = sx >= sz
	local long, short = math.max(sx, sz), math.min(sx, sz)
	local placed = 0
	for _, side in { "N", "S", "E", "W" } do
		local sideAlongX = side == "N" or side == "S"
		local length = if sideAlongX then sx else sz
		local spots = freeSpots(def, side, length, 4)
		local inward = if side == "N" then Vector3.new(0, 0, 1) elseif side == "S" then Vector3.new(0, 0, -1)
			elseif side == "E" then Vector3.new(-1, 0, 0) else Vector3.new(1, 0, 0)
		local fixed = if side == "N" then c.Z - sz / 2 + 1 elseif side == "S" then c.Z + sz / 2 - 1 elseif side == "E" then c.X + sx / 2 - 1 else c.X - sx / 2 + 1
		local used: { number } = {}
		for _ = 1, 3 do
			if #spots == 0 or placed >= 7 then
				break
			end
			local t = spots[rng:NextInteger(1, #spots)]
			local clash = false
			for _, u in used do
				if math.abs(u - t) < 4 then
					clash = true
				end
			end
			if not clash then
				table.insert(used, t)
				placed += 1
				local base = if sideAlongX then Vector3.new(c.X + t, c.Y, fixed) else Vector3.new(fixed, c.Y, c.Z + t)
				local roll = rng:NextNumber()
				if roll < 0.4 then
					wallPipe(folder, base, inward, rng)
				elseif roll < 0.65 then
					junctionBox(folder, base, inward, rng)
				elseif roll < 0.85 then
					gauges(folder, base, inward, rng)
				else
					wallFan(folder, base, inward)
				end
			end
		end
	end

	-- wires sagging across the ceiling (short axis)
	for i = 1, 2 do
		local t = rng:NextNumber(-long / 2 + 3, long / 2 - 3)
		local a = if alongX then c + Vector3.new(t, H - 1.2, -short / 2 + 1.5) else c + Vector3.new(-short / 2 + 1.5, H - 1.2, t)
		local b = if alongX then c + Vector3.new(t + rng:NextNumber(-3, 3), H - 1.2, short / 2 - 1.5) else c + Vector3.new(short / 2 - 1.5, H - 1.2, t + rng:NextNumber(-3, 3))
		local colors = { Color3.fromRGB(20, 20, 22), Color3.fromRGB(160, 40, 35), Color3.fromRGB(220, 180, 40), Color3.fromRGB(40, 80, 160) }
		for k = 0, 2 do
			sagWire(folder, a + Vector3.new(0, -k * 0.2, k * 0.15), b + Vector3.new(0, -k * 0.2, k * 0.15), rng:NextNumber(1.2, 2.8) + k * 0.2,
				colors[((i + k) % #colors) + 1], 0.16)
		end
	end

	-- floor conduit along one long wall + cable tray along the ceiling
	local side = if rng:NextNumber() < 0.5 then 1 else -1
	local conduitPos = if alongX then c + Vector3.new(0, 0.35, side * (short / 2 - 1.5)) else c + Vector3.new(side * (short / 2 - 1.5), 0.35, 0)
	local csize = if alongX then Vector3.new(long - 6, 0.7, 0.8) else Vector3.new(0.8, 0.7, long - 6)
	deco(folder, csize, CFrame.new(conduitPos), Color3.fromRGB(60, 64, 70), Enum.Material.Metal)
	local trayPos = if alongX then c + Vector3.new(0, H - 2.6, -side * (short / 2 - 3)) else c + Vector3.new(-side * (short / 2 - 3), H - 2.6, 0)
	local tsize = if alongX then Vector3.new(long - 4, 0.15, 1.6) else Vector3.new(1.6, 0.15, long - 4)
	deco(folder, tsize, CFrame.new(trayPos), Color3.fromRGB(90, 94, 100), Enum.Material.DiamondPlate)
	for k = 0, 3 do
		local off = Vector3.new(0, 0.15, -0.5 + k * 0.33)
		local cable = deco(folder, if alongX then Vector3.new(long - 4.5, 0.22, 0.22) else Vector3.new(0.22, 0.22, long - 4.5),
			CFrame.new(trayPos + (if alongX then off else Vector3.new(off.Z, off.Y, 0))),
			if k % 2 == 0 then Color3.fromRGB(25, 25, 28) else Color3.fromRGB(150, 40, 35), Enum.Material.SmoothPlastic)
		local _ = cable
	end
end

local function buildRoom(parent: Instance, def: RoomDef): Folder
	local folder = Instance.new("Folder")
	folder.Name = def.name
	folder:SetAttribute("Center", def.center)
	folder:SetAttribute("Size", def.size)
	folder:SetAttribute("Cam", def.cam)
	folder.Parent = parent
	local c, sx, sz = def.center, def.size.X, def.size.Y

	part(folder, Vector3.new(sx, 1, sz), CFrame.new(c + Vector3.new(0, -0.5, 0)), FLOOR, Enum.Material.DiamondPlate, "Floor")
	part(folder, Vector3.new(sx, 1, sz), CFrame.new(c + Vector3.new(0, H + 0.5, 0)), HULL_DARK, Enum.Material.Metal, "Ceiling")

	-- floor grate strip down the long axis (dark slats, like the corridor in the footage)
	local alongXFloor = sx >= sz
	local runLen = (if alongXFloor then sx else sz) - 4
	local slats = math.floor(runLen / 1.3)
	for i = 0, slats - 1 do
		local t = -runLen / 2 + (i + 0.5) * (runLen / slats)
		local size = if alongXFloor then Vector3.new(0.8, 0.06, 6) else Vector3.new(6, 0.06, 0.8)
		local pos = if alongXFloor then c + Vector3.new(t, 0.03, 0) else c + Vector3.new(0, 0.03, t)
		deco(folder, size, CFrame.new(pos), GRATE, Enum.Material.Metal)
	end
	for _, edge in { -3.4, 3.4 } do
		local size = if alongXFloor then Vector3.new(runLen, 0.08, 0.4) else Vector3.new(0.4, 0.08, runLen)
		local pos = if alongXFloor then c + Vector3.new(0, 0.04, edge) else c + Vector3.new(edge, 0.04, 0)
		deco(folder, size, CFrame.new(pos), HAZARD_Y, Enum.Material.SmoothPlastic)
	end

	local labelPlaced = false
	for _, side in { "N", "S", "E", "W" } do
		local alongX = side == "N" or side == "S"
		local length = if alongX then sx else sz
		local fixed = if side == "N" then c.Z - sz / 2 + 0.5
			elseif side == "S" then c.Z + sz / 2 - 0.5
			elseif side == "E" then c.X + sx / 2 - 0.5
			else c.X - sx / 2 + 0.5
		local inward = if side == "N" then Vector3.new(0, 0, 1) elseif side == "S" then Vector3.new(0, 0, -1)
			elseif side == "E" then Vector3.new(-1, 0, 0) else Vector3.new(1, 0, 0)

		local function at(t: number, y: number, depth: number): Vector3
			local base = if alongX then Vector3.new(c.X + t, c.Y + y, fixed) else Vector3.new(fixed, c.Y + y, c.Z + t)
			return base + inward * depth
		end
		local function slab(a: number, b: number, y0: number, y1: number, color: Color3, material: Enum.Material, transparency: number?)
			if b - a < 0.05 or y1 - y0 < 0.05 then
				return
			end
			local len, hgt = b - a, y1 - y0
			local size = if alongX then Vector3.new(len, hgt, 1) else Vector3.new(1, hgt, len)
			local p = part(folder, size, CFrame.new(at((a + b) / 2, y0 + hgt / 2, 0)), color, material)
			if transparency then
				p.Transparency = transparency
				p.CastShadow = false
				p.Name = "Window"
			end
		end
		local function rib(t: number, height: number, color: Color3)
			local size = if alongX then Vector3.new(0.9, height, 0.7) else Vector3.new(0.7, height, 0.9)
			deco(folder, size, CFrame.new(at(t, height / 2, 0.75)), color, Enum.Material.Metal)
		end

		local holes = {}
		for _, h in def.holes do
			if h.side == side then
				local bottom = h.bottom or (if h.kind == "door" then 0 else 3)
				local top = h.top or (if h.kind == "door" then DOOR_H else 13)
				table.insert(holes, { a = h.offset - h.width / 2, b = h.offset + h.width / 2, bottom = bottom, top = top, kind = h.kind })
			end
		end
		table.sort(holes, function(x, y)
			return x.a < y.a
		end)

		local cursor = -length / 2
		for _, h in holes do
			slab(cursor, h.a, 0, H, HULL, Enum.Material.Metal)
			slab(h.a, h.b, 0, h.bottom, HULL, Enum.Material.Metal)
			slab(h.a, h.b, h.top, H, HULL, Enum.Material.Metal)
			if h.kind == "window" then
				slab(h.a, h.b, h.bottom, h.top, GLASS, Enum.Material.Glass, 0.8)
				-- heavy window frame
				for _, t in { h.a, h.b } do
					rib(t, H, RIB)
				end
				local sill = if alongX then Vector3.new(h.b - h.a, 0.6, 1.2) else Vector3.new(1.2, 0.6, h.b - h.a)
				deco(folder, sill, CFrame.new(at((h.a + h.b) / 2, h.bottom - 0.3, 0.6)), RIB, Enum.Material.Metal)
				deco(folder, sill, CFrame.new(at((h.a + h.b) / 2, h.top + 0.3, 0.6)), RIB, Enum.Material.Metal)
			else
				-- door frame with hazard stripes + a lit header
				for _, t in { h.a - 0.45, h.b + 0.45 } do
					local size = if alongX then Vector3.new(0.9, h.top, 1.4) else Vector3.new(1.4, h.top, 0.9)
					hazardPost(folder, size, CFrame.new(at(t, h.top / 2, 0.7)))
				end
				local header = if alongX then Vector3.new(h.b - h.a + 1.8, 0.8, 1.4) else Vector3.new(1.4, 0.8, h.b - h.a + 1.8)
				deco(folder, header, CFrame.new(at((h.a + h.b) / 2, h.top + 0.4, 0.7)), RIB, Enum.Material.Metal)
				local boundary = if side == "N" then c.Z - sz / 2 elseif side == "S" then c.Z + sz / 2 elseif side == "E" then c.X + sx / 2 else c.X - sx / 2
				local doorCenter = at((h.a + h.b) / 2, DOOR_H / 2, 0)
				local along = if alongX then doorCenter.X else doorCenter.Z
				slidingDoor(folder, doorCenter, alongX, h.b - h.a, string.format("%s|%.1f|%.1f", if alongX then "x" else "z", boundary, along))
				local lamp = if alongX then Vector3.new(2, 0.3, 0.2) else Vector3.new(0.2, 0.3, 2)
				local l = deco(folder, lamp, CFrame.new(at((h.a + h.b) / 2, h.top + 0.4, 1.45)), Color3.fromRGB(255, 70, 50), Enum.Material.Neon)
				light(l, Color3.fromRGB(255, 80, 60), 8, 0.6)
			end
			cursor = h.b
		end
		slab(cursor, length / 2, 0, H, HULL, Enum.Material.Metal)

		-- ribs every ~8 studs where the wall is solid, plus darker inset panels
		local t = -length / 2 + 4
		while t < length / 2 - 3 do
			local blocked = false
			for _, h in holes do
				if t > h.a - 1.5 and t < h.b + 1.5 then
					blocked = true
				end
			end
			local panelBlocked = t + 4 > length / 2 - 3
			for _, h in holes do
				if t + 4 > h.a - 3.5 and t + 4 < h.b + 3.5 then
					panelBlocked = true
				end
			end
			if not blocked then
				rib(t, H, RIB)
			end
			if not panelBlocked then
				local panel = if alongX then Vector3.new(5.5, 7, 0.15) else Vector3.new(0.15, 7, 5.5)
				deco(folder, panel, CFrame.new(at(t + 4, 6, 0.55)), Color3.fromRGB(128, 132, 136), Enum.Material.Metal)
			end
			t += 8
		end

		-- pipes along the top of every wall
		local pipeSize = Vector3.new(length - 2, 1, 1)
		local pipeCf = CFrame.new(at(0, H - 1, 1.1)) * (if alongX then CFrame.new() else CFrame.Angles(0, math.rad(90), 0))
		local pipe = deco(folder, pipeSize, pipeCf, PIPE, Enum.Material.Metal)
		pipe.Shape = Enum.PartType.Cylinder
		local pipe2 = deco(folder, Vector3.new(length - 2, 0.6, 0.6), pipeCf * CFrame.new(0, -1.1, 0), Color3.fromRGB(150, 70, 40), Enum.Material.Metal)
		pipe2.Shape = Enum.PartType.Cylinder

		-- sector label on the first wall with free space at its end
		if not labelPlaced then
			local freeFrom = -length / 2
			for _, h in holes do
				freeFrom = math.max(freeFrom, h.b)
			end
			if length / 2 - freeFrom >= 9 then
				labelPlaced = true
				local pos = at(length / 2 - 5, 8.5, 0.56)
				sectorLabel(folder, CFrame.lookAt(pos, pos + inward), def.code)
			end
		end
	end

	-- fluorescent tubes on a grid
	local stepX = math.max(1, math.floor(sx / 14))
	local stepZ = math.max(1, math.floor(sz / 14))
	for i = 1, stepX do
		for j = 1, stepZ do
			local px = c.X - sx / 2 + (i - 0.5) * sx / stepX
			local pz = c.Z - sz / 2 + (j - 0.5) * sz / stepZ
			deco(folder, Vector3.new(7, 0.5, 1.4), CFrame.new(px, c.Y + H - 0.25, pz), HULL_DARK, Enum.Material.Metal)
			local tube = deco(folder, Vector3.new(6, 0.25, 0.5), CFrame.new(px, c.Y + H - 0.55, pz), Color3.fromRGB(215, 235, 255), Enum.Material.Neon)
			light(tube, Color3.fromRGB(200, 222, 255), 26, 1.1, "ShipLight").Shadows = true
		end
	end

	-- red alarm beacon (on during waves)
	local alarm = deco(folder, Vector3.new(1.4, 0.6, 1.4), CFrame.new(c + Vector3.new(0, H - 0.3, 0)), Color3.fromRGB(90, 20, 20), Enum.Material.SmoothPlastic)
	local al = light(alarm, Color3.fromRGB(255, 40, 30), 40, 0, "AlarmLight")
	al.Enabled = false

	return folder
end

export type ShipInfo = {
	folder: Folder,
	spawn: SpawnLocation,
	reactor: BasePart,
	reactorRadius: number,
	vents: { Vector3 },
	roomCenters: { Vector3 },
	leaderboard: Frame,
	space: { Instance },
	armoryPrompt: ProximityPrompt,
}

function ShipBuilder.build(): ShipInfo
	local old = workspace:FindFirstChild("Ship")
	if old then
		old:Destroy()
	end
	local ship = Instance.new("Folder")
	ship.Name = "Ship"
	ship.Parent = workspace

	local rooms: { RoomDef } = {
		{ name = "Bridge", code = "A-1", cam = "CAM 01 (BRIDGE)", center = Vector3.new(85, 0, 0), size = Vector2.new(40, 44), holes = {
			{ side = "W", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "E", offset = 0, width = 36, kind = "window", bottom = 2.5, top = 14 },
			{ side = "S", offset = 0, width = 26, kind = "window" },
			{ side = "N", offset = 0, width = 26, kind = "window" },
		} },
		{ name = "Corridor B", code = "C-3", cam = "CAM 04 (CORRIDOR)", center = Vector3.new(45, 0, 0), size = Vector2.new(40, 14), holes = {
			{ side = "E", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "W", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "S", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "N", offset = -10, width = 12, kind = "window" },
			{ side = "N", offset = 10, width = 12, kind = "window" },
		} },
		{ name = "Medbay", code = "M-2", cam = "CAM 05 (MEDBAY)", center = Vector3.new(45, 0, 24), size = Vector2.new(34, 34), holes = {
			{ side = "N", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "S", offset = 0, width = 26, kind = "window" },
			{ side = "E", offset = 0, width = 20, kind = "window" },
		} },
		{ name = "Reactor", code = "R-0", cam = "CAM 02 (REACTOR)", center = Vector3.new(0, 0, 0), size = Vector2.new(50, 50), holes = {
			{ side = "E", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "W", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "N", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "S", offset = 0, width = DOOR_W, kind = "door" },
		} },
		{ name = "Observation Deck", code = "O-6", cam = "CAM 07 (OBSERVATION)", center = Vector3.new(0, 0, 45), size = Vector2.new(40, 40), holes = {
			{ side = "N", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "S", offset = 0, width = 36, kind = "window", bottom = 1.5, top = 14.5 },
			{ side = "E", offset = 0, width = 30, kind = "window" },
			{ side = "W", offset = 0, width = 30, kind = "window" },
		} },
		{ name = "Engine Room", code = "E-5", cam = "CAM 06 (ENGINES)", center = Vector3.new(0, 0, -45), size = Vector2.new(40, 40), holes = {
			{ side = "S", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "N", offset = 0, width = 20, kind = "window" },
		} },
		{ name = "Corridor A", code = "C-2", cam = "CAM 03 (CORRIDOR)", center = Vector3.new(-45, 0, 0), size = Vector2.new(40, 14), holes = {
			{ side = "E", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "W", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "N", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "S", offset = -10, width = 12, kind = "window" },
			{ side = "S", offset = 10, width = 12, kind = "window" },
		} },
		{ name = "Crew Quarters", code = "Q-4", cam = "CAM 08 (QUARTERS)", center = Vector3.new(-45, 0, -24), size = Vector2.new(34, 34), holes = {
			{ side = "S", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "N", offset = 0, width = 22, kind = "window" },
		} },
		{ name = "Cargo Bay", code = "K-9", cam = "CAM 09 (CARGO BAY)", center = Vector3.new(-90, 0, 0), size = Vector2.new(50, 50), holes = {
			{ side = "E", offset = 0, width = DOOR_W, kind = "door" },
			{ side = "W", offset = 0, width = 30, kind = "window" },
			{ side = "S", offset = 0, width = 24, kind = "window" },
		} },
	}

	local roomCenters = {}
	local folders: { [string]: Folder } = {}
	local detailRng = Random.new(2011)
	for _, def in rooms do
		folders[def.name] = buildRoom(ship, def)
		detailRoom(folders[def.name], def, detailRng)
		greebleRoom(folders[def.name], def, detailRng)
		table.insert(roomCenters, def.center)
	end

	-- Reactor core -------------------------------------------------------------------------
	local rf = folders["Reactor"]
	local base = part(rf, Vector3.new(3, 14, 14), CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)), HULL_DARK, Enum.Material.Metal)
	base.Shape = Enum.PartType.Cylinder
	local core = part(rf, Vector3.new(12, 6, 6), CFrame.new(0, 9, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(90, 220, 255), Enum.Material.Neon, "ReactorCore")
	core.Shape = Enum.PartType.Cylinder
	light(core, Color3.fromRGB(90, 220, 255), 40, 2.5)
	sound3d(core, Config.Sounds.ReactorHum, 0.8, 60)
	for k, y in { 5, 9, 13 } do
		local ring = deco(rf, Vector3.new(0.8, 10 + k, 10 + k), CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)), HULL, Enum.Material.Metal)
		ring.Shape = Enum.PartType.Cylinder
		ring.Name = "ReactorRing"
		ring.Transparency = 0.1
	end
	local cap = part(rf, Vector3.new(1, 10, 10), CFrame.new(0, H - 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)), HULL_DARK, Enum.Material.Metal)
	cap.Shape = Enum.PartType.Cylinder

	-- Bridge: consoles + captain's chair + leaderboard ------------------------------------------
	local bf = folders["Bridge"]
	for _, z in { -12, -4, 4, 12 } do
		part(bf, Vector3.new(3, 3.5, 6), CFrame.new(98, 1.75, z), HULL_DARK, Enum.Material.Metal)
		deco(bf, Vector3.new(0.2, 2.5, 5), CFrame.new(96.4, 3.6, z) * CFrame.Angles(0, 0, math.rad(-20)), Color3.fromRGB(255, 160, 80), Enum.Material.Neon)
	end
	part(bf, Vector3.new(3, 1, 3), CFrame.new(84, 1.5, 0), HULL_DARK, Enum.Material.Metal)
	part(bf, Vector3.new(0.6, 4, 3), CFrame.new(82.8, 3.5, 0), Color3.fromRGB(150, 40, 30), Enum.Material.Fabric)

	local board = part(bf, Vector3.new(0.5, 9, 14), CFrame.new(67.3, 7, -14), Color3.fromRGB(10, 10, 14), Enum.Material.SmoothPlastic, "Leaderboard")
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Right
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Parent = board
	local boardFrame = Instance.new("Frame")
	boardFrame.Size = UDim2.fromScale(1, 1)
	boardFrame.BackgroundColor3 = Color3.fromRGB(14, 11, 18)
	boardFrame.Parent = sg

	local armoryPrompt = Props.armoryBench(bf, CFrame.new(79, 0, 12.5))

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(76, 0.2, 0)
	spawn.Color = TRIM
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.6
	spawn.Parent = bf

	-- Props -----------------------------------------------------------------------------------
	local cf = folders["Cargo Bay"]
	local rng = Random.new(14)
	for _ = 1, 10 do
		local s = rng:NextInteger(4, 7)
		part(cf, Vector3.new(s, s, s), CFrame.new(-90 + rng:NextNumber(-18, 18), s / 2, rng:NextNumber(-18, 18)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0),
			Color3.fromRGB(150, 110, 60), Enum.Material.WoodPlanks)
	end
	local mf = folders["Medbay"]
	for _, x in { 33, 57 } do
		for _, z in { 18, 32 } do
			part(mf, Vector3.new(4, 2, 7), CFrame.new(x, 1, z), Color3.fromRGB(230, 235, 240), Enum.Material.SmoothPlastic)
		end
	end
	local ef = folders["Engine Room"]
	for _, x in { -10, 10 } do
		local eng = part(ef, Vector3.new(14, 7, 7), CFrame.new(x, 7, -52) * CFrame.Angles(0, 0, math.rad(90)), HULL_DARK, Enum.Material.Metal)
		eng.Shape = Enum.PartType.Cylinder
		local glowRing = deco(ef, Vector3.new(1, 7.6, 7.6), CFrame.new(x, 10, -52) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 120, 50), Enum.Material.Neon)
		glowRing.Shape = Enum.PartType.Cylinder
		sound3d(eng, Config.Sounds.EngineRumble, 0.9, 50)
	end
	local of = folders["Observation Deck"]
	for _, x in { -10, 0, 10 } do
		part(of, Vector3.new(6, 1.5, 2), CFrame.new(x, 0.75, 52), Color3.fromRGB(150, 40, 30), Enum.Material.Fabric)
	end
	local qf = folders["Crew Quarters"]
	for _, x in { -57, -33 } do
		for _, z in { -34, -18 } do
			part(qf, Vector3.new(7, 2.5, 4), CFrame.new(x, 1.25, z), Color3.fromRGB(80, 90, 120), Enum.Material.Fabric)
		end
	end

	-- Vents (where the Keis come from) ----------------------------------------------------------
	local vents = {}
	for _, pos in { Vector3.new(-105, 0, -18), Vector3.new(-105, 0, 18), Vector3.new(-15, 0, -60), Vector3.new(15, 0, -60),
		Vector3.new(-58, 0, -36), Vector3.new(14, 0, 58), Vector3.new(50, 0, 38) } do
		local grate = deco(ship, Vector3.new(5, 0.2, 5), CFrame.new(pos + Vector3.new(0, 0.05, 0)), Color3.fromRGB(20, 20, 24), Enum.Material.DiamondPlate)
		grate.Name = "Vent"
		local glowV = deco(ship, Vector3.new(4.4, 0.1, 4.4), CFrame.new(pos + Vector3.new(0, 0.02, 0)), Color3.fromRGB(255, 40, 30), Enum.Material.Neon)
		glowV.Transparency = 0.5
		table.insert(vents, pos + Vector3.new(0, 3, 0))
	end

	-- Space -------------------------------------------------------------------------------------
	local jupiterCenter, jupiterRadius = Vector3.new(1000, 110, 720), 460
	local space = {
		SpaceArt.jupiter(ship, jupiterCenter, jupiterRadius, Vector3.new(40, 8, 0), 1),
		SpaceArt.stars(ship, Vector3.new(0, 0, 0), 1700, 450, 7, jupiterCenter, jupiterRadius * 2.1),
	}

	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("Clouds") then
			child:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.StarCount = 5000
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.Ambient = Color3.fromRGB(30, 32, 36)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 130)
	Lighting.ExposureCompensation = 0.15
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.FogEnd = 100000
	Lighting.GlobalShadows = true

	return {
		folder = ship,
		spawn = spawn,
		reactor = core,
		reactorRadius = 8,
		vents = vents,
		roomCenters = roomCenters,
		leaderboard = boardFrame,
		space = space,
		armoryPrompt = armoryPrompt,
	}
end

return ShipBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Suit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Dresses every crew member in a white spacesuit: suit colors, glass helmet, life-support pack, mission patch.
-- Turn off with Config.SPACESUITS = false.

local Suit = {}

local SUIT_WHITE = Color3.fromRGB(232, 232, 228)
local SUIT_GREY = Color3.fromRGB(150, 152, 156)
local PATCH = Color3.fromRGB(255, 138, 61)

local function attach(character: Model, anchor: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3,
	material: Enum.Material, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = transparency == nil
	p.CFrame = anchor.CFrame * offset
	p.Parent = character
	local w = Instance.new("WeldConstraint")
	w.Part0 = anchor
	w.Part1 = p
	w.Parent = p
	return p
end

function Suit.apply(character: Model)
	if character:FindFirstChild("SuitHelmet") then
		return
	end
	-- strip clothing + hats/hair (they would poke through the helmet)
	for _, d in character:GetChildren() do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end
	-- suit colors on every body part except the head
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.TorsoColor3 = SUIT_WHITE
		bodyColors.LeftArmColor3 = SUIT_WHITE
		bodyColors.RightArmColor3 = SUIT_WHITE
		bodyColors.LeftLegColor3 = SUIT_WHITE
		bodyColors.RightLegColor3 = SUIT_WHITE
	end
	for _, d in character:GetChildren() do
		if d:IsA("BasePart") and d.Name ~= "Head" and d.Name ~= "HumanoidRootPart" then
			d.Color = if string.find(d.Name, "Hand") or string.find(d.Name, "Foot") then SUIT_GREY else SUIT_WHITE
			d.Material = Enum.Material.Fabric
		end
	end

	local head = character:FindFirstChild("Head") :: BasePart?
	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if head then
		local d = math.max(head.Size.Y, head.Size.Z, head.Size.X * 0.6) * 1.75 -- works for R6 (2x1x1 head) and R15
		attach(character, head, "SuitHelmet", Vector3.one * d, CFrame.new(0, 0.1, 0), Color3.fromRGB(190, 215, 240),
			Enum.Material.Glass, Enum.PartType.Ball, 0.72)
		attach(character, head, "SuitCollar", Vector3.new(0.35, d * 0.85, d * 0.85), CFrame.new(0, -d * 0.42, 0) * CFrame.Angles(0, 0, math.rad(90)),
			SUIT_GREY, Enum.Material.Metal, Enum.PartType.Cylinder)
	end
	if torso then
		local back = torso.Size.Z / 2
		attach(character, torso, "SuitPack", Vector3.new(torso.Size.X * 0.8, torso.Size.Y * 1.05, 0.7), CFrame.new(0, 0.1, back + 0.35),
			SUIT_WHITE, Enum.Material.SmoothPlastic)
		attach(character, torso, "SuitPackLight", Vector3.new(0.3, 0.3, 0.1), CFrame.new(torso.Size.X * 0.25, torso.Size.Y * 0.35, back + 0.72),
			Color3.fromRGB(90, 220, 255), Enum.Material.Neon)
		attach(character, torso, "SuitPatch", Vector3.new(0.45, 0.35, 0.05), CFrame.new(-torso.Size.X * 0.25, torso.Size.Y * 0.2, -torso.Size.Z / 2 - 0.03),
			PATCH, Enum.Material.SmoothPlastic)
	end
end

return Suit
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000024"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000023"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000017"><Properties><string name="Name">Armory</string><ProtectedString name="Source"><![CDATA[--!strict
-- The Armory: opened at the weapon bench. Attachments (with live 3D preview), upgrades, supplies.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local WeaponModel = require(Shared:WaitForChild("WeaponModel"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Attachment = Remotes:WaitForChild("Attachment") :: RemoteEvent
local Buy = Remotes:WaitForChild("BuyUpgrade") :: RemoteEvent
local Repair = Remotes:WaitForChild("RepairReactor") :: RemoteEvent

local gui = make("ScreenGui", { Name = "Armory", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 15, Enabled = false,
	Parent = player:WaitForChild("PlayerGui") })
local scale = make("UIScale", { Parent = gui })
RunService.RenderStepped:Connect(function()
	scale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.55, 1.1)
end)
-- a Modal button frees the mouse while in first person
make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Text = "",
	AutoButtonColor = false, Modal = true, Parent = gui })

local panel = Theme.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1060, 640), Parent = gui })
text({ Font = F.Title, TextSize = 26, Position = UDim2.fromOffset(26, 18), Size = UDim2.fromOffset(500, 32), Text = "ARMORY", Parent = panel })
text({ Font = F.Mono, TextSize = 14, TextColor3 = C.Muted, Position = UDim2.fromOffset(26, 50), Size = UDim2.fromOffset(500, 18),
	Text = "USS KEPLER · WEAPON SYSTEMS · 07/14/2011", Parent = panel })
local creditsText = text({ Font = F.Heavy, TextSize = 24, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -70, 0, 20), Size = UDim2.fromOffset(260, 30), Parent = panel })
local closeBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 18), Size = UDim2.fromOffset(36, 36),
	BackgroundColor3 = C.Bg, Text = "✕", Font = F.Heavy, TextSize = 18, TextColor3 = C.Text, Parent = panel }, { Theme.corner(8) })

-- Preview (left) ---------------------------------------------------------------------------------------
local previewBox = make("Frame", { Position = UDim2.fromOffset(26, 84), Size = UDim2.fromOffset(400, 530), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.1,
	Parent = panel }, { Theme.corner(10), Theme.stroke(C.Accent, 0.7, 1) })
local viewport = make("ViewportFrame", { Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 330), BackgroundTransparency = 1,
	Ambient = Color3.fromRGB(150, 150, 160), LightColor = Color3.fromRGB(255, 245, 230), LightDirection = Vector3.new(-1, -1, -0.6), Parent = previewBox })
local vpCam = Instance.new("Camera")
vpCam.FieldOfView = 30
vpCam.Parent = viewport
viewport.CurrentCamera = vpCam
local weaponName = text({ Font = F.Title, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 346),
	Size = UDim2.new(1, 0, 0, 26), Parent = previewBox })
local statsText = text({ Font = F.Mono, TextSize = 15, TextColor3 = C.Cream, Position = UDim2.fromOffset(24, 384), Size = UDim2.new(1, -48, 0, 130),
	TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = previewBox })

local previewModel: Model? = nil
local previewKey = ""
local hoverAtt: { slot: string, id: string }? = nil

local function currentAtt(): WeaponModel.Attachments
	local att = WeaponModel.decode(player:GetAttribute("Attachments") :: string?)
	if hoverAtt then
		(att :: any)[hoverAtt.slot] = hoverAtt.id
	end
	return att
end

local function refreshPreview()
	local weaponId = (player:GetAttribute("Weapon") :: string?) or "Blaster"
	local att = currentAtt()
	local key = weaponId .. WeaponModel.encode(att)
	if key == previewKey then
		return
	end
	previewKey = key
	if previewModel then
		previewModel:Destroy()
	end
	local m = Instance.new("Model")
	WeaponModel.build(weaponId, att, m, "Root")
	m.Parent = viewport
	previewModel = m
	local w = Config.Weapons[weaponId]
	weaponName.Text = if w then w.name else weaponId
	local optic = Config.attachment("Optic", att.Optic)
	local laser = Config.attachment("Laser", att.Laser)
	local muzzle = Config.attachment("Muzzle", att.Muzzle)
	statsText.Text = string.format("FIRE RATE   %.1f /s\nMAGAZINE    %d\nOPTIC       %s (%.1fx)\nLASER       %s\nMUZZLE      %s",
		1 / ((player:GetAttribute("FireInterval") :: number?) or 0.2), (player:GetAttribute("MagSize") :: number?) or 0,
		if optic then optic.name else "-", if optic then optic.zoom else 1, if laser then laser.name else "-", if muzzle then muzzle.name else "-")
end

-- Tabs (right) ---------------------------------------------------------------------------------------------
local content = make("Frame", { Position = UDim2.fromOffset(450, 136), Size = UDim2.fromOffset(584, 478), BackgroundTransparency = 1, Parent = panel })
local tabs: { [string]: Frame } = {}
local tabButtons: { [string]: TextButton } = {}
local function showTab(name: string)
	for n, f in tabs do
		f.Visible = n == name
		tabButtons[n].BackgroundColor3 = if n == name then C.Accent else C.Bg
		tabButtons[n].TextColor3 = if n == name then C.Bg else C.Text
	end
	Theme.playSound(Config.Sounds.UIClick, 0.4)
end
for i, name in { "ATTACHMENTS", "UPGRADES", "SUPPLIES" } do
	local b = make("TextButton", { Position = UDim2.fromOffset(450 + (i - 1) * 196, 84), Size = UDim2.fromOffset(186, 38), BackgroundColor3 = C.Bg,
		Text = name, Font = F.Title, TextSize = 13, TextColor3 = C.Text, Parent = panel }, { Theme.corner(8), Theme.stroke(C.Accent, 0.5, 1) })
	tabButtons[name] = b
	tabs[name] = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = content })
	b.MouseButton1Click:Connect(function()
		showTab(name)
	end)
end

local function owned(): { [string]: boolean }
	local set = {}
	for k in string.gmatch((player:GetAttribute("OwnedAttachments") :: string?) or "", "[^,]+") do
		set[k] = true
	end
	return set
end

-- ATTACHMENTS
type Option = { button: TextButton, slot: string, def: any, status: TextLabel }
local options: { Option } = {}
do
	local y = 0
	for _, slot in { "Optic", "Laser", "Muzzle" } do
		text({ Font = F.Title, TextSize = 13, TextColor3 = C.Accent, Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(300, 18),
			Text = string.upper(slot), Parent = tabs.ATTACHMENTS })
		local row = make("Frame", { Position = UDim2.fromOffset(0, y + 22), Size = UDim2.new(1, 0, 0, 112), BackgroundTransparency = 1, Parent = tabs.ATTACHMENTS })
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), Parent = row })
		local defs = (Config.Attachments :: any)[slot]
		local w = math.floor((584 - 8 * (#defs - 1)) / #defs)
		for _, def in defs do
			local b = make("TextButton", { Size = UDim2.fromOffset(w, 112), BackgroundColor3 = C.Bg, BackgroundTransparency = 0.1, Text = "", AutoButtonColor = false,
				Parent = row }, { Theme.corner(8), Theme.stroke(C.Muted, 0.6, 1) })
			text({ Font = F.Title, TextSize = 11, Position = UDim2.fromOffset(8, 10), Size = UDim2.new(1, -16, 0, 28), TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center, Text = def.name, Parent = b })
			text({ Font = F.Body, TextSize = 11, TextColor3 = C.Muted, Position = UDim2.fromOffset(6, 40), Size = UDim2.new(1, -12, 0, 36), TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Text = def.desc or "", Parent = b })
			local status = text({ Font = F.Heavy, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -28),
				Size = UDim2.new(1, 0, 0, 20), Parent = b })
			b.MouseEnter:Connect(function()
				hoverAtt = { slot = slot, id = def.id }
				refreshPreview()
			end)
			b.MouseLeave:Connect(function()
				if hoverAtt and hoverAtt.id == def.id then
					hoverAtt = nil
					refreshPreview()
				end
			end)
			b.MouseButton1Click:Connect(function()
				Attachment:FireServer(slot, def.id)
				Theme.playSound(Config.Sounds.UIClick, 0.5)
			end)
			table.insert(options, { button = b, slot = slot, def = def, status = status })
		end
		y += 150
	end
end

-- UPGRADES
type Card = { def: any, level: TextLabel, pips: { Frame }, buy: TextButton }
local cards: { Card } = {}
do
	local grid = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = tabs.UPGRADES })
	make("UIGridLayout", { CellSize = UDim2.fromOffset(186, 150), CellPadding = UDim2.fromOffset(13, 13), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, def in Config.Upgrades do
		local cell = make("Frame", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.1, LayoutOrder = i, Parent = grid },
			{ Theme.corner(10), Theme.stroke(C.Accent, 0.75, 1) })
		text({ Font = F.Heavy, TextSize = 24, TextColor3 = C.Accent, Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(30, 30), Text = def.icon, Parent = cell })
		text({ Font = F.Title, TextSize = 11, Position = UDim2.fromOffset(44, 10), Size = UDim2.new(1, -52, 0, 16), Text = def.name, Parent = cell })
		text({ Font = F.Body, TextSize = 12, TextColor3 = C.Muted, Position = UDim2.fromOffset(44, 28), Size = UDim2.new(1, -52, 0, 16), Text = def.desc, Parent = cell })
		local pipRow = make("Frame", { Position = UDim2.fromOffset(12, 56), Size = UDim2.new(1, -24, 0, 8), BackgroundTransparency = 1, Parent = cell })
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = pipRow })
		local pips = {}
		for _ = 1, def.max do
			table.insert(pips, make("Frame", { Size = UDim2.new(1 / def.max, -4, 1, 0), BackgroundColor3 = Color3.fromRGB(50, 42, 56), BorderSizePixel = 0, Parent = pipRow }, { Theme.corner(3) }))
		end
		local level = text({ Font = F.Bold, TextSize = 12, TextColor3 = C.Cream, Position = UDim2.fromOffset(12, 70), Size = UDim2.new(1, -24, 0, 16), Parent = cell })
		local buy = make("TextButton", { Position = UDim2.new(0, 12, 1, -44), Size = UDim2.new(1, -24, 0, 34), BackgroundColor3 = C.Accent, Font = F.Heavy,
			TextSize = 14, TextColor3 = C.Bg, Text = "", Parent = cell }, { Theme.corner(8) })
		buy.MouseButton1Click:Connect(function()
			Buy:FireServer(def.id)
		end)
		table.insert(cards, { def = def, level = level, pips = pips, buy = buy })
	end
end

-- SUPPLIES
local MINIGUN = Config.Weapons.Minigun
local minigunBtn = make("TextButton", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = C.Gold, Font = F.Title, TextSize = 15, TextColor3 = C.Bg,
	Text = "", Parent = tabs.SUPPLIES }, { Theme.corner(10) })
minigunBtn.MouseButton1Click:Connect(function()
	Buy:FireServer("Minigun")
end)
minigunBtn.MouseEnter:Connect(function()
	if player:GetAttribute("Weapon") ~= "Minigun" then
		previewKey = ""
		local m = Instance.new("Model")
		WeaponModel.build("Minigun", currentAtt(), m, "Root")
		if previewModel then
			previewModel:Destroy()
		end
		m.Parent = viewport
		previewModel = m
		weaponName.Text = MINIGUN.name
	end
end)
minigunBtn.MouseLeave:Connect(function()
	previewKey = ""
	refreshPreview()
end)
local repairBtn = make("TextButton", { Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = C.Cyan, Font = F.Title, TextSize = 15,
	TextColor3 = C.Bg, Text = `REPAIR REACTOR  +{Config.REPAIR_AMOUNT} HP  ·  ◆ {Config.REPAIR_COST}`, Parent = tabs.SUPPLIES }, { Theme.corner(10) })
repairBtn.MouseButton1Click:Connect(function()
	Repair:FireServer()
end)

-- Refresh --------------------------------------------------------------------------------------------------
local GREY = Color3.fromRGB(60, 52, 66)
local function refresh()
	local money = (player:GetAttribute("Credits") :: number?) or 0
	creditsText.Text = `◆ {money}`
	local att = WeaponModel.decode(player:GetAttribute("Attachments") :: string?)
	local have = owned()
	for _, o in options do
		local equipped = (att :: any)[o.slot] == o.def.id
		local isOwned = o.def.price == 0 or have[o.slot .. "." .. o.def.id]
		local stroke = o.button:FindFirstChildOfClass("UIStroke")
		if equipped then
			o.status.Text, o.status.TextColor3 = "EQUIPPED", C.Good
		elseif isOwned then
			o.status.Text, o.status.TextColor3 = "EQUIP", C.Text
		else
			o.status.Text = `◆ {o.def.price}`
			o.status.TextColor3 = if money >= o.def.price then C.Gold else C.Muted
		end
		if stroke then
			stroke.Color = if equipped then C.Good else C.Muted
			stroke.Transparency = if equipped then 0 else 0.6
		end
	end
	for _, card in cards do
		local lvl = (player:GetAttribute("Up_" .. card.def.id) :: number?) or 0
		for i, pip in card.pips do
			pip.BackgroundColor3 = if i <= lvl then C.Accent else GREY
		end
		card.level.Text = `LEVEL {lvl} / {card.def.max}`
		if lvl >= card.def.max then
			card.buy.Text, card.buy.BackgroundColor3, card.buy.TextColor3 = "MAXED", GREY, C.Muted
		else
			local cost = Config.upgradeCost(card.def, lvl)
			local afford = money >= cost
			card.buy.Text = `BUY  ◆ {cost}`
			card.buy.BackgroundColor3 = if afford then C.Accent else GREY
			card.buy.TextColor3 = if afford then C.Bg else C.Muted
		end
	end
	if player:GetAttribute("Weapon") == "Minigun" then
		minigunBtn.Text, minigunBtn.BackgroundColor3, minigunBtn.TextColor3 = `{MINIGUN.name}  ·  EQUIPPED`, GREY, C.Muted
	else
		local afford = money >= MINIGUN.cost
		minigunBtn.Text = `UNLOCK {MINIGUN.name}  ·  ◆ {MINIGUN.cost}`
		minigunBtn.BackgroundColor3 = if afford then C.Gold else GREY
		minigunBtn.TextColor3 = if afford then C.Bg else C.Muted
	end
	local hp = (ReplicatedStorage:GetAttribute("ReactorHP") :: number?) or 0
	local max = (ReplicatedStorage:GetAttribute("ReactorMax") :: number?) or 1
	local canRepair = money >= Config.REPAIR_COST and hp < max
	repairBtn.BackgroundColor3 = if canRepair then C.Cyan else GREY
	repairBtn.TextColor3 = if canRepair then C.Bg else C.Muted
	previewKey = ""
	refreshPreview()
end
player.AttributeChanged:Connect(function()
	if gui.Enabled then
		refresh()
	end
end)

-- Open / close ----------------------------------------------------------------------------------------------
local openedAt: Vector3? = nil
local function setOpen(open: boolean)
	gui.Enabled = open
	player:SetAttribute("UIOpen", open)
	if open then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		openedAt = if hrp then hrp.Position else nil
		hoverAtt = nil
		refresh()
		showTab("ATTACHMENTS")
		panel.Size = UDim2.fromOffset(1000, 600)
		Theme.tween(panel, 0.2, { Size = UDim2.fromOffset(1060, 640) }, Enum.EasingStyle.Back)
	end
end
Remotes:WaitForChild("OpenArmory").OnClientEvent:Connect(function()
	setOpen(true)
end)
closeBtn.MouseButton1Click:Connect(function()
	setOpen(false)
end)
Remotes:WaitForChild("Purchased").OnClientEvent:Connect(function()
	Theme.playSound(Config.Sounds.Buy, 0.6)
end)

RunService.RenderStepped:Connect(function()
	if not gui.Enabled then
		return
	end
	-- orbit the preview camera around the weapon
	local t = os.clock() * 0.6
	vpCam.CFrame = CFrame.lookAt(Vector3.new(math.sin(t) * 9, 1.6, math.cos(t) * 9) + Vector3.new(0, 0, -0.6), Vector3.new(0, 0.2, -0.6))
	-- walking away closes it
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if openedAt and hrp and (hrp.Position - openedAt).Magnitude > 14 then
		setOpen(false)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000018"><Properties><string name="Name">Atmosphere</string><ProtectedString name="Source"><![CDATA[--!strict
-- Semi-horror mood: light 2011 camcorder overlay, color grade, alarm pulse, power-outage dark, static when a Keis is close.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local rng = Random.new()

-- Color grade ---------------------------------------------------------------------------------------
local cc = make("ColorCorrectionEffect", { Saturation = -0.25, Contrast = 0.18, TintColor = Color3.fromRGB(236, 246, 240), Parent = Lighting })
make("BlurEffect", { Size = 1.2, Parent = Lighting }) -- slightly soft, like a security camera
make("BloomEffect", { Intensity = 0.9, Threshold = 0.9, Size = 28, Parent = Lighting })
make("SunRaysEffect", { Intensity = 0.03, Spread = 0.6, Parent = Lighting })

local gui = make("ScreenGui", { Name = "Atmosphere", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1,
	Parent = player:WaitForChild("PlayerGui") })

-- vignette
for _, rot in { 0, 90 } do
	make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui }, {
		make("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.18, 1),
			NumberSequenceKeypoint.new(0.82, 1), NumberSequenceKeypoint.new(1, 0.35) }) }),
	})
end
-- red alarm edge
local alarmEdge = {}
for _, rot in { 0, 90 } do
	local f = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Danger, BorderSizePixel = 0, BackgroundTransparency = 1, Parent = gui }, {
		make("UIGradient", { Rotation = rot, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.12, 1),
			NumberSequenceKeypoint.new(0.88, 1), NumberSequenceKeypoint.new(1, 0.2) }) }),
	})
	table.insert(alarmEdge, f)
end

-- faint scanlines
local scan = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
for i = 0, 89 do
	make("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, i / 90), BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.92, Parent = scan })
end

-- security camera overlay (like the footage): timestamp + camera of the room you're in
local stamp = text({ Font = Enum.Font.Code, TextSize = 22, TextColor3 = Color3.fromRGB(235, 235, 230), TextStrokeTransparency = 0.6,
	Position = UDim2.fromOffset(16, 10), Size = UDim2.fromOffset(400, 24), Parent = gui })
local camId = text({ Font = Enum.Font.Code, TextSize = 22, TextColor3 = Color3.fromRGB(235, 235, 230), TextStrokeTransparency = 0.6,
	Position = UDim2.fromOffset(16, 34), Size = UDim2.fromOffset(400, 24), Text = "CAM 01 (BRIDGE)", Parent = gui })
local rec = text({ Font = Enum.Font.Code, TextSize = 22, TextColor3 = Color3.fromRGB(235, 235, 230), TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 10), Size = UDim2.fromOffset(200, 24), RichText = true,
	Text = 'REC <font color="#F0463C">●</font>', Parent = gui })

-- which room is the local player in? (rooms carry Center/Size/Cam attributes)
local currentCam = "CAM 01 (BRIDGE)"
task.spawn(function()
	while true do
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local ship = workspace:FindFirstChild("Ship")
		if ReplicatedStorage:GetAttribute("Stage") == "Moon" then
			currentCam = "CAM EXT-1 (IO SURFACE)"
		elseif hrp and ship then
			for _, room in ship:GetChildren() do
				local center = room:GetAttribute("Center") :: Vector3?
				local size = room:GetAttribute("Size") :: Vector2?
				if center and size and math.abs(hrp.Position.X - center.X) <= size.X / 2 and math.abs(hrp.Position.Z - center.Z) <= size.Y / 2 then
					currentCam = (room:GetAttribute("Cam") :: string?) or currentCam
					break
				end
			end
		end
		task.wait(0.3)
	end
end)

-- static specks (only near Keis)
local specks = {}
for _ = 1, 70 do
	table.insert(specks, make("Frame", { BorderSizePixel = 0, Visible = false, Parent = gui }))
end

-- Sounds ---------------------------------------------------------------------------------------------
if Config.Sounds.Music ~= "" then
	local music = make("Sound", { SoundId = Config.Sounds.Music, Looped = true, Volume = 0.25, Parent = SoundService })
	music:Play()
end
local alarmSound: Sound? = nil
if Config.Sounds.Alarm ~= "" then
	alarmSound = make("Sound", { SoundId = Config.Sounds.Alarm, Looped = true, Volume = 0, Parent = SoundService })
	;(alarmSound :: Sound):Play()
end

-- Per frame --------------------------------------------------------------------------------------------
local start = os.clock()
local BASE = 23 * 3600 + 47 * 60 + 12 -- 23:47:12 (from the videos' timestamp)
local danger = 0

local function nearestKeis(): number
	local folder = workspace:FindFirstChild("Keis")
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not folder or not hrp then
		return math.huge
	end
	local best = math.huge
	for _, m in folder:GetChildren() do
		local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			best = math.min(best, (root.Position - hrp.Position).Magnitude)
		end
	end
	return best
end

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	local secs = (BASE + math.floor(now - start)) % 86400
	stamp.Text = string.format("07/14/2011 %02d:%02d:%02d", secs // 3600, (secs // 60) % 60, secs % 60)
	rec.Visible = (now % 1.2) < 0.8

	local powerOut = ReplicatedStorage:GetAttribute("PowerOut") == true
	local alarm = ReplicatedStorage:GetAttribute("Alarm") == true

	-- static ramps up as a Keis closes in (light, this is semi-horror)
	local target = 0.12 + math.clamp(1 - (nearestKeis() - 6) / 30, 0, 1) * 0.5 -- constant light grain + more near a Keis
	danger += (target - danger) * math.min(dt * 5, 1)
	local count = math.floor(#specks * danger)
	for i, s in specks do
		if i <= count then
			s.Visible = true
			s.Size = UDim2.fromOffset(rng:NextInteger(3, 30), rng:NextInteger(1, 2))
			s.Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber())
			local g = rng:NextNumber(0.7, 1)
			s.BackgroundColor3 = Color3.new(g, g, g)
			s.BackgroundTransparency = rng:NextNumber(0.3, 0.7)
		else
			s.Visible = false
		end
	end
	camId.Text = if danger > 0.4 and rng:NextNumber() < 0.03 then "CAM ?? (KEIS KEIS KEIS)" else currentCam

	-- grading
	local pulse = if alarm then (math.sin(now * 4) + 1) / 2 else 0
	for _, f in alarmEdge do
		f.BackgroundTransparency = 1 - pulse * 0.35
	end
	if alarmSound then
		alarmSound.Volume = if alarm then 0.15 else 0
	end
	cc.Brightness = if powerOut then -0.12 else 0
	cc.Saturation = if powerOut then -0.6 else -0.25 - danger * 0.3
	cc.TintColor = if powerOut then Color3.fromRGB(200, 215, 255) else Color3.fromRGB(236, 246 - math.floor(danger * 60), 240 - math.floor(danger * 80))
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000019"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- Shooting feel: hold-to-fire, crosshair, tracers, hitmarkers, floating damage numbers, kill pops, combo counter, ammo.

local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse = player:GetMouse()
local Shoot = Remotes:WaitForChild("Shoot") :: RemoteEvent
local Reload = Remotes:WaitForChild("Reload") :: RemoteEvent

local gui = make("ScreenGui", { Name = "Combat", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 6,
	Parent = player:WaitForChild("PlayerGui") })

-- Crosshair -----------------------------------------------------------------------------------------
local cross = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(34, 34), BackgroundTransparency = 1, Visible = false, Parent = gui })
for _, d in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
	make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, d[1] * 10, 0.5, d[2] * 10),
		Size = if d[1] == 0 then UDim2.fromOffset(2, 8) else UDim2.fromOffset(8, 2),
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
		Parent = cross,
	})
end
make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(3, 3),
	BackgroundColor3 = C.Accent, BorderSizePixel = 0, Parent = cross })
local hitmarker = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(40, 40),
	BackgroundTransparency = 1, Text = "✕", TextSize = 30, Font = F.Heavy, TextColor3 = C.Text, TextTransparency = 1, Parent = cross })

-- Ammo panel (bottom right) ----------------------------------------------------------------------------
local ammoPanel = Theme.panel({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.fromOffset(200, 70), Parent = gui })
local ammoText = text({ Font = F.Title, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.fromOffset(0, 6),
	Size = UDim2.new(1, -14, 0, 36), Parent = ammoPanel })
local ammoSub = text({ Font = F.Bold, TextSize = 12, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Right,
	Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -14, 0, 16), Text = "BLASTER · [R] RELOAD", Parent = ammoPanel })

-- Combo counter ----------------------------------------------------------------------------------------
local comboLabel = text({ Font = F.Title, TextSize = 26, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -96), Size = UDim2.fromOffset(300, 34),
	TextStrokeTransparency = 0.3, TextTransparency = 1, Parent = gui })
local combo, comboUntil = 0, 0
local COMBO_NAMES = { [3] = "TRIPLE KEIS", [5] = "KEY SMASHER", [8] = "LOCKSMITH RAMPAGE", [12] = "O ALGO O ALGO", [20] = "THE TRUE SURVIVOR" }

-- Firing -------------------------------------------------------------------------------------------------
local firing = false
local lastFire = 0
local hooked: { [Tool]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function weaponIn(container: Instance?): Tool?
	if not container then
		return nil
	end
	for _, t in container:GetChildren() do
		if t:IsA("Tool") and t:GetAttribute("IsWeapon") then
			return t
		end
	end
	return nil
end

local function equippedBlaster(): Tool?
	return weaponIn(player.Character)
end

local function tracerColor(who: Player): Color3
	local w = Config.Weapons[(who:GetAttribute("Weapon") :: string?) or "Blaster"]
	return if w then w.tracer else C.Cyan
end

local function muzzlePos(): Vector3?
	-- first person: the viewmodel's muzzle (what you actually see), else the tool's
	local vmModel = camera:FindFirstChild("Viewmodel")
	local vmMuzzle = vmModel and vmModel:FindFirstChild("Muzzle") :: BasePart?
	if vmMuzzle then
		return vmMuzzle.Position
	end
	local tool = equippedBlaster()
	local muzzle = tool and tool:FindFirstChild("Muzzle") :: BasePart?
	return if muzzle then muzzle.Position else nil
end

local tracerFolder = make("Folder", { Name = "LocalTracers", Parent = workspace })
mouse.TargetFilter = tracerFolder
local function tracer(from: Vector3, to: Vector3, color: Color3)
	local len = (to - from).Magnitude
	if len < 0.5 then
		return
	end
	local p = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Material = Enum.Material.Neon, Color = color, Size = Vector3.new(0.14, 0.14, len),
		CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -len / 2), Parent = tracerFolder,
	})
	Theme.tween(p, 0.09, { Transparency = 1, Size = Vector3.new(0.02, 0.02, len) })
	Debris:AddItem(p, 0.12)
	local spark = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon, Color = color, Size = Vector3.one * 0.8, CFrame = CFrame.new(to), Parent = tracerFolder,
	})
	Theme.tween(spark, 0.15, { Transparency = 1, Size = Vector3.one * 2 })
	Debris:AddItem(spark, 0.2)
end

-- where the shot goes: through the screen center in shoulder mode, else the mouse
local function aimPoint(): Vector3
	if true then -- first person: always shoot through the screen center
		local vp = camera.ViewportSize
		local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Instance, tracerFolder, camera }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
		return if hit then hit.Position else ray.Origin + ray.Direction * 400
	end
	return mouse.Hit.Position
end

local function muzzleFlash(at: Vector3, color: Color3)
	local f = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon, Color = color, Size = Vector3.one * 0.9, CFrame = CFrame.new(at), Parent = tracerFolder,
	})
	make("PointLight", { Color = color, Range = 14, Brightness = 4, Parent = f })
	Theme.tween(f, 0.06, { Size = Vector3.one * 0.2, Transparency = 1 })
	Debris:AddItem(f, 0.07)
end

local function tryFire()
	local tool = equippedBlaster()
	if not tool or player:GetAttribute("Reloading") or player:GetAttribute("CrewStatus") ~= "alive" or player:GetAttribute("Sprinting") then
		return
	end
	local interval = player:GetAttribute("FireInterval") or Config.Weapon.FireInterval
	local now = os.clock()
	if now - lastFire < interval then
		return
	end
	lastFire = now
	if (player:GetAttribute("Ammo") or 0) <= 0 then
		Reload:FireServer()
		return
	end
	local aim = aimPoint()
	Shoot:FireServer(aim)
	-- local tracer + muzzle flash for instant feedback
	local from = muzzlePos()
	if from then
		tracer(from, aim, tracerColor(player))
		muzzleFlash(from, tracerColor(player))
	end
	local minigun = player:GetAttribute("Weapon") == "Minigun"
	player:SetAttribute("LastShot", os.clock()) -- Viewmodel.client plays the recoil
	Theme.playSound(if minigun then Config.Sounds.MinigunShoot else Config.Sounds.Shoot, if minigun then 0.35 else 0.5, 0.95 + math.random() * 0.1)
	-- recoil (small, constant buzz for the minigun; a kick for the blaster)
	local kick = if minigun then 0.18 else 0.55
	camera.CFrame *= CFrame.Angles(math.rad(kick), math.rad((math.random() - 0.5) * kick * 0.6), 0)
end

local function hookTool(tool: Tool)
	if hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		firing = true
		tryFire()
	end)
	tool.Deactivated:Connect(function()
		firing = false
	end)
	tool.Unequipped:Connect(function()
		firing = false
	end)
end

local function hookCharacter(character: Model)
	character.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then
			-- attributes replicate with the tool, but give them a frame to be safe
			task.defer(function()
				if c:GetAttribute("IsWeapon") then
					hookTool(c)
				end
			end)
		end
	end)
	local existing = weaponIn(character)
	if existing then
		hookTool(existing)
	end
end
if player.Character then
	hookCharacter(player.Character)
end
player.CharacterAdded:Connect(hookCharacter)
player:GetAttributeChangedSignal("Reloading"):Connect(function()
	if player:GetAttribute("Reloading") then
		Theme.playSound(Config.Sounds.Reload, 0.6)
	end
end)

ContextActionService:BindAction("JupiterReload", function(_, state)
	if state == Enum.UserInputState.Begin then
		Reload:FireServer()
	end
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("JupiterReload", "R")

RunService.RenderStepped:Connect(function()
	local tool = equippedBlaster()
	local armed = tool ~= nil
	cross.Visible = armed and not player:GetAttribute("ADS")
	UserInputService.MouseIconEnabled = not armed
	if armed then
		local m = UserInputService:GetMouseLocation()
		cross.Position = UDim2.fromOffset(m.X, m.Y)
		if firing then
			tryFire()
		end
	end
	ammoPanel.Visible = armed or player:GetAttribute("Downed") == true
	if player:GetAttribute("Reloading") then
		ammoText.Text = "RELOADING"
		ammoText.TextColor3 = C.Accent
	else
		local ammo = player:GetAttribute("Ammo") or 0
		ammoText.Text = `{ammo} / {player:GetAttribute("MagSize") or 0}`
		ammoText.TextColor3 = if ammo <= 3 then C.Danger else C.Text
	end
	local w = Config.Weapons[(player:GetAttribute("Weapon") :: string?) or "Blaster"]
	ammoSub.Text = `{if w then w.name else "BLASTER"} · [R] RELOAD`
	if os.clock() > comboUntil and combo > 0 then
		combo = 0
		Theme.tween(comboLabel, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end
end)

-- Other players' shots -------------------------------------------------------------------------------------
Remotes:WaitForChild("ShotFx").OnClientEvent:Connect(function(shooter: Player, origin: Vector3, hits: { Vector3 })
	if shooter == player then
		-- our extra Split Beam pellets (the first one was drawn locally already)
		local from = muzzlePos() or origin
		for i = 2, #hits do
			tracer(from, hits[i], tracerColor(player))
		end
		return
	end
	local character = shooter.Character
	local tool = weaponIn(character)
	local muzzle = tool and tool:FindFirstChild("Muzzle") :: BasePart?
	local from = if muzzle then muzzle.Position else origin
	for _, h in hits do
		tracer(from, h, tracerColor(shooter))
	end
end)

-- Perk visuals: chain lightning, ricochet, explosive crits ------------------------------------------------
Remotes:WaitForChild("Arc").OnClientEvent:Connect(function(kind: string, points: { Vector3 })
	if kind == "boom" then
		local at = points[1]
		local ball = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 150, 50), Size = Vector3.one * 2,
			CFrame = CFrame.new(at), Parent = tracerFolder })
		make("PointLight", { Color = ball.Color, Range = 20, Brightness = 4, Parent = ball })
		Theme.tween(ball, 0.3, { Size = Vector3.one * 18, Transparency = 1 })
		Debris:AddItem(ball, 0.35)
		return
	end
	local color = if kind == "zap" then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 170, 60)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		if kind == "zap" then
			-- jagged lightning: split each jump into wobbly segments
			local prev = a
			for k = 1, 5 do
				local t = k / 5
				local p = a:Lerp(b, t) + (if k < 5 then Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2.2 else Vector3.zero)
				tracer(prev, p, color)
				prev = p
			end
		else
			tracer(a, b, color)
		end
	end
end)

-- Hit feedback ---------------------------------------------------------------------------------------------
local function popup(worldPos: Vector3, msg: string, color: Color3, size: number)
	local anchor = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
		Size = Vector3.one * 0.1, CFrame = CFrame.new(worldPos), Parent = tracerFolder })
	local bb = make("BillboardGui", { Size = UDim2.fromOffset(160, 50), AlwaysOnTop = true, LightInfluence = 0, Adornee = anchor, Parent = anchor })
	local l = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = F.Heavy, TextSize = size,
		TextColor3 = color, TextStrokeTransparency = 0.2, Text = msg, Parent = bb })
	local dx = (math.random() - 0.5) * 2
	Theme.tween(bb, 0.7, { StudsOffsetWorldSpace = Vector3.new(dx, 3, 0) })
	task.delay(0.35, function()
		Theme.tween(l, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(anchor, 0.8)
end

Remotes:WaitForChild("HitConfirm").OnClientEvent:Connect(function(pos: Vector3, dmg: number, crit: boolean, killed: boolean, reward: number, golden: boolean)
	hitmarker.TextColor3 = if killed then C.Danger elseif crit then C.Gold else C.Text
	hitmarker.TextTransparency = 0
	hitmarker.Size = UDim2.fromOffset(if killed then 56 else 40, if killed then 56 else 40)
	Theme.tween(hitmarker, 0.18, { TextTransparency = 1 })
	popup(pos, if crit then `{dmg} CRIT!` else tostring(dmg), if crit then C.Gold else C.Text, if crit then 26 else 20)
	Theme.playSound(Config.Sounds.Hit, 0.3, if crit then 1.3 else 1)
	if killed then
		popup(pos + Vector3.new(0, 2, 0), `+{reward} ◆`, if golden then C.Gold else C.Good, if golden then 34 else 24)
		Theme.playSound(Config.Sounds.Kill, 0.5)
		combo += 1
		comboUntil = os.clock() + 2.5
		if combo >= 2 then
			local name, best = "", 0
			for n, label in COMBO_NAMES do
				if combo >= n and n > best then
					best, name = n, label
				end
			end
			comboLabel.Text = `x{combo}  {name}`
			comboLabel.TextTransparency = 0
			comboLabel.TextStrokeTransparency = 0.3
			comboLabel.TextSize = 34
			Theme.tween(comboLabel, 0.2, { TextSize = 26 })
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001A"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!strict
-- Main HUD: wave + reactor, crew roster (meme format), player card, banners, narrator, toasts, downed + game over screens.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local gui = make("ScreenGui", { Name = "HUD", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
local scale = make("UIScale", { Parent = gui })
RunService.RenderStepped:Connect(function()
	scale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.15)
end)

local thumbs: { [number]: string } = {}
local function headshot(userId: number): string
	if thumbs[userId] == nil then
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(math.max(userId, 1), Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		thumbs[userId] = if ok then url else ""
	end
	return thumbs[userId]
end

-- Wave panel (top center) -------------------------------------------------------------------------
local wavePanel = Theme.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(340, 92), Parent = gui })
local waveTitle = text({ Font = F.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 8),
	Size = UDim2.new(1, 0, 0, 32), Text = "USS KEPLER", Parent = wavePanel })
local waveSub = text({ Font = F.Bold, TextSize = 14, TextColor3 = C.Cream, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 18), Text = "", Parent = wavePanel })
local reactorBar = Theme.bar({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 64), Size = UDim2.new(1, -28, 0, 16), Parent = wavePanel }, C.Cyan)

-- Objective panel (under the wave panel): mission, objective + progress, modifier
local objPanel = Theme.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.fromOffset(440, 70),
	Visible = false, Parent = gui })
local objMission = text({ Font = F.Title, TextSize = 13, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 16), Parent = objPanel })
local objText = text({ Font = F.Bold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 26),
	Size = UDim2.new(1, -20, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = objPanel })
local objBar = Theme.bar({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 48), Size = UDim2.new(1, -40, 0, 8), Parent = objPanel }, C.Gold)
local modChip = text({ Font = F.Mono, TextSize = 14, TextColor3 = C.Danger, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 1, 4), Size = UDim2.fromOffset(440, 18), TextStrokeTransparency = 0.4, Parent = objPanel })
local function refreshObjective()
	local phase = ReplicatedStorage:GetAttribute("Phase")
	local objective = (ReplicatedStorage:GetAttribute("Objective") :: string?) or ""
	objPanel.Visible = phase == "Wave" and objective ~= ""
	objMission.Text = (ReplicatedStorage:GetAttribute("Mission") :: string?) or ""
	objText.Text = objective
	local prog = (ReplicatedStorage:GetAttribute("ObjectiveProgress") :: number?) or -1
	objBar.frame.Visible = prog >= 0
	if prog >= 0 then
		objBar:set(prog)
	end
	modChip.Text = (ReplicatedStorage:GetAttribute("Modifier") :: string?) or ""
end
for _, a in { "Phase", "Mission", "Objective", "ObjectiveProgress", "Modifier" } do
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refreshObjective)
end
refreshObjective()

local function formatTime(t: number): string
	return string.format("%d:%02d", t // 60, t % 60)
end
local function refreshWave()
	local phase = ReplicatedStorage:GetAttribute("Phase")
	local t = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local w = ReplicatedStorage:GetAttribute("Wave") or 0
	if phase == "Lobby" then
		waveTitle.Text = "USS KEPLER"
		waveSub.Text = if t > 0 then `JUPITER ORBIT IN {t}` else "WAITING FOR CREW"
	elseif phase == "Wave" then
		local boss = w % Config.Waves.BossEvery == 0
		waveTitle.Text = string.format(if boss then "BOSS %02d" else "WAVE %02d", w)
		waveSub.Text = `KEIS LEFT  {ReplicatedStorage:GetAttribute("KeisLeft") or 0}`
	elseif phase == "Break" then
		waveTitle.Text = string.format("WAVE %02d", w + 1)
		waveSub.Text = `INCOMING IN {formatTime(t)}  ·  ARMORY BENCH`
	elseif phase == "GameOver" then
		waveTitle.Text = "SIGNAL LOST"
		waveSub.Text = `REACHED WAVE {w}`
	end
	waveTitle.TextColor3 = if phase == "Wave" and w % Config.Waves.BossEvery == 0 then C.Danger else C.Text
	local hp = ReplicatedStorage:GetAttribute("ReactorHP") or 0
	local max = ReplicatedStorage:GetAttribute("ReactorMax") or 1
	reactorBar:set(hp / max, `REACTOR  {math.floor(hp)} / {max}`)
	reactorBar.fill.BackgroundColor3 = if hp / max < 0.3 then C.Danger else C.Cyan
end
for _, a in { "Phase", "TimeLeft", "Wave", "KeisLeft", "ReactorHP", "ReactorMax" } do
	ReplicatedStorage:GetAttributeChangedSignal(a):Connect(refreshWave)
end
refreshWave()

-- Crew roster (top left) — the TikTok "JUPITER INCIDENT (2011)" format --------------------------------
local roster = Theme.panel({ Position = UDim2.fromOffset(14, 66), Size = UDim2.fromOffset(300, 60), AutomaticSize = Enum.AutomaticSize.Y, Parent = gui })
make("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = roster })
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = roster })
text({ RichText = true, Font = F.Title, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0,
	Text = 'CREW MANIFEST <font color="#96897F">· USS KEPLER</font>', Parent = roster })

type Row = { frame: Frame, img: ImageLabel, name: TextLabel, line: TextLabel, action: string, until_: number }
local rows: { [number]: Row } = {}

local function makeRow(member: Player): Row
	local frame = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = roster })
	local img = make("ImageLabel", { Size = UDim2.fromOffset(44, 44), BackgroundColor3 = C.Bg, Parent = frame }, { Theme.corner(8), Theme.stroke(C.Accent, 0.6, 1) })
	task.spawn(function()
		img.Image = headshot(member.UserId)
	end)
	local name = text({ Font = F.Bold, TextSize = 15, Position = UDim2.fromOffset(54, 2), Size = UDim2.new(1, -54, 0, 18),
		Text = member.DisplayName, TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
	local line = text({ Font = F.Meme, TextSize = 14, Position = UDim2.fromOffset(54, 22), Size = UDim2.new(1, -54, 0, 18),
		Text = "", TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
	return { frame = frame, img = img, name = name, line = line, action = "", until_ = 0 }
end

local function setAction(userId: number, msg: string, seconds: number)
	local row = rows[userId]
	if row then
		row.action = msg
		row.until_ = os.clock() + seconds
	end
end
Remotes:WaitForChild("CrewAction").OnClientEvent:Connect(function(userId: number, msg: string)
	setAction(userId, msg, 2.5)
end)
TextChatService.MessageReceived:Connect(function(message: TextChatMessage)
	if message.TextSource then
		setAction(message.TextSource.UserId, string.sub(message.Text, 1, 50), 4)
	end
end)

local function keisNear(character: Model?, range: number): boolean
	local folder = workspace:FindFirstChild("Keis")
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not folder or not hrp then
		return false
	end
	for _, m in folder:GetChildren() do
		local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - hrp.Position).Magnitude < range then
			return true
		end
	end
	return false
end

task.spawn(function()
	while true do
		local now = os.clock()
		local seen = {}
		for _, member in Players:GetPlayers() do
			seen[member.UserId] = true
			local row = rows[member.UserId] or makeRow(member)
			rows[member.UserId] = row
			local status = member:GetAttribute("CrewStatus")
			row.img.ImageTransparency = 0
			row.img.ImageColor3 = Color3.new(1, 1, 1)
			row.name.TextColor3 = C.Text
			if status == "dead" then
				row.img.ImageTransparency = 0.6
				row.name.TextColor3 = C.Muted
				row.line.Text, row.line.TextColor3 = "DECEASED", C.Muted
			elseif status == "downed" then
				row.img.ImageColor3 = Color3.fromRGB(255, 110, 100)
				row.line.Text, row.line.TextColor3 = "DOWN · NEEDS A REVIVE", C.Danger
			elseif now < row.until_ then
				row.line.Text, row.line.TextColor3 = row.action, C.Text
			elseif keisNear(member.Character, 25) then
				row.img.ImageColor3 = Color3.fromRGB(255, 150, 140)
				row.line.Text, row.line.TextColor3 = "KEY ENTITY APPROACHING", C.Danger
			elseif ReplicatedStorage:GetAttribute("PowerOut") then
				row.line.Text, row.line.TextColor3 = "NO SIGNAL", C.Muted
			else
				row.line.Text, row.line.TextColor3 = `LV {member:GetAttribute("Level") or 1} · {member:GetAttribute("Title") or "CADET"}`, C.Accent
			end
		end
		for id, row in rows do
			if not seen[id] then
				row.frame:Destroy()
				rows[id] = nil
			end
		end
		task.wait(0.2)
	end
end)

-- Player card (bottom left) ------------------------------------------------------------------------------
local card = Theme.panel({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14), Size = UDim2.fromOffset(300, 96), Parent = gui })
local levelBadge = make("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(46, 46), BackgroundColor3 = C.Accent, Parent = card }, { Theme.corner(23) })
local levelText = text({ Font = F.Heavy, TextSize = 20, TextColor3 = C.Bg, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = levelBadge })
local titleText = text({ Font = F.Title, TextSize = 13, TextColor3 = C.Accent, Position = UDim2.fromOffset(68, 12), Size = UDim2.new(1, -80, 0, 16), Parent = card })
local creditsText = text({ Font = F.Heavy, TextSize = 20, TextColor3 = C.Gold, Position = UDim2.fromOffset(68, 32), Size = UDim2.new(1, -80, 0, 24), Parent = card })
local keysText = text({ Font = F.Heavy, TextSize = 20, TextColor3 = C.Cream, TextXAlignment = Enum.TextXAlignment.Right,
	Position = UDim2.fromOffset(68, 32), Size = UDim2.new(1, -80, 0, 24), Parent = card })
local healthBar = Theme.bar({ Position = UDim2.fromOffset(12, 66), Size = UDim2.new(1, -24, 0, 18), Parent = card }, C.Good)

local lastKeys = 0
player:GetAttributeChangedSignal("Keys"):Connect(function()
	local k = (player:GetAttribute("Keys") :: number?) or 0
	if k > lastKeys then
		Theme.playSound(Config.Sounds.KeyPickup, 0.6, 1 + math.random() * 0.1)
	end
	lastKeys = k
end)

local function refreshCard()
	local lvl = player:GetAttribute("Level") or 1
	levelText.Text = tostring(lvl)
	titleText.Text = player:GetAttribute("Title") or "CADET"
	creditsText.Text = `◆ {player:GetAttribute("Credits") or 0}`
	keysText.Text = `🔑 {player:GetAttribute("Keys") or 0}`
end
for _, a in { "Level", "Title", "Credits", "Keys" } do
	player:GetAttributeChangedSignal(a):Connect(refreshCard)
end
refreshCard()

-- Owned perks (row of chips above the upgrade button)
local Perks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Perks"))
local perkRow = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -118), Size = UDim2.fromOffset(300, 34),
	BackgroundTransparency = 1, Parent = gui })
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = perkRow })
local function refreshPerks()
	for _, c in perkRow:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local owned = Perks.decode(player:GetAttribute("Perks") :: string?)
	for _, perk in Perks.List do
		local n = owned[perk.id]
		if n and n > 0 then
			local chip = make("Frame", { Size = UDim2.fromOffset(32, 32), BackgroundColor3 = C.Panel, BackgroundTransparency = 0.15, Parent = perkRow },
				{ Theme.corner(6), Theme.stroke(Perks.Rarity[perk.rarity].color, 0.1, 1.5) })
			text({ Font = F.Heavy, TextSize = 16, TextColor3 = Perks.Rarity[perk.rarity].color, TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1), Text = perk.icon, Parent = chip })
			if n > 1 then
				text({ Font = F.Bold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -2, 1, 0), Size = UDim2.fromOffset(14, 12), Text = tostring(n), TextStrokeTransparency = 0.3, Parent = chip })
			end
		end
	end
end
player:GetAttributeChangedSignal("Perks"):Connect(refreshPerks)
refreshPerks()

-- XP bar (bottom center)
local xpBar = Theme.bar({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.fromOffset(420, 12), Parent = gui }, C.Accent)
local function refreshXP()
	local xp = player:GetAttribute("XP") or 0
	local need = player:GetAttribute("XPNeeded") or 100
	xpBar:set(xp / need, `XP {xp} / {need}`)
end
player:GetAttributeChangedSignal("XP"):Connect(refreshXP)
player:GetAttributeChangedSignal("XPNeeded"):Connect(refreshXP)
refreshXP()

RunService.Heartbeat:Connect(function()
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local frac = humanoid.Health / math.max(humanoid.MaxHealth, 1)
		healthBar.fill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
		healthBar.label.Text = `{math.ceil(humanoid.Health)} / {math.floor(humanoid.MaxHealth)}`
		healthBar.fill.BackgroundColor3 = if frac < 0.3 then C.Danger elseif frac < 0.6 then C.Gold else C.Good
	end
end)

-- Center banner -------------------------------------------------------------------------------------------
local banner = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(700, 120),
	BackgroundTransparency = 1, Visible = false, Parent = gui })
local bannerTitle = text({ Font = F.Title, TextSize = 56, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 70),
	TextStrokeTransparency = 0.2, Parent = banner })
local bannerLine = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.fromOffset(0, 3),
	BorderSizePixel = 0, BackgroundColor3 = C.Accent, Parent = banner })
local bannerSub = text({ Font = F.Meme, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 84),
	Size = UDim2.new(1, 0, 0, 28), TextColor3 = C.Cream, TextStrokeTransparency = 0.4, Parent = banner })
local STYLE = { wave = C.Accent, boss = C.Danger, clear = C.Good, outage = C.Muted, gold = C.Gold }
local bannerToken = 0
Remotes:WaitForChild("Announce").OnClientEvent:Connect(function(title: string, sub: string, style: string)
	bannerToken += 1
	local token = bannerToken
	local color = STYLE[style] or C.Accent
	bannerTitle.Text = title
	bannerTitle.TextColor3 = if style == "boss" then C.Danger else C.Text
	bannerSub.Text = sub
	bannerLine.BackgroundColor3 = color
	banner.Visible = true
	bannerTitle.TextTransparency = 1
	bannerSub.TextTransparency = 1
	banner.Position = UDim2.fromScale(0.5, 0.29)
	bannerLine.Size = UDim2.fromOffset(0, 3)
	Theme.tween(banner, 0.35, { Position = UDim2.fromScale(0.5, 0.32) }, Enum.EasingStyle.Back)
	Theme.tween(bannerTitle, 0.25, { TextTransparency = 0 })
	Theme.tween(bannerLine, 0.5, { Size = UDim2.fromOffset(420, 3) })
	task.delay(0.15, function()
		Theme.tween(bannerSub, 0.3, { TextTransparency = 0 })
	end)
	Theme.playSound(Config.Sounds.WaveStart, 0.7)
	task.delay(3.2, function()
		if token == bannerToken then
			Theme.tween(bannerTitle, 0.4, { TextTransparency = 1 })
			Theme.tween(bannerSub, 0.4, { TextTransparency = 1 })
			Theme.tween(bannerLine, 0.4, { Size = UDim2.fromOffset(0, 3) })
			task.wait(0.45)
			if token == bannerToken then
				banner.Visible = false
			end
		end
	end)
end)

-- Narrator bar (bottom center) ---------------------------------------------------------------------------------
local narrator = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), Size = UDim2.fromOffset(620, 50),
	BackgroundTransparency = 1, Visible = false, Parent = gui })
make("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = C.Text, BorderSizePixel = 0, Parent = narrator })
local narration = text({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 1, -8), TextSize = 18, TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top, TextStrokeTransparency = 0.5, Parent = narrator })
local narrateToken = 0
Remotes:WaitForChild("Narrate").OnClientEvent:Connect(function(msg: string)
	narrateToken += 1
	local token = narrateToken
	narrator.Visible = true
	for i = 1, #msg do
		if token ~= narrateToken then
			return
		end
		narration.Text = string.sub(msg, 1, i)
		task.wait(0.018)
	end
	task.wait(4.5)
	if token == narrateToken then
		narrator.Visible = false
	end
end)

-- Toasts (right side) ---------------------------------------------------------------------------------------------
local toasts = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 120), Size = UDim2.fromOffset(320, 300),
	BackgroundTransparency = 1, Parent = gui })
make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = toasts })
local TOAST = { red = C.Danger, green = C.Good, gold = C.Gold, cyan = C.Cyan, white = C.Text, yellow = C.Gold }
Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(msg: string, color: string?)
	local col = TOAST[color or "white"] or C.Text
	local t = Theme.panel({ Size = UDim2.fromOffset(300, 34), Parent = toasts })
	make("Frame", { Size = UDim2.new(0, 4, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = col, BorderSizePixel = 0, Parent = t }, { Theme.corner(2) })
	text({ Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -24, 1, 0), TextSize = 14, Font = F.Bold, Text = msg,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = t })
	local kids = toasts:GetChildren()
	if #kids > 5 then
		for _, k in kids do
			if k:IsA("Frame") then
				k:Destroy()
				break
			end
		end
	end
	task.delay(4, function()
		if t.Parent then
			Theme.tween(t, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			t:Destroy()
		end
	end)
end)

-- Level up -------------------------------------------------------------------------------------------------------------
Remotes:WaitForChild("LevelUp").OnClientEvent:Connect(function(level: number, title: string)
	local f = Theme.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromOffset(0, 70), Parent = gui })
	f.ClipsDescendants = true
	text({ Font = F.Title, TextSize = 26, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 4), Text = `LEVEL {level}`, Parent = f })
	text({ Font = F.Bold, TextSize = 14, TextColor3 = C.Cream, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 42), Text = title .. "  ·  +1% DAMAGE", Parent = f })
	Theme.tween(f, 0.35, { Size = UDim2.fromOffset(340, 70) }, Enum.EasingStyle.Back)
	Theme.playSound(Config.Sounds.LevelUp, 0.8)
	task.delay(2.6, function()
		Theme.tween(f, 0.25, { Size = UDim2.fromOffset(0, 70) })
		task.wait(0.3)
		f:Destroy()
	end)
end)

-- Hurt flash + downed screen ------------------------------------------------------------------------------------------
local hurt = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Danger, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0, Parent = gui })
Remotes:WaitForChild("PlayerHurt").OnClientEvent:Connect(function(_damage: number)
	hurt.BackgroundTransparency = 0.75
	Theme.tween(hurt, 0.4, { BackgroundTransparency = 1 })
end)

local downed = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(60, 0, 0), BackgroundTransparency = 0.55,
	BorderSizePixel = 0, Visible = false, ZIndex = 20, Parent = gui })
text({ Font = F.Meme, TextSize = 64, TextColor3 = C.Danger, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(800, 70), Text = "SUIT INTEGRITY CRITICAL", ZIndex = 21, Parent = downed })
local downedSub = text({ Font = F.Title, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(800, 30), ZIndex = 21, Parent = downed })
RunService.Heartbeat:Connect(function()
	local isDown = player:GetAttribute("Downed") == true
	downed.Visible = isDown
	if isDown then
		local untilT = player:GetAttribute("DownedUntil") or 0
		local left = math.max(0, math.ceil(untilT - workspace:GetServerTimeNow()))
		downedSub.Text = `YOU'RE DOWN · A CREWMATE CAN REVIVE YOU · {left}s`
	end
end)

-- hide the revive prompt on your own body
local function hideOwnPrompt(character: Model)
	local hrp = character:WaitForChild("HumanoidRootPart", 5)
	if hrp then
		hrp.ChildAdded:Connect(function(c)
			if c:IsA("ProximityPrompt") then
				c.Enabled = false
			end
		end)
	end
end
if player.Character then
	task.spawn(hideOwnPrompt, player.Character)
end
player.CharacterAdded:Connect(hideOwnPrompt)

-- Game over ------------------------------------------------------------------------------------------------------------
local over = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 4, 10), BackgroundTransparency = 0.1,
	BorderSizePixel = 0, Visible = false, ZIndex = 30, Parent = gui })
local overTitle = text({ Font = F.Meme, TextSize = 30, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromScale(0, 0.1), Size = UDim2.new(1, 0, 0, 34), ZIndex = 31, Text = "THE INCIDENT WAS NEVER REPORTED", Parent = over })
local overWave = text({ Font = F.Title, TextSize = 64, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromScale(0, 0.16), Size = UDim2.new(1, 0, 0, 76), ZIndex = 31, Parent = over })
local overReason = text({ Font = F.Bold, TextSize = 18, TextColor3 = C.Danger, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromScale(0, 0.27), Size = UDim2.new(1, 0, 0, 24), ZIndex = 31, Parent = over })
local overGrid = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.9, 0.5),
	BackgroundTransparency = 1, ZIndex = 31, Parent = over })
make("UIGridLayout", { CellSize = UDim2.fromOffset(170, 230), CellPadding = UDim2.fromOffset(16, 16),
	HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = overGrid })

Remotes:WaitForChild("GameOver").OnClientEvent:Connect(function(summary: any)
	for _, c in overGrid:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	overWave.Text = `WAVE {summary.wave}`
	overReason.Text = summary.reason
	for _, m in summary.crew do
		local isMvp = m.userId == summary.mvp and m.kills > 0
		local cell = Theme.panel({ ZIndex = 31, Parent = overGrid })
		local stroke = cell:FindFirstChildOfClass("UIStroke")
		if stroke and isMvp then
			stroke.Color = C.Gold
			stroke.Transparency = 0
			stroke.Thickness = 2.5
		end
		local img = make("ImageLabel", { Position = UDim2.fromOffset(25, 14), Size = UDim2.fromOffset(120, 120), BackgroundColor3 = C.Bg,
			ImageColor3 = if isMvp then Color3.new(1, 1, 1) else Color3.fromRGB(170, 170, 170), ZIndex = 32, Parent = cell }, { Theme.corner(10) })
		task.spawn(function()
			img.Image = headshot(m.userId)
		end)
		text({ Font = F.Bold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 18),
			Text = string.upper(m.name), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 32, Parent = cell })
		text({ Font = F.Mono, TextSize = 14, TextColor3 = C.Cream, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 162),
			Size = UDim2.new(1, 0, 0, 36), Text = `{m.kills} KEIS\n{m.damage} DMG`, ZIndex = 32, Parent = cell })
		text({ Font = F.Meme, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 202), Size = UDim2.new(1, 0, 0, 18),
			TextColor3 = if isMvp then C.Gold else C.Muted, Text = if isMvp then "THE TRUE SURVIVOR" else "DECEASED", ZIndex = 32, Parent = cell })
	end
	over.Visible = true
	over.BackgroundTransparency = 1
	Theme.tween(over, 0.6, { BackgroundTransparency = 0.1 })
	task.wait(Config.GAMEOVER_TIME - 0.5)
	over.Visible = false
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001B"><Properties><string name="Name">KeisAnimator</string><ProtectedString name="Source"><![CDATA[--!strict
-- Animates the Keis' spider legs on each client (tripod gait), so the server only moves the body.

local RunService = game:GetService("RunService")

local camera = workspace.CurrentCamera
local MAX_DISTANCE = 140

type Rig = { root: BasePart, legs: { { motor: Motor6D, group: number, side: number } }, phase: number }
local rigs: { [Model]: Rig } = {}

local function register(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local root = model:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not root then
		return
	end
	task.wait() -- let the motors replicate
	local legs = {}
	for _, m in root:GetChildren() do
		if m:IsA("Motor6D") and string.sub(m.Name, 1, 3) == "Leg" then
			local index = tonumber(string.sub(m.Name, 4)) or 1
			table.insert(legs, { motor = m, group = (m:GetAttribute("Group") :: number?) or (index % 2), side = if index <= 3 then 1 else -1 })
		end
	end
	if #legs > 0 then
		rigs[model] = { root = root, legs = legs, phase = math.random() * math.pi * 2 }
	end
end

local function watch(folder: Instance)
	for _, m in folder:GetChildren() do
		task.spawn(register, m)
	end
	folder.ChildAdded:Connect(function(m)
		task.spawn(register, m)
	end)
	folder.ChildRemoved:Connect(function(m)
		rigs[m :: Model] = nil
	end)
end

task.spawn(function()
	watch(workspace:WaitForChild("Keis"))
end)

RunService.RenderStepped:Connect(function(dt)
	local camPos = camera.CFrame.Position
	for model, rig in rigs do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		if (rig.root.Position - camPos).Magnitude > MAX_DISTANCE then
			continue
		end
		local v = rig.root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local moving = math.clamp(speed / 10, 0, 1)
		rig.phase += dt * (3 + speed * 0.9)
		for _, leg in rig.legs do
			local p = rig.phase + (if leg.group == 1 then math.pi else 0)
			local swing = math.sin(p) * 0.45 * moving + math.sin(rig.phase * 7 + leg.side) * 0.03 -- twitch when idle
			local lift = math.max(0, math.cos(p)) * 0.35 * moving
			leg.motor.Transform = CFrame.Angles(0, swing * leg.side, 0) * CFrame.Angles(0, 0, lift)
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001C"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--!strict
-- Start menu: a live 3D scene (Keis standing on rock, Jupiter behind them), title, PLAY.
-- Also plays full-screen transitions (e.g. the landing on Io).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local KeisModel = require(Shared:WaitForChild("KeisModel"))
local SpaceArt = require(Shared:WaitForChild("SpaceArt"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Fader (also used for in-game transitions) ---------------------------------------------------
local fadeGui = make("ScreenGui", { Name = "Fader", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100,
	Parent = player:WaitForChild("PlayerGui") })
local fader = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
	BorderSizePixel = 0, Parent = fadeGui })
local fadeText = text({ Font = F.Title, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(900, 40), TextTransparency = 1, Parent = fadeGui })

local function fadeTo(alpha: number, seconds: number)
	Theme.tween(fader, seconds, { BackgroundTransparency = 1 - alpha })
	task.wait(seconds)
end

Remotes:WaitForChild("Transition").OnClientEvent:Connect(function(msg: string, seconds: number)
	fadeTo(1, 1)
	fadeText.Text = msg
	Theme.tween(fadeText, 0.5, { TextTransparency = 0 })
	task.wait(math.max(seconds - 1.5, 0.5))
	Theme.tween(fadeText, 0.5, { TextTransparency = 1 })
	fadeTo(0, 1.2)
end)

-- The scene ---------------------------------------------------------------------------------------
local P = Vector3.new(0, 400, 7000) -- far away from the ship and Io
local scene = Instance.new("Folder")
scene.Name = "MenuScene"
scene.Parent = workspace

local function rock(size: Vector3, cf: CFrame, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.Basalt
	p.Parent = scene
end

local rng = Random.new(77)
rock(Vector3.new(140, 6, 70), CFrame.new(P + Vector3.new(0, -3, 6)), Color3.fromRGB(58, 48, 40))
for _ = 1, 26 do
	local s = rng:NextNumber(3, 12)
	rock(Vector3.new(s, s * rng:NextNumber(0.4, 0.9), s * rng:NextNumber(0.7, 1.3)),
		CFrame.new(P + Vector3.new(rng:NextNumber(-60, 60), rng:NextNumber(-1, 1), rng:NextNumber(-8, 38)))
			* CFrame.Angles(rng:NextNumber(0, 0.6), rng:NextNumber(0, 6), rng:NextNumber(0, 0.6)),
		Color3.fromRGB(rng:NextInteger(60, 100), rng:NextInteger(48, 70), rng:NextInteger(36, 50)))
end
-- glowing fissure behind the Keis
local crack = Instance.new("Part")
crack.Anchored = true
crack.CanCollide = false
crack.Size = Vector3.new(60, 0.3, 2)
crack.CFrame = CFrame.new(P + Vector3.new(0, 0.1, 10)) * CFrame.Angles(0, math.rad(4), 0)
crack.Material = Enum.Material.Neon
crack.Color = Color3.fromRGB(255, 60, 30)
crack.Parent = scene
local fl = Instance.new("PointLight")
fl.Color = Color3.fromRGB(255, 70, 40)
fl.Range = 40
fl.Brightness = 3
fl.Parent = crack

-- key light on the Keis' faces (from the camera side) + red rim lights from below
local key = Instance.new("Part")
key.Anchored = true
key.CanCollide = false
key.Transparency = 1
key.CFrame = CFrame.lookAt(P + Vector3.new(-12, 18, -30), P + Vector3.new(0, 6, 0))
key.Parent = scene
local spot = Instance.new("SpotLight")
spot.Face = Enum.NormalId.Front
spot.Range = 60
spot.Angle = 70
spot.Brightness = 2.2
spot.Color = Color3.fromRGB(200, 220, 255)
spot.Shadows = true
spot.Parent = key

-- the Keis lineup (boss in the middle)
local lineup = {
	{ "Master", Vector3.new(0, 0, 4) },
	{ "Basic", Vector3.new(-10, 0, 0) },
	{ "Basic", Vector3.new(10, 0, -1) },
	{ "Skeleton", Vector3.new(-19, 0, 5) },
	{ "Iron", Vector3.new(20, 0, 6) },
	{ "Keyring", Vector3.new(-30, 0, 12) },
}
local menuKeis = {}
for _, entry in lineup do
	local def = (Config.KeisTypes :: any)[entry[1]]
	local model, _, root, _, _, chant = KeisModel.build(def, P + entry[2])
	root.Anchored = true
	root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(rng:NextNumber(-12, 12)), 0)
	model.Parent = scene
	local motors = {}
	for _, m in root:GetChildren() do
		if m:IsA("Motor6D") then
			table.insert(motors, m)
		end
	end
	table.insert(menuKeis, { chant = chant, motors = motors, phase = rng:NextNumber(0, 6) })
end

-- Jupiter rising behind them + stars
local jc, jr = P + Vector3.new(-160, 210, 1000), 480
SpaceArt.jupiter(scene, jc, jr, P + Vector3.new(0, 6, -40), 1)
SpaceArt.stars(scene, P, 1600, 450, 3, jc, jr * 2.1)

-- UI ---------------------------------------------------------------------------------------------
local gui = make("ScreenGui", { Name = "Menu", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 50,
	Parent = player:WaitForChild("PlayerGui") })
local uiScale = make("UIScale", { Parent = gui })
make("Frame", { Size = UDim2.fromScale(0.55, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui }, {
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) }) }),
})
local column = make("Frame", { Position = UDim2.new(0, 70, 0.5, -230), Size = UDim2.fromOffset(520, 520), BackgroundTransparency = 1, Parent = gui })
text({ Font = F.Mono, TextSize = 16, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 20), Text = "RECOVERED FOOTAGE · USS KEPLER · 07/14/2011", Parent = column })
local title = text({ Font = F.Title, TextSize = 92, Position = UDim2.fromOffset(-4, 22), Size = UDim2.new(1, 0, 0, 100), Text = "JUPITER",
	TextStrokeTransparency = 0.6, Parent = column })
text({ Font = F.Title, TextSize = 34, TextColor3 = C.Danger, Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, 0, 0, 40),
	Text = "2011 INCIDENT", Parent = column })
local chantLine = text({ Font = F.Mono, TextSize = 16, TextColor3 = C.Danger, Position = UDim2.fromOffset(0, 168), Size = UDim2.new(1, 0, 0, 20),
	Text = "keis keis keis o algo o algo", TextTransparency = 0.4, Parent = column })

local function button(label: string, y: number, primary: boolean): TextButton
	local b = make("TextButton", {
		Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(primary and 300 or 240, primary and 64 or 46),
		BackgroundColor3 = if primary then C.Accent else C.Panel, BackgroundTransparency = if primary then 0 else 0.2,
		Text = label, Font = F.Title, TextSize = primary and 24 or 15, TextColor3 = if primary then C.Bg else C.Text,
		AutoButtonColor = true, Parent = column,
	}, { Theme.corner(8), Theme.stroke(C.Accent, if primary then 1 else 0.5, 1.5) })
	b.MouseEnter:Connect(function()
		Theme.tween(b, 0.15, { Position = UDim2.fromOffset(10, y) })
	end)
	b.MouseLeave:Connect(function()
		Theme.tween(b, 0.15, { Position = UDim2.fromOffset(0, y) })
	end)
	return b
end
local playBtn = button("PLAY", 222, true)
local howBtn = button("HOW TO PLAY", 302, false)

-- saved stats card
local stats = Theme.panel({ Position = UDim2.fromOffset(0, 370), Size = UDim2.fromOffset(300, 92), Parent = column })
local statLevel = text({ Font = F.Title, TextSize = 18, TextColor3 = C.Accent, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 22), Parent = stats })
local statBest = text({ Font = F.Body, TextSize = 15, Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 18), Parent = stats })
local statXp = Theme.bar({ Position = UDim2.fromOffset(16, 66), Size = UDim2.new(1, -32, 0, 10), Parent = stats }, C.Accent)
local function refreshStats()
	statLevel.Text = `LV {player:GetAttribute("Level") or 1} · {player:GetAttribute("Title") or "CADET"}`
	statBest.Text = `BEST WAVE  {player:GetAttribute("BestWave") or 0}`
	statXp:set((player:GetAttribute("XP") or 0) / math.max(player:GetAttribute("XPNeeded") or 100, 1))
end
player.AttributeChanged:Connect(refreshStats)
refreshStats()

local how = Theme.panel({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -60, 0.5, 0), Size = UDim2.fromOffset(420, 330), Visible = false, Parent = gui })
text({ Font = F.Title, TextSize = 18, Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 24), Text = "HOW TO PLAY", Parent = how })
text({ Font = F.Body, TextSize = 15, Position = UDim2.fromOffset(20, 50), Size = UDim2.new(1, -40, 1, -60), TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = C.Cream, Parent = how,
	Text = "The Keis crawl out of the vents in waves. Keep them away from the reactor and keep your crew alive.\n\n"
		.. "• Hold click to fire · Right-click to aim · R reload\n"
		.. "• Shift to sprint · Q / E to lean around corners\n"
		.. "• Shoot a Keis in the mouth for a CRIT\n"
		.. "• Upgrade and add scopes, lasers and barrels at the ARMORY bench on the bridge\n"
		.. "• Hold E on a downed crewmate to revive them\n"
		.. "• Survive wave 10 and the ship lands on Io, Jupiter's volcanic moon. Low gravity." })
howBtn.MouseButton1Click:Connect(function()
	how.Visible = not how.Visible
end)

-- Menu lifecycle ----------------------------------------------------------------------------------
local menuOpen = true
local HIDE = { "HUD", "Combat", "Atmosphere", "Scope" }
local function setGameGuis(enabled: boolean)
	for _, name in HIDE do
		local g = player.PlayerGui:FindFirstChild(name)
		if g and g:IsA("ScreenGui") then
			g.Enabled = enabled
		end
	end
end
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false) -- we draw our own health bar
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local chantSound: Sound? = nil
if Config.Sounds.KeisChant ~= "" then
	chantSound = make("Sound", { SoundId = Config.Sounds.KeisChant, Volume = 0.6, PlaybackSpeed = 0.9, Parent = SoundService })
end

local start = os.clock()
local nextChant = os.clock() + 2
RunService:BindToRenderStep("JupiterMenu", Enum.RenderPriority.Camera.Value + 5, function()
	if not menuOpen then
		return
	end
	setGameGuis(false)
	uiScale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.2)
	local t = os.clock() - start
	camera.CameraType = Enum.CameraType.Scriptable
	local eye = P + Vector3.new(math.sin(t * 0.08) * 7, 6.5 + math.sin(t * 0.13) * 0.8, -40 + math.sin(t * 0.05) * 3)
	camera.CFrame = CFrame.lookAt(eye, P + Vector3.new(-4, 9, 30))
	camera.FieldOfView = 60
	for _, k in menuKeis do
		k.phase += 0.016
		for i, m in k.motors do
			m.Transform = CFrame.Angles(0, math.sin(k.phase * 2 + i) * 0.06, math.sin(k.phase * 3 + i * 2) * 0.05)
		end
	end
	title.TextTransparency = if math.random() < 0.015 then 0.5 else 0
	chantLine.TextTransparency = 0.3 + math.abs(math.sin(t * 1.5)) * 0.5
	if os.clock() >= nextChant then
		nextChant = os.clock() + 7
		for _, k in menuKeis do
			k.chant.Text = if math.random() < 0.6 then Config.KeisChatter[math.random(1, #Config.KeisChatter)] else ""
		end
		if chantSound then
			chantSound:Play()
		end
	end
end)

playBtn.MouseButton1Click:Connect(function()
	if not menuOpen then
		return
	end
	playBtn.Active = false
	fadeTo(1, 0.6)
	menuOpen = false
	RunService:UnbindFromRenderStep("JupiterMenu")
	gui:Destroy()
	scene:Destroy()
	if chantSound then
		chantSound:Destroy()
	end
	Remotes:WaitForChild("PlayRequest"):FireServer()
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid", 10)
	camera.CameraType = Enum.CameraType.Custom
	if humanoid then
		camera.CameraSubject = humanoid :: Humanoid
	end
	camera.FieldOfView = 70
	setGameGuis(true)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
	end)
	task.wait(0.3)
	fadeTo(0, 0.8)
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001D"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!strict
-- Movement feel: sprint, head bob, hit shake, moon dust. (First person + aiming: Viewmodel.client)

local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local SPRINT_MULT = 1.45


local sprinting = false
local sprintBase = 16
local offset = Vector3.zero
local shake = 0
local bobT = 0

local function getHumanoid(): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function hasWeapon(): boolean
	local c = player.Character
	if not c then
		return false
	end
	for _, t in c:GetChildren() do
		if t:IsA("Tool") and t:GetAttribute("IsWeapon") then
			return true
		end
	end
	return false
end

local function setSprint(on: boolean)
	local humanoid = getHumanoid()
	if not humanoid or player:GetAttribute("Downed") then
		on = false
	end
	if on == sprinting then
		return
	end
	sprinting = on
	player:SetAttribute("Sprinting", on) -- local only; Combat.client won't fire while sprinting
	if humanoid then
		if on then
			sprintBase = humanoid.WalkSpeed
			humanoid.WalkSpeed = sprintBase * SPRINT_MULT
		else
			humanoid.WalkSpeed = sprintBase
		end
	end
end

ContextActionService:BindAction("JupiterSprint", function(_, state)
	setSprint(state == Enum.UserInputState.Begin)
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
ContextActionService:SetTitle("JupiterSprint", "RUN")

player.CharacterAdded:Connect(function()
	sprinting = false
	player:SetAttribute("Sprinting", false)
end)

Remotes:WaitForChild("PlayerHurt").OnClientEvent:Connect(function(damage: number)
	shake = math.clamp(0.15 + damage / 60, 0.15, 0.6)
end)

-- moon dust ---------------------------------------------------------------------------------------
local lastDust = 0
local wasAirborne = false
local function puff(pos: Vector3, size: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(210, 180, 110)
	p.Transparency = 0.45
	p.Size = Vector3.one * size
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.one * size * 3, Transparency = 1, CFrame = CFrame.new(pos + Vector3.new(0, size, 0)) }):Play()
	Debris:AddItem(p, 1.3)
end

RunService:BindToRenderStep("JupiterMovement", Enum.RenderPriority.Camera.Value + 2, function(dt)
	local character = player.Character
	local humanoid = getHumanoid()
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or camera.CameraType ~= Enum.CameraType.Custom then
		return
	end
	-- (first person + aiming live in Viewmodel.client)

	-- walking bob
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local amount = math.clamp(speed / 16, 0, 1.6)
	bobT += dt * (if sprinting then 11 else 8)
	local bob = if humanoid.FloorMaterial ~= Enum.Material.Air
		then Vector3.new(math.sin(bobT) * 0.07, math.abs(math.cos(bobT)) * 0.1, 0) * amount
		else Vector3.zero
	offset = offset:Lerp(bob * 0.6, math.min(dt * 10, 1)) -- a little head bob
	humanoid.CameraOffset = offset

	-- hit shake
	if shake > 0 then
		shake = math.max(0, shake - dt)
		local a = shake * 0.03
		camera.CFrame *= CFrame.Angles((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a)
	end

	-- dust on Io: footsteps + landings
	if ReplicatedStorage:GetAttribute("Stage") == "Moon" then
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local feet = root.Position - Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2 - 0.3, 0)
		if grounded and wasAirborne then
			for _ = 1, 5 do
				puff(feet + Vector3.new(math.random(-15, 15) / 10, 0, math.random(-15, 15) / 10), 1.6)
			end
		elseif grounded and speed > 4 and os.clock() - lastDust > 0.28 then
			lastDust = os.clock()
			puff(feet, 0.9)
		end
		wasAirborne = not grounded
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001E"><Properties><string name="Name">PerkPicker</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pick-1-of-3 perk cards after each wave (and from crates). Keys 1/2/3 to pick, reroll costs 1 key.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local Perks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Perks"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C, F = Theme.Colors, Theme.Fonts
local make, text = Theme.make, Theme.text

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local PickPerk = Remotes:WaitForChild("PickPerk") :: RemoteEvent
local RerollPerk = Remotes:WaitForChild("RerollPerk") :: RemoteEvent

local gui = make("ScreenGui", { Name = "PerkPicker", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Enabled = false,
	Parent = player:WaitForChild("PlayerGui") })
local scale = make("UIScale", { Parent = gui })
RunService.RenderStepped:Connect(function()
	scale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.1)
end)
-- a Modal button frees the mouse while in first person
make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0,
	Text = "", AutoButtonColor = false, Modal = true, Parent = gui })
local header = text({ Font = F.Title, TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.2), Size = UDim2.fromOffset(900, 44), Text = "CHOOSE A PERK", Parent = gui })
local subheader = text({ Font = F.Mono, TextSize = 16, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.25), Size = UDim2.fromOffset(900, 20), Text = "PRESS 1 · 2 · 3", Parent = gui })
local row = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53), Size = UDim2.fromOffset(780, 330),
	BackgroundTransparency = 1, Parent = gui })
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 24), Parent = row })
local reroll = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.78), Size = UDim2.fromOffset(240, 44),
	BackgroundColor3 = C.Panel, Text = "REROLL · 1 KEY", Font = F.Title, TextSize = 14, TextColor3 = C.Gold, Parent = gui },
	{ Theme.corner(8), Theme.stroke(C.Gold, 0.4, 1.5) })

local currentId = 0
local currentCards: { string } = {}
local shimmer: { UIGradient } = {}

local function close()
	gui.Enabled = false
	player:SetAttribute("UIOpen", false)
	currentId = 0
end

local function choose(index: number)
	if currentId == 0 or not currentCards[index] then
		return
	end
	PickPerk:FireServer(currentId, index)
	close()
end

local function build(cards: { string }, rarityOnly: string?)
	for _, c in row:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	shimmer = {}
	header.Text = if rarityOnly == "Legendary" then "LEGENDARY CHOICE" else "CHOOSE A PERK"
	header.TextColor3 = if rarityOnly == "Legendary" then C.Gold else C.Text
	local owned = Perks.decode(player:GetAttribute("Perks") :: string?)
	for i, id in cards do
		local perk = Perks.byId[id]
		local rarity = Perks.Rarity[perk.rarity]
		local card = make("TextButton", { Size = UDim2.fromOffset(240, 320), BackgroundColor3 = C.Panel, AutoButtonColor = false, Text = "",
			LayoutOrder = i, Parent = row }, { Theme.corner(14) })
		local stroke = Theme.stroke(rarity.color, 0, if perk.rarity == "Legendary" then 3 else 2)
		stroke.Parent = card
		if perk.rarity == "Legendary" then
			local g = make("UIGradient", { Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, rarity.color), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(1, rarity.color) }),
				Parent = stroke })
			table.insert(shimmer, g)
		end
		make("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = rarity.color, BorderSizePixel = 0, Parent = card }, { Theme.corner(3) })
		text({ Font = F.Mono, TextSize = 14, TextColor3 = rarity.color, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 16),
			Size = UDim2.new(1, 0, 0, 18), Text = rarity.label, Parent = card })
		text({ Font = F.Heavy, TextSize = 64, TextColor3 = rarity.color, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 44),
			Size = UDim2.new(1, 0, 0, 80), Text = perk.icon, Parent = card })
		text({ Font = F.Title, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 136),
			Size = UDim2.new(1, -20, 0, 40), TextWrapped = true, Text = perk.name, Parent = card })
		text({ Font = F.Body, TextSize = 15, TextColor3 = C.Cream, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(16, 184), Size = UDim2.new(1, -32, 0, 70), TextWrapped = true, Text = perk.desc, Parent = card })
		text({ Font = F.Mono, TextSize = 14, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -50),
			Size = UDim2.new(1, 0, 0, 18), Text = `STACK {(owned[id] or 0) + 1} / {perk.max}`, Parent = card })
		text({ Font = F.Title, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -28),
			Size = UDim2.new(1, 0, 0, 18), Text = `[{i}]`, Parent = card })
		card.MouseEnter:Connect(function()
			Theme.tween(card, 0.12, { Size = UDim2.fromOffset(252, 336) })
		end)
		card.MouseLeave:Connect(function()
			Theme.tween(card, 0.12, { Size = UDim2.fromOffset(240, 320) })
		end)
		card.MouseButton1Click:Connect(function()
			choose(i)
		end)
		-- deal the cards in
		card.Position = UDim2.fromOffset(0, 60)
		card.BackgroundTransparency = 1
		task.delay((i - 1) * 0.08, function()
			Theme.tween(card, 0.3, { BackgroundTransparency = 0.05 }, Enum.EasingStyle.Back)
		end)
	end
end

Remotes:WaitForChild("PerkOffer").OnClientEvent:Connect(function(offerId: number, cards: { string }, rarityOnly: string?)
	if offerId == 0 or #cards == 0 then
		close()
		return
	end
	currentId = offerId
	currentCards = cards
	build(cards, rarityOnly)
	gui.Enabled = true
	player:SetAttribute("UIOpen", true) -- Movement.client frees the mouse while this is open
end)

reroll.MouseButton1Click:Connect(function()
	if currentId ~= 0 and ((player:GetAttribute("Keys") :: number?) or 0) >= 1 then
		RerollPerk:FireServer(currentId)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not gui.Enabled then
		return
	end
	local map = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
	local idx = map[input.KeyCode]
	if idx then
		choose(idx)
	end
end)

RunService.RenderStepped:Connect(function()
	if not gui.Enabled then
		return
	end
	local keys = (player:GetAttribute("Keys") :: number?) or 0
	reroll.Text = `REROLL · 1 KEY  (YOU HAVE {keys})`
	reroll.TextTransparency = if keys >= 1 then 0 else 0.5
	for _, g in shimmer do
		g.Rotation = (os.clock() * 120) % 360
	end
	subheader.Text = "PRESS 1 · 2 · 3   ·   THE KEIS DON'T WAIT"
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000001F"><Properties><string name="Name">ShipFX</string><ProtectedString name="Source"><![CDATA[--!strict
-- Local ship effects: sliding doors (with sound), console flicker, fans, LEDs, gauges, background ambience.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local TweenService = game:GetService("TweenService")

local OPEN_RANGE = 12
local TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

type Door = { leaves: { BasePart }, center: Vector3, open: boolean }
local doors: { [string]: Door } = {}

local function addLeaf(p: Instance)
	if not p:IsA("BasePart") then
		return
	end
	local center = p:GetAttribute("DoorCenter") :: Vector3?
	if not center then
		return
	end
	local key = string.format("%.1f|%.1f|%.1f", center.X, center.Y, center.Z)
	local d = doors[key]
	if not d then
		d = { leaves = {}, center = center, open = false }
		doors[key] = d
	end
	table.insert(d.leaves, p)
end
for _, p in CollectionService:GetTagged("DoorLeaf") do
	addLeaf(p)
end
CollectionService:GetInstanceAddedSignal("DoorLeaf"):Connect(addLeaf)

local function positions(): { Vector3 }
	local list = {}
	for _, pl in Players:GetPlayers() do
		local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			table.insert(list, hrp.Position)
		end
	end
	local keis = workspace:FindFirstChild("Keis")
	if keis then
		for _, m in keis:GetChildren() do
			local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				table.insert(list, root.Position)
			end
		end
	end
	return list
end

task.spawn(function()
	while true do
		local pos = positions()
		for _, d in doors do
			local near = false
			for _, p in pos do
				if (p - d.center).Magnitude < OPEN_RANGE then
					near = true
					break
				end
			end
			if near ~= d.open then
				d.open = near
				if Config.Sounds.Door ~= "" and d.leaves[1] and d.leaves[1].Parent then
					local snd = Instance.new("Sound")
					snd.SoundId = Config.Sounds.Door
					snd.Volume = 0.5
					snd.RollOffMaxDistance = 40
					snd.Parent = d.leaves[1]
					snd:Play()
					snd.Ended:Connect(function()
						snd:Destroy()
					end)
				end
				for _, leaf in d.leaves do
					if leaf.Parent then
						local closed = leaf:GetAttribute("ClosedCF") :: CFrame
						local offset = leaf:GetAttribute("OpenOffset") :: Vector3
						TweenService:Create(leaf, TWEEN, { CFrame = if near then closed + offset else closed }):Play()
					end
				end
			end
		end
		task.wait(0.1)
	end
end)

-- console screens: occasional flicker
task.spawn(function()
	while true do
		local screens = CollectionService:GetTagged("ConsoleScreen")
		if #screens > 0 then
			local s = screens[math.random(1, #screens)]
			local gui = s:FindFirstChildOfClass("SurfaceGui")
			if gui then
				gui.Enabled = false
				task.wait(0.06)
				gui.Enabled = true
			end
		end
		task.wait(math.random() * 0.8 + 0.2)
	end
end)

-- spinning wall fans, blinking LEDs, twitching gauge needles ---------------------------------------------
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	for _, fan in CollectionService:GetTagged("Fan") do
		if fan:IsA("Model") and fan.PrimaryPart then
			fan:PivotTo(fan:GetPivot() * CFrame.Angles(dt * 8, 0, 0))
		end
	end
	for _, led in CollectionService:GetTagged("BlinkLED") do
		if led:IsA("BasePart") then
			local rate = (led:GetAttribute("BlinkRate") :: number?) or 1
			led.Transparency = if (now * rate) % 1 < 0.5 then 0 else 0.85
		end
	end
end)
task.spawn(function()
	while true do
		for _, face in CollectionService:GetTagged("Gauge") do
			local needle = face:FindFirstChild("Needle", true) :: Frame?
			if needle then
				needle.Rotation = math.clamp(needle.Rotation + math.random(-6, 6), -75, 75)
			end
		end
		task.wait(0.15)
	end
end)

-- constant background ambience: ship hum, or the wind on Io
local function loop(id: string, volume: number): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	return s
end
local hum = loop(Config.Sounds.ShipHum, 0.35)
local wind = loop(Config.Sounds.IoWind, 0.45)
RunService.Heartbeat:Connect(function(dt)
	local onMoon = ReplicatedStorage:GetAttribute("Stage") == "Moon"
	local inGame = workspace.CurrentCamera.CameraType == Enum.CameraType.Custom
	if hum then
		hum.Volume += ((if inGame and not onMoon then 0.35 else 0) - hum.Volume) * math.min(dt * 2, 1)
	end
	if wind then
		wind.Volume += ((if inGame and onMoon then 0.45 else 0) - wind.Volume) * math.min(dt * 2, 1)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
-- Shared UI style: dark glass panels, Jupiter-orange accents, sci-fi headings.

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Colors = {
	Bg = Color3.fromRGB(12, 10, 16),
	Panel = Color3.fromRGB(20, 16, 26),
	Accent = Color3.fromRGB(255, 138, 61), -- Jupiter orange
	Cream = Color3.fromRGB(242, 214, 170), -- Jupiter cloud band
	Text = Color3.fromRGB(245, 236, 222),
	Muted = Color3.fromRGB(150, 138, 128),
	Danger = Color3.fromRGB(240, 70, 60),
	Good = Color3.fromRGB(110, 230, 150),
	Gold = Color3.fromRGB(255, 205, 64),
	Cyan = Color3.fromRGB(90, 220, 255),
}

local function font(name: string, fallback: Enum.Font): Enum.Font
	local ok, f = pcall(function()
		return (Enum.Font :: any)[name]
	end)
	return if ok and f then f else fallback
end

Theme.Fonts = {
	Title = font("Michroma", Enum.Font.GothamBlack),
	Heavy = Enum.Font.GothamBlack,
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
	Meme = Enum.Font.Code, -- terminal / security-camera text
	Mono = Enum.Font.Code,
}

-- Theme.make("Frame", {props}, {children})
function Theme.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	return Theme.make("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.stroke(color: Color3?, transparency: number?, thickness: number?): UIStroke
	return Theme.make("UIStroke", {
		Color = color or Theme.Colors.Accent,
		Transparency = transparency or 0.55,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.panel(props: { [string]: any }): Frame
	local p = Theme.make("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
	}, { Theme.corner(10), Theme.stroke() })
	Theme.make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 160, 175)),
		Parent = p,
	})
	for k, v in props do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if props.Parent then
		p.Parent = props.Parent
	end
	return p
end

function Theme.text(props: { [string]: any }): TextLabel
	local l = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Body,
		TextColor3 = Theme.Colors.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(l :: any)[k] = v
		end
	end
	if parent then
		l.Parent = parent
	end
	return l
end

export type Bar = { frame: Frame, fill: Frame, label: TextLabel, set: (self: Bar, fraction: number, text: string?) -> () }

function Theme.bar(props: { [string]: any }, fillColor: Color3): Bar
	local frame = Theme.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(30, 24, 34),
		BorderSizePixel = 0,
	}, { Theme.corner(6), Theme.stroke(Color3.new(0, 0, 0), 0.4, 1) })
	local fill = Theme.make("Frame", {
		BackgroundColor3 = fillColor,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = frame,
	}, { Theme.corner(6) })
	Theme.make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Parent = fill,
	})
	local label = Theme.text({
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		TextStrokeTransparency = 0.5,
		ZIndex = 3,
		Parent = frame,
	})
	for k, v in props do
		if k ~= "Parent" then
			(frame :: any)[k] = v
		end
	end
	if props.Parent then
		frame.Parent = props.Parent
	end
	local bar = { frame = frame, fill = fill, label = label } :: any
	function bar:set(fraction: number, text: string?)
		TweenService:Create(self.fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1) }):Play()
		if text then
			self.label.Text = text
		end
	end
	return bar
end

function Theme.tween(obj: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- plays a configured sound id once (if set)
function Theme.playSound(id: string, volume: number?, speed: number?)
	if id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = speed or 1
	s.Parent = game:GetService("SoundService")
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	task.delay(10, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

return Theme
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000021"><Properties><string name="Name">Viewmodel</string><ProtectedString name="Source"><![CDATA[--!strict
-- First person: weapon viewmodel with arms, sway, bob, recoil, reload/sprint poses, aim down sights (right click),
-- scope overlay, Q/E lean, laser beam, spinning minigun barrels.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local WeaponModel = require(Shared:WaitForChild("WeaponModel"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera


local SUIT = Color3.fromRGB(232, 232, 228)
local GLOVE = Color3.fromRGB(60, 62, 68)
local CUFF = Color3.fromRGB(255, 138, 61)

-- state
local vm: any = nil
local vmKey = ""
local aiming = false
local aimBlend = 0
local leanTarget = 0
local lean = 0
local sway = Vector2.zero
local bobT = 0
local kick = 0
local lastShotSeen = 0
local spinAngle, spinSpeed = 0, 0
local sprintBlend, reloadBlend = 0, 0
local laserDot: Part? = nil

-- scope overlay (black ring around a clear circle + crosshair)
local scopeGui = Instance.new("ScreenGui")
scopeGui.Name = "Scope"
scopeGui.IgnoreGuiInset = true
scopeGui.ResetOnSpawn = false
scopeGui.DisplayOrder = 4
scopeGui.Enabled = false
scopeGui.Parent = player:WaitForChild("PlayerGui")
local ring = Instance.new("Frame")
ring.AnchorPoint = Vector2.new(0.5, 0.5)
ring.Position = UDim2.fromScale(0.5, 0.5)
ring.Size = UDim2.fromScale(0.62, 0.62)
ring.SizeConstraint = Enum.SizeConstraint.RelativeYY
ring.BackgroundTransparency = 1
ring.Parent = scopeGui
Instance.new("UICorner", ring).CornerRadius = UDim.new(0.5, 0)
local ringStroke = Instance.new("UIStroke")
ringStroke.Thickness = 2000 -- everything outside the circle is black
ringStroke.Color = Color3.new(0, 0, 0)
ringStroke.Parent = ring
for _, d in { { 1, 0.004 }, { 0.004, 1 } } do
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.fromScale(0.5, 0.5)
	line.Size = UDim2.fromScale(d[1], d[2])
	line.BackgroundColor3 = Color3.new(0, 0, 0)
	line.BorderSizePixel = 0
	line.Parent = ring
end
local reticleDot = Instance.new("Frame")
reticleDot.AnchorPoint = Vector2.new(0.5, 0.5)
reticleDot.Position = UDim2.fromScale(0.5, 0.5)
reticleDot.Size = UDim2.fromOffset(5, 5)
reticleDot.BackgroundColor3 = Color3.fromRGB(255, 40, 30)
reticleDot.BorderSizePixel = 0
reticleDot.Parent = ring
Instance.new("UICorner", reticleDot).CornerRadius = UDim.new(1, 0)

local function equippedTool(): Tool?
	local c = player.Character
	if not c then
		return nil
	end
	for _, t in c:GetChildren() do
		if t:IsA("Tool") and t:GetAttribute("IsWeapon") then
			return t
		end
	end
	return nil
end

local function destroyVM()
	if vm then
		vm.model:Destroy()
		vm = nil
	end
	vmKey = ""
	if laserDot then
		laserDot:Destroy()
		laserDot = nil
	end
	scopeGui.Enabled = false
end

-- a suited forearm from the hand back toward the screen edge
local function arm(model: Model, root: BasePart, hand: Vector3, toShoulder: Vector3)
	local shoulder = hand + toShoulder
	local len = toShoulder.Magnitude
	local function piece(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = root.CFrame * cf
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	local dirCF = CFrame.lookAt(hand, shoulder)
	piece("Sleeve", Vector3.new(0.46, 0.46, len), CFrame.lookAt((hand + shoulder) / 2, shoulder), SUIT, Enum.Material.Fabric)
	piece("Cuff", Vector3.new(0.5, 0.5, 0.14), dirCF * CFrame.new(0, 0, -0.32), CUFF, Enum.Material.SmoothPlastic)
	piece("Glove", Vector3.new(0.36, 0.38, 0.46), dirCF * CFrame.new(0, 0, -0.05), GLOVE, Enum.Material.Fabric)
end

local function build(tool: Tool)
	destroyVM()
	local weaponId = (tool:GetAttribute("WeaponId") :: string?) or "Blaster"
	local att = WeaponModel.decode(player:GetAttribute("Attachments") :: string?)
	local model = Instance.new("Model")
	model.Name = "Viewmodel"
	local built = WeaponModel.build(weaponId, att, model, "Root")
	built.root.Anchored = true
	if weaponId == "Minigun" then
		arm(model, built.root, built.grip.Position, Vector3.new(0.4, -0.9, 2.2))
		arm(model, built.root, built.foregrip.Position, Vector3.new(-0.8, -1, 1.6))
	else
		arm(model, built.root, built.grip.Position, Vector3.new(0.35, -0.95, 2.1))
		arm(model, built.root, built.foregrip.Position, Vector3.new(-0.95, -0.85, 1.7))
	end
	model.Parent = camera
	local opticDef = Config.attachment("Optic", att.Optic)
	vm = {
		model = model,
		built = built,
		weaponId = weaponId,
		att = att,
		zoom = if opticDef then opticDef.zoom else 1.15,
		scoped = att.Optic == "ACOG" or att.Optic == "Sniper",
		hip = if weaponId == "Minigun" then CFrame.new(1.05, -1.3, -1.5) else CFrame.new(0.95, -0.9, -2.05),
	}
	if built.laser then
		local dot = Instance.new("Part")
		dot.Name = "LaserDot"
		dot.Shape = Enum.PartType.Ball
		dot.Size = Vector3.one * 0.18
		dot.Anchored = true
		dot.CanCollide = false
		dot.CanQuery = false
		dot.CanTouch = false
		dot.Material = Enum.Material.Neon
		dot.Color = (built.laser:GetAttribute("Color") :: Color3?) or Color3.new(1, 0, 0)
		dot.Parent = camera
		local a0 = Instance.new("Attachment")
		a0.Parent = built.laser
		local a1 = Instance.new("Attachment")
		a1.Parent = dot
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 0.03
		beam.Width1 = 0.03
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(dot.Color)
		beam.Transparency = NumberSequence.new(0.35, 0.8)
		beam.Parent = built.laser
		laserDot = dot
	end
	vmKey = weaponId .. "|" .. WeaponModel.encode(att)
end

-- Input ---------------------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
		aiming = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		aiming = false
	end
end)
ContextActionService:BindAction("JupiterAim", function(_, state)
	if state == Enum.UserInputState.Begin then
		aiming = not aiming -- touch / gamepad: toggle
	end
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.ButtonL2)
ContextActionService:SetTitle("JupiterAim", "AIM")
ContextActionService:BindAction("JupiterLean", function(name, state, input)
	local dir = if input.KeyCode == Enum.KeyCode.Q then -1 else 1
	if state == Enum.UserInputState.Begin then
		leanTarget = dir
	elseif state == Enum.UserInputState.End and leanTarget == dir then
		leanTarget = 0
	end
	local _ = name
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.Q, Enum.KeyCode.E)

-- Frame ---------------------------------------------------------------------------------------------
RunService:BindToRenderStep("JupiterViewmodel", Enum.RenderPriority.Camera.Value + 3, function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local tool = equippedTool()
	local inGame = camera.CameraType == Enum.CameraType.Custom
	if not humanoid or not root or not inGame or humanoid.Health <= 0 or player:GetAttribute("Downed") then
		destroyVM()
		player:SetAttribute("ADS", false)
		return
	end

	-- first person from the moment you're in the game (not in the menu)
	if player.CameraMode ~= Enum.CameraMode.LockFirstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end

	-- hide your own body, suit and the third-person gun in first person
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		end
	end

	-- lean (Q / E)
	lean += (leanTarget - lean) * math.min(dt * 10, 1)
	if math.abs(lean) > 0.001 then
		camera.CFrame *= CFrame.new(lean * 1.15, -math.abs(lean) * 0.12, 0) * CFrame.Angles(0, 0, -lean * math.rad(13))
	end

	if not tool then
		destroyVM()
		player:SetAttribute("ADS", false)
		camera.FieldOfView += (70 - camera.FieldOfView) * math.min(dt * 8, 1)
		return
	end
	local key = ((tool:GetAttribute("WeaponId") :: string?) or "Blaster") .. "|" .. WeaponModel.encode(WeaponModel.decode(player:GetAttribute("Attachments") :: string?))
	if not vm or key ~= vmKey then
		build(tool)
	end
	local built = vm.built

	local sprinting = player:GetAttribute("Sprinting") == true
	local reloading = player:GetAttribute("Reloading") == true
	local ads = aiming and not sprinting and not reloading and not player:GetAttribute("UIOpen")
	aimBlend += ((if ads then 1 else 0) - aimBlend) * math.min(dt * 12, 1)
	sprintBlend += ((if sprinting then 1 else 0) - sprintBlend) * math.min(dt * 8, 1)
	reloadBlend += ((if reloading then 1 else 0) - reloadBlend) * math.min(dt * 8, 1)
	player:SetAttribute("ADS", aimBlend > 0.5)

	-- recoil: Combat.client stamps LastShot on every shot
	local shot = (player:GetAttribute("LastShot") :: number?) or 0
	if shot ~= lastShotSeen then
		lastShotSeen = shot
		local k = if vm.weaponId == "Minigun" then 0.35 else 1
		if vm.att.Muzzle == "Compensator" then
			k *= 0.5
		end
		kick = math.min(kick + k * (1 - aimBlend * 0.5), 1.5)
		spinSpeed = 30
	end
	kick *= math.exp(-dt * 14)

	-- sway from mouse movement + walking bob
	local md = UserInputService:GetMouseDelta()
	local swayTarget = Vector2.new(math.clamp(-md.X * 0.0025, -0.08, 0.08), math.clamp(-md.Y * 0.0025, -0.08, 0.08)) * (1 - aimBlend * 0.85)
	sway = sway:Lerp(swayTarget, math.min(dt * 10, 1))
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local moving = math.clamp(speed / 16, 0, 1.5) * (if humanoid.FloorMaterial == Enum.Material.Air then 0.2 else 1)
	bobT += dt * (6 + speed * 0.35)
	local bobAmt = moving * (1 - aimBlend * 0.85)
	local bob = CFrame.new(math.sin(bobT) * 0.045 * bobAmt, -math.abs(math.cos(bobT)) * 0.05 * bobAmt, 0) * CFrame.Angles(0, 0, math.sin(bobT) * 0.02 * bobAmt)

	-- poses
	local adsCF = CFrame.new(0, 0, -0.12) * CFrame.new(-built.sight.Position)
	local pose = vm.hip:Lerp(adsCF, aimBlend)
	local sprintPose = CFrame.new(0.15 * sprintBlend, -0.25 * sprintBlend, 0.1 * sprintBlend) * CFrame.Angles(-0.25 * sprintBlend, 0.7 * sprintBlend, 0.3 * sprintBlend)
	local reloadPose = CFrame.new(0, -0.3 * reloadBlend, 0) * CFrame.Angles(-0.5 * reloadBlend, 0.25 * reloadBlend, 0.55 * reloadBlend)
	local recoil = CFrame.new(0, 0.02 * kick, 0.22 * kick) * CFrame.Angles(0.07 * kick, 0, 0)
	local swayCF = CFrame.Angles(sway.Y, sway.X, sway.X * 0.6)
	built.root.CFrame = camera.CFrame * pose * bob * swayCF * sprintPose * reloadPose * recoil

	-- minigun barrels
	if built.spin then
		spinSpeed = math.max(0, spinSpeed - dt * 25)
		spinAngle += spinSpeed * dt
		built.spin.Transform = CFrame.Angles(spinAngle, 0, 0)
	end

	-- laser dot
	if laserDot and built.laser then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character, camera }
		local origin = built.laser.Position
		local dir = built.root.CFrame.LookVector * 250
		local hit = workspace:Raycast(origin, dir, params)
		laserDot.CFrame = CFrame.new(if hit then hit.Position else origin + dir)
	end

	-- scopes: full overlay instead of the model when aimed in
	local scopedIn = vm.scoped and aimBlend > 0.9
	scopeGui.Enabled = scopedIn
	for _, p in vm.model:GetDescendants() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if scopedIn then 1 else 0
		end
	end

	-- field of view: sprint widens, aiming zooms by the optic's magnification
	local fov = 70 + (if sprinting and speed > 2 then 8 else 0)
	fov = fov + ((70 / vm.zoom) - fov) * aimBlend
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(dt * 14, 1)
end)

player.CharacterAdded:Connect(function()
	destroyVM()
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
</roblox>
